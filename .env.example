# Google Analytics 4 — Measurement ID (np. G-XXXXXXXXXX).
# Znajdziesz go w GA4: Administracja > Strumienie danych > [Twój strumień].
# Brak tej zmiennej = GA4 się nie wczytuje, bez błędu w konsoli (patrz
# src/components/Analytics.astro). Skopiuj ten plik do .env i wstaw realny ID.
PUBLIC_GA_ID=G-XXXXXXXXXX

# Microsoft Clarity — Project ID (np. yqimvx9e3n).
# Znajdziesz go w clarity.microsoft.com: Settings > Setup > Install manually,
# w linijce t.src="https://www.clarity.ms/tag/"+i — to jest ten ID.
# Brak tej zmiennej = Clarity się nie wczytuje, bez błędu w konsoli.
PUBLIC_CLARITY_ID=xxxxxxxxxx
