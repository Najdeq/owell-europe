---
import { domyslnyJezyk, type Jezyk } from "../../i18n/ui.ts";
import { useTranslations } from "../../i18n/utils.ts";
import type { JednostkaTyp } from "../../data/kalkulatorPojemnosci.ts";

interface Props {
  pojemnoscMl: number;
  jednostkaMl: number;
  jednostkaTyp: JednostkaTyp;
}

const { pojemnoscMl, jednostkaMl, jednostkaTyp } = Astro.props;

const jezyk = (Astro.currentLocale ?? domyslnyJezyk) as Jezyk;
const t = useTranslations(jezyk);

const liczba = Math.max(1, Math.round(pojemnoscMl / jednostkaMl));
// Rząd ikon jako dekoracja jest czytelny do kilkunastu sztuk — przy dużych
// pojemnościach (np. 67 puszek w lodówce turystycznej) sam wiersz przestaje
// coś komunikować, więc ograniczamy go i dopisujemy resztę jako "+N".
const WIERSZ_MAX = 12;
const wRzedzie = Math.min(liczba, WIERSZ_MAX);
const nadmiar = liczba - wRzedzie;

const nazwaJednostki: Record<JednostkaTyp, string> = {
  szklanka: t("produkt.kalkulatorSzklanka"),
  filizanka: t("produkt.kalkulatorFilizanka"),
  puszka: t("produkt.kalkulatorPuszka"),
  porcja: t("produkt.kalkulatorPorcja"),
};
---

<div class="kalkulator" data-reveal>
  <p class="kalkulator-tytul">{t("produkt.kalkulatorTytul")}</p>

  <div class="kalkulator-glowna">
    <span class="ikona ikona--duza" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        {jednostkaTyp === "szklanka" && (
          <>
            <path d="M7.5 4.5h9L15.3 18a2 2 0 0 1-2 1.8h-2.6a2 2 0 0 1-2-1.8L7.5 4.5Z" pathLength="1" />
            <path d="M8.3 9.5h7.4" pathLength="1" />
          </>
        )}
        {jednostkaTyp === "filizanka" && (
          <>
            <path d="M5.5 8h11v5.5a5.5 5.5 0 0 1-11 0V8Z" pathLength="1" />
            <path d="M16.5 9.5a3 3 0 0 1 0 6" pathLength="1" />
          </>
        )}
        {jednostkaTyp === "puszka" && (
          <>
            <rect x="7.5" y="3.5" width="9" height="17" rx="2" pathLength="1" />
            <path d="M7.5 7.5h9" pathLength="1" />
          </>
        )}
        {jednostkaTyp === "porcja" && (
          <>
            <path d="M4 11c0-1 0-1.5 1.2-1.5h13.6c1.2 0 1.2.5 1.2 1.5a8 6.5 0 0 1-16 0Z" pathLength="1" />
            <path d="M9 9.5V7M12 9.5V6.3M15 9.5V7" pathLength="1" class="para" />
          </>
        )}
      </svg>
    </span>

    <p class="kalkulator-liczba">
      ≈ {liczba} <span class="kalkulator-jednostka">× {nazwaJednostki[jednostkaTyp]} ({jednostkaMl} ml)</span>
    </p>
  </div>

  <div class="kalkulator-rzad" aria-hidden="true">
    {Array.from({ length: wRzedzie }).map(() => (
      <span class="ikona ikona--mala">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          {jednostkaTyp === "szklanka" && <path d="M7.5 4.5h9L15.3 18a2 2 0 0 1-2 1.8h-2.6a2 2 0 0 1-2-1.8L7.5 4.5Z" />}
          {jednostkaTyp === "filizanka" && <path d="M5.5 8h11v5.5a5.5 5.5 0 0 1-11 0V8Z" />}
          {jednostkaTyp === "puszka" && <rect x="7.5" y="3.5" width="9" height="17" rx="2" />}
          {jednostkaTyp === "porcja" && <path d="M4 11c0-1 0-1.5 1.2-1.5h13.6c1.2 0 1.2.5 1.2 1.5a8 6.5 0 0 1-16 0Z" />}
        </svg>
      </span>
    ))}
    {nadmiar > 0 && <span class="kalkulator-nadmiar">+{nadmiar}</span>}
  </div>

  <p class="kalkulator-nota">{t("produkt.kalkulatorNota")}</p>
</div>

<style>
  .kalkulator {
    padding: var(--sp-6);
    background-color: var(--bg-2);
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius-lg);
  }

  .kalkulator-tytul {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .kalkulator-glowna {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    margin-top: var(--sp-4);
  }

  .ikona {
    display: inline-flex;
    flex: none;
    color: var(--gold);
  }

  .ikona svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ikona--duza {
    width: 40px;
    height: 40px;
  }

  .kalkulator-liczba {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--text);
  }

  .kalkulator-jednostka {
    display: block;
    margin-top: var(--sp-1);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: 400;
    color: var(--text-2);
  }

  .kalkulator-rzad {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-5);
  }

  .ikona--mala {
    width: 18px;
    height: 18px;
    color: var(--gold-bright);
    opacity: 0.85;
  }

  .kalkulator-nadmiar {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    color: var(--text-2);
  }

  .kalkulator-nota {
    margin-top: var(--sp-4);
    font-size: var(--fs-micro);
    font-style: italic;
    color: var(--text-2);
  }

  /* Ten sam wzorzec "rysowania" konturu co IkonaWyroznika.astro — spójność
     wizualna w całej sekcji danych produktu. */
  .ikona--duza svg :is(path, rect) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  :global(.is-revealed) .ikona--duza svg :is(path, rect) {
    animation: kalkulator-rysuj 800ms var(--ease) forwards;
  }

  :global(.is-revealed) .ikona--duza svg .para {
    animation:
      kalkulator-rysuj 800ms var(--ease) forwards,
      kalkulator-unos 3s var(--ease) 800ms infinite;
  }

  @keyframes kalkulator-rysuj {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes kalkulator-unos {
    0%,
    100% {
      transform: translateY(0);
      opacity: 1;
    }
    50% {
      transform: translateY(-1.5px);
      opacity: 0.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ikona--duza svg :is(path, rect) {
      stroke-dashoffset: 0;
      animation: none !important;
    }
  }
</style>