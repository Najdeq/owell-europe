---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<p class:list={["eyebrow", className]}>
  <slot />
</p>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }
</style>
