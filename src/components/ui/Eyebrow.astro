---
interface Props {
  class?: string;
  // Tag HTML — domyślnie <p>. Na stronie głównej nadtytuł jest jedynym
  // krótkim nagłówkiem z frazą „małe AGD", więc tam renderujemy go jako <h1>
  // (wygląd się nie zmienia — Tailwind preflight zeruje style nagłówków).
  as?: "p" | "h1" | "h2" | "span";
  [key: `data-${string}`]: string | boolean | undefined;
}

const { class: className, as: Tag = "p", ...rest } = Astro.props;
---

<Tag class:list={["eyebrow", className]} {...rest}>
  <slot />
</Tag>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }
</style>
