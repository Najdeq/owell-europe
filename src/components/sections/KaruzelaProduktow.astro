---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Section from "../ui/Section.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { site } from "../../data/site.ts";
import { zdjecia } from "../../data/zdjecia.ts";

const kategorieNazwy = Object.fromEntries(site.kategorie.map((k) => [k.slug, k.nazwa]));

const produkty = (await getCollection("produkty"))
  .filter((p) => p.data.opublikowany)
  .sort((a, b) => a.data.kolejnosc - b.data.kolejnosc);
---

{produkty.length > 0 && (
  <Section bg="base" class="karuzela-sekcja">
    <Eyebrow data-reveal class="karuzela-eyebrow">Cały katalog</Eyebrow>
    <h2 class="karuzela-tytul" data-reveal data-reveal-delay="80">Owell w jednym spojrzeniu</h2>

    <div class="marquee" data-marquee>
      <div class="marquee-track" data-track>
        {[...produkty, ...produkty].map((p, i) => (
          <a
            href={`/produkty/${p.id}`}
            class="karta"
            aria-hidden={i >= produkty.length ? "true" : undefined}
            tabindex={i >= produkty.length ? "-1" : undefined}
            draggable="false"
          >
            <div class="karta-foto">
              {zdjecia[p.id] && (
                <Image
                  src={zdjecia[p.id]}
                  alt={p.data.nazwa}
                  width={240}
                  height={240}
                  loading="lazy"
                  draggable={false}
                />
              )}
            </div>
            <p class="karta-kategoria">{kategorieNazwy[p.data.kategoria]}</p>
            <p class="karta-nazwa">{p.data.nazwa}</p>
          </a>
        ))}
      </div>
    </div>
  </Section>
)}

<style>
  /* Podwójna klasa (.section + .karuzela-sekcja) celowo — samo .karuzela-sekcja
     ma taką samą specyficzność jak .section z Section.astro, więc bez tego
     wygrywałby ten, który akurat załadował się później w bundlu. */
  :global(.section.karuzela-sekcja) {
    overflow: hidden;
    /* Ta sekcja to przerywnik między dwoma innymi, nie ma własnej treści do
       "odpoczynku" jak reszta — pełny --section-y z obu stron dawał pustą
       czarną dziurę nad paskiem (suma dolnego marginesu Kategorii i górnego
       tej sekcji). */
    padding-top: var(--sp-10);
    padding-bottom: var(--sp-16);
  }

  :global(.karuzela-eyebrow) {
    padding-inline: var(--gutter);
  }

  .karuzela-tytul {
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-10);
    padding-inline: var(--gutter);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .marquee {
    width: 100%;
    overflow: hidden;
    /* Pionowy zapas na skalowanie kart pod kursorem — bez tego hover-zoom
       obcinałby się na górnej/dolnej krawędzi kontenera. */
    padding-block: var(--sp-4);
    cursor: grab;
    touch-action: pan-y;
    /* Rozmycie krawędzi zamiast twardego obcięcia — pasek wygląda, jakby
       wjeżdżał i wyjeżdżał poza kadr, nie jakby był ucięty nożyczkami. */
    -webkit-mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
    mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
  }

  .marquee[data-dragging="true"] {
    cursor: grabbing;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    gap: var(--sp-5);
    will-change: transform;
  }

  .karta {
    flex: none;
    width: 11rem;
    text-decoration: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .karta-foto {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius);
    overflow: hidden;
    background-color: var(--photo-bg);
    border: 1px solid var(--hairline-soft);
    transition:
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .karta:hover .karta-foto {
    border-color: var(--gold);
    transform: scale(1.08);
  }

  .karta-foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    pointer-events: none;
  }

  .karta-kategoria {
    margin-top: var(--sp-3);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--gold);
  }

  .karta-nazwa {
    margin-top: var(--sp-1);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text);
  }

  @media (min-width: 640px) {
    .karta {
      width: 13rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .karta-foto {
      transition: border-color var(--dur) var(--ease);
    }

    .karta:hover .karta-foto {
      transform: none;
    }
  }
</style>

<script>
  // Pasek jedzie sam (rAF, nie CSS @keyframes) — dzięki temu ten sam offset
  // obsługuje i autoplay, i ręczne przeciąganie/swipe, bez dwóch osobnych
  // silników animacji, które musiałyby się ze sobą zgadzać.
  function setupKaruzela() {
    const marquee = document.querySelector<HTMLElement>("[data-marquee]");
    const track = document.querySelector<HTMLElement>("[data-track]");
    if (!marquee || !track) return;
    if (marquee.dataset.owellBound === "true") return;
    marquee.dataset.owellBound = "true";

    // Aliasy jako osobne const — zamykają typ jako "na pewno HTMLElement" dla
    // funkcji zdefiniowanych niżej (TS nie ufa zawężeniu `marquee`/`track"
    // wewnątrz domknięć zadeklarowanych po guard clause).
    const marqueeEl = marquee;
    const trackEl = track;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let polowaSzerokosci = 0;
    function mierz() {
      polowaSzerokosci = trackEl.scrollWidth / 2;
    }
    mierz();
    window.addEventListener("resize", mierz);

    let offset = 0;
    let hover = false;
    let dragging = false;
    let startX = 0;
    let startOffset = 0;
    let przesuniete = 0; // suma ruchu w bieżącym geście — odróżnia klik od przeciągnięcia
    const PREDKOSC = 34; // px/s

    function zawin() {
      if (polowaSzerokosci <= 0) return;
      offset = ((offset % polowaSzerokosci) + polowaSzerokosci) % polowaSzerokosci;
    }

    function rysuj() {
      trackEl.style.transform = `translateX(${-offset}px)`;
    }

    let ostatniCzas: number | null = null;
    function krok(czas: number) {
      if (ostatniCzas === null) ostatniCzas = czas;
      const dt = (czas - ostatniCzas) / 1000;
      ostatniCzas = czas;

      if (!hover && !dragging && !prefersReducedMotion) {
        offset += PREDKOSC * dt;
        zawin();
        rysuj();
      }

      requestAnimationFrame(krok);
    }
    requestAnimationFrame(krok);

    marqueeEl.addEventListener("mouseenter", () => (hover = true));
    marqueeEl.addEventListener("mouseleave", () => (hover = false));

    marqueeEl.addEventListener("pointerdown", (e) => {
      dragging = true;
      przesuniete = 0;
      startX = e.clientX;
      startOffset = offset;
      marqueeEl.dataset.dragging = "true";
      marqueeEl.setPointerCapture(e.pointerId);
    });

    marqueeEl.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const delta = e.clientX - startX;
      przesuniete = Math.max(przesuniete, Math.abs(delta));
      offset = startOffset - delta;
      zawin();
      rysuj();
    });

    function zakonczPrzeciaganie(e: PointerEvent) {
      if (!dragging) return;
      dragging = false;
      delete marqueeEl.dataset.dragging;
      try {
        marqueeEl.releasePointerCapture(e.pointerId);
      } catch {}
    }
    marqueeEl.addEventListener("pointerup", zakonczPrzeciaganie);
    marqueeEl.addEventListener("pointercancel", zakonczPrzeciaganie);

    // Klik tuż po przeciągnięciu nie powinien otwierać produktu — 6px to
    // margines na drżenie ręki/palca przy zwykłym kliku.
    marqueeEl.addEventListener(
      "click",
      (e) => {
        if (przesuniete > 6) e.preventDefault();
      },
      { capture: true }
    );
  }

  setupKaruzela();
  document.addEventListener("astro:page-load", setupKaruzela);
</script>