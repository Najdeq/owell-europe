---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { site } from "../../data/site.ts";
---

<Section bg="base">
  <Container>
    <Eyebrow data-reveal>Katalog</Eyebrow>
    <h2 class="section-title" data-reveal data-reveal-delay="80">Kategorie produktów</h2>

    <div class="grid">
      {site.kategorie.map((kategoria) => (
        <a href={`/produkty#${kategoria.slug}`} class="kafel">
          <h3 class="kafel-tytul">{kategoria.nazwa}</h3>
          <p class="kafel-opis">{kategoria.opis}</p>
          <span class="kafel-link">Zobacz produkty →</span>
        </a>
      ))}
    </div>
  </Container>
</Section>

<style>
  .section-title {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
    margin-top: var(--sp-12);
  }

  .kafel {
    display: flex;
    flex-direction: column;
    padding: var(--sp-8);
    background-color: var(--bg-2);
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .kafel:hover {
    background-color: var(--bg-3);
    border-color: var(--gold);
  }

  .kafel-tytul {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--text);
  }

  .kafel-opis {
    margin-top: var(--sp-3);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .kafel-link {
    margin-top: var(--sp-6);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    letter-spacing: var(--tracking-mono);
    color: var(--gold);
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
