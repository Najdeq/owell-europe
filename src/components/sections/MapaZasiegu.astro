---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { site } from "../../data/site.ts";
import mapa from "../../data/mapa-swiata.json";

// Bez listy rynków nie renderujemy nic — pusta mapa świata wyglądałaby jak
// błąd, a wypełnianie jej „na oko" byłoby zmyślaniem danych o firmie.
const rynki = site.grupa.rynki;
const zaznaczone = new Set(rynki.map((r) => r.mapa));

// Ostrzegamy przy buildzie, gdy nazwa nie pasuje do żadnego konturu —
// literówka inaczej po cichu zgasiłaby kraj na mapie.
const nieznane = rynki.filter((r) => !(r.mapa in mapa.kraje)).map((r) => r.mapa);
if (nieznane.length > 0) {
  console.warn(
    `[MapaZasiegu] nazwy spoza mapy (kraj się nie podświetli): ${nieznane.join(", ")}`
  );
}

// Kadr na Europę, Turcję i Afrykę Północną — wszystkie zaznaczone rynki mieszczą
// się w tym obszarze, a pełna mapa świata zostawiałaby ogromne puste pole.
// Wartości w układzie odwzorowania z scripts/mapa.mjs (equirectangular 1000×500).
const kadr = "425 35 258 182";

const konturyMap = mapa.kraje as Record<string, string>;

/**
 * Środek największej części kraju.
 *
 * Liczenie średniej ze WSZYSTKICH punktów ścieżki dawałoby błędne wyniki tam,
 * gdzie kontur zawiera odległe wyspy albo terytoria zamorskie — środek Francji
 * (z Gujaną) czy Norwegii (ze Svalbardem) wylądowałby na oceanie. Dlatego
 * bierzemy tylko podścieżkę o największej liczbie punktów, czyli w praktyce
 * kontynentalny trzon kraju.
 */
const srodek = (d: string): [number, number] => {
  let najlepszy: [number, number] = [0, 0];
  let najwiecej = 0;

  for (const kawalek of d.split("M").filter(Boolean)) {
    const liczby = kawalek.match(/-?\d+(?:\.\d+)?/g);
    if (!liczby || liczby.length < 4) continue;

    let sx = 0;
    let sy = 0;
    let ile = 0;
    for (let i = 0; i + 1 < liczby.length; i += 2) {
      sx += Number(liczby[i]);
      sy += Number(liczby[i + 1]);
      ile++;
    }
    if (ile > najwiecej) {
      najwiecej = ile;
      najlepszy = [sx / ile, sy / ile];
    }
  }
  return najlepszy;
};

const START = srodek(konturyMap["Poland"]);

/**
 * Łuk z Polski do kraju docelowego jako krzywa kwadratowa. Punkt kontrolny
 * odsuwamy prostopadle do odcinka, żeby trasy się wachlarzowały zamiast
 * nakładać na siebie w wiązkę prostych. Znak odchylenia zależy od kierunku —
 * dzięki temu łuki na zachód i na wschód wyginają się zgodnie, a nie lustrzanie.
 */
const luk = (do_: [number, number]) => {
  const [x1, y1] = START;
  const [x2, y2] = do_;
  const dx = x2 - x1;
  const dy = y2 - y1;
  const dl = Math.hypot(dx, dy) || 1;
  const wygiecie = Math.min(dl * 0.22, 26);
  const kx = (x1 + x2) / 2 + (-dy / dl) * wygiecie * (dx >= 0 ? 1 : -1);
  const ky = (y1 + y2) / 2 + (dx / dl) * wygiecie * (dx >= 0 ? 1 : -1);
  return `M${x1.toFixed(1)} ${y1.toFixed(1)}Q${kx.toFixed(1)} ${ky.toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}`;
};

// Trasy sortujemy po długości, żeby impulsy startowały od najbliższych krajów
// i „rozchodziły się" na zewnątrz, zamiast zapalać się w losowej kolejności.
const trasy = rynki
  .filter((r: { mapa: string }) => r.mapa in konturyMap && r.mapa !== "Poland")
  .map((r: { mapa: string; nazwa: string }) => {
    const cel = srodek(konturyMap[r.mapa]);
    return {
      nazwa: r.nazwa,
      d: luk(cel),
      dystans: Math.hypot(cel[0] - START[0], cel[1] - START[1]),
    };
  })
  .sort((a: { dystans: number }, b: { dystans: number }) => a.dystans - b.dystans);
---

{rynki.length > 0 && (
  <Section bg="raised">
    <Container>
      <Eyebrow data-reveal>Zasięg</Eyebrow>
      <h2 class="section-title" data-reveal data-reveal-delay="80">
        Nasze produkty jeżdżą po całej Europie
      </h2>
      <p class="section-lead" data-reveal data-reveal-delay="160">
        Owell to {site.grupa.lataHistorii} lat produkcji, ponad {site.grupa.liczbaProduktow} modeli, ponad{" "}
        {site.grupa.liczbaKrajow} rynków. Ta sama fabryka, ta sama kontrola jakości, ci sami ludzie od serwisu.
      </p>

      <figure class="mapa-blok" data-reveal data-reveal-delay="240">
        <svg
          class="mapa"
          viewBox={kadr}
          role="img"
          aria-label="Mapa Europy z zaznaczonymi krajami, w których sprzedaje Owell"
        >
          <defs>
            <marker
              id="grot"
              viewBox="0 0 8 8"
              refX="6"
              refY="4"
              markerWidth="5"
              markerHeight="5"
              orient="auto-start-reverse"
              markerUnits="strokeWidth"
            >
              <path d="M0 0 L8 4 L0 8 Z" class="grot" />
            </marker>
          </defs>

          {Object.entries(mapa.kraje).map(([nazwa, d]) => (
            <path
              d={d}
              class:list={["kraj", { "kraj--aktywny": zaznaczone.has(nazwa) }]}
            />
          ))}

          {/* Trasy rysujemy podwójnie: statyczna nitka pokazuje cały układ
              połączeń nawet zanim ruszy animacja, a druga ścieżka to biegnący
              po niej impuls. Animujemy stroke-dashoffset na cienkich liniach,
              a nie fill na dużych kształtach — to drugie wymuszało
              przemalowywanie całych konturów i przez to mapa się zacinała. */}
          <g class="trasy">
            {trasy.map((t: { d: string }) => (
              <path d={t.d} class="trasa" />
            ))}
            {trasy.map((t: { d: string; nazwa: string }, i: number) => (
              <path
                d={t.d}
                class="impuls"
                pathLength="100"
                marker-end="url(#grot)"
                style={`animation-delay: ${(i * 260) % 5200}ms`}
              >
                <title>{t.nazwa}</title>
              </path>
            ))}
          </g>

          <circle class="zrodlo" cx={START[0]} cy={START[1]} r="1.6" />
        </svg>

        <figcaption class="podpis">
          <span class="podpis-liczba">{site.grupa.liczbaKrajow}+</span>
          <span class="podpis-tekst">rynków Owell</span>
        </figcaption>
      </figure>

      {/* Lista tekstowa nie jest ozdobnikiem: mapa SVG jest nieczytelna dla
          czytników ekranu i dla wyszukiwarek, a na telefonie kontury krajów
          są za małe, żeby cokolwiek z nich odczytać. */}
      <ul class="lista" data-reveal data-reveal-delay="320">
        {rynki.map((r) => (
          <li>{r.nazwa}</li>
        ))}
      </ul>
    </Container>
  </Section>
)}

<style>
  .section-title {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .section-lead {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .mapa-blok {
    margin-top: var(--sp-12);
  }

  .mapa {
    display: block;
    width: 100%;
    height: auto;
    /* Bez tego kontury spoza kadru (reszta świata) rysują się poza ramką SVG
       i zalewają sekcję — viewBox przycina tylko przy overflow: hidden. */
    overflow: hidden;
  }

  .kraj {
    fill: var(--bg-3);
    stroke: var(--bg-1);
    stroke-width: 0.6;
    transition: fill var(--dur) var(--ease);
  }

  /* Kraje są statyczne i celowo przygaszone — ruch należy do tras, a złoto
     w pełnej sile na 43 dużych kształtach zabierałoby im uwagę. */
  .kraj--aktywny {
    fill: color-mix(in srgb, var(--gold) 42%, var(--bg-2));
  }

  .zrodlo {
    fill: var(--gold-bright);
  }

  .trasa {
    fill: none;
    stroke: color-mix(in srgb, var(--gold) 28%, transparent);
    stroke-width: 0.4;
  }

  /* Impuls: krótka kreska biegnąca wzdłuż trasy. pathLength normalizuje
     długość każdego łuku do 100, dzięki czemu jedna reguła daje ten sam
     efekt niezależnie od tego, czy trasa biegnie do Czech, czy do Islandii. */
  .impuls {
    fill: none;
    stroke: var(--gold-bright);
    stroke-width: 0.7;
    stroke-linecap: round;
    stroke-dasharray: 14 100;
    stroke-dashoffset: 114;
    opacity: 0;
  }

  .grot {
    fill: var(--gold-bright);
  }

  /* Animacja startuje dopiero, gdy mapa wjedzie w kadr — inaczej biegłaby
     w tle u kogoś, kto jest wysoko nad sekcją, i zjadała baterię. */
  .mapa-blok.is-revealed .impuls {
    animation: leci 5.2s linear infinite;
  }

  @keyframes leci {
    0% {
      stroke-dashoffset: 114;
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    72% {
      opacity: 1;
    }
    80%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }

  /* Podświetlenie tylko na urządzeniach z kursorem — na dotyku hover
     potrafi „przykleić się" do ostatnio dotkniętego kraju. */
  @media (hover: hover) {
    .kraj--aktywny:hover {
      fill: var(--gold-bright);
    }
  }

  .podpis {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--hairline-soft);
  }

  .podpis-liczba {
    font-family: var(--font-mono);
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--gold-bright);
  }

  .podpis-tekst {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .lista {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    margin-top: var(--sp-8);
    list-style: none;
  }

  .lista li {
    font-size: var(--fs-small);
    color: var(--text-2);
  }

  .lista li::after {
    content: "·";
    margin-left: var(--sp-4);
    color: var(--steel-dim);
  }

  .lista li:last-child::after {
    content: "";
  }

  /* Bez ruchu: trasy zostają widoczne jako statyczna siatka połączeń,
     ale nic nimi nie biegnie. */
  @media (prefers-reduced-motion: reduce) {
    .mapa-blok.is-revealed .impuls {
      animation: none !important;
    }

    .impuls {
      opacity: 0;
    }

    .trasa {
      stroke: color-mix(in srgb, var(--gold) 45%, transparent);
    }
  }
</style>
