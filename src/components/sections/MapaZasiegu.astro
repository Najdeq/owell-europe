---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { site } from "../../data/site.ts";
import mapa from "../../data/mapa-swiata.json";

// Bez listy rynków nie renderujemy nic — pusta mapa świata wyglądałaby jak
// błąd, a wypełnianie jej „na oko" byłoby zmyślaniem danych o firmie.
const rynki = site.grupa.rynki;
const zaznaczone = new Set(rynki.map((r) => r.mapa));

// Ostrzegamy przy buildzie, gdy nazwa nie pasuje do żadnego konturu —
// literówka inaczej po cichu zgasiłaby kraj na mapie.
const nieznane = rynki.filter((r) => !(r.mapa in mapa.kraje)).map((r) => r.mapa);
if (nieznane.length > 0) {
  console.warn(
    `[MapaZasiegu] nazwy spoza mapy (kraj się nie podświetli): ${nieznane.join(", ")}`
  );
}

// Kadr na Europę, Turcję i Afrykę Północną — wszystkie zaznaczone rynki mieszczą
// się w tym obszarze, a pełna mapa świata zostawiałaby ogromne puste pole.
// Wartości w układzie odwzorowania z scripts/mapa.mjs (equirectangular 1000×500).
const kadr = "425 35 258 182";

// Kolejność zapalania krajów: z zachodu na wschód. Bez sortowania kraje
// zapalałyby się w losowej kolejności z pliku danych, co wygląda jak awaria,
// a nie jak zamierzony efekt. Środek ciężkości liczymy zgrubnie ze współrzędnych
// ścieżki — do ustalenia kolejności to w zupełności wystarcza.
const srodekX = (d: string) => {
  const liczby = d.match(/-?\d+(?:\.\d+)?/g);
  if (!liczby) return 0;
  let suma = 0;
  let ile = 0;
  for (let i = 0; i < liczby.length; i += 2) {
    suma += Number(liczby[i]);
    ile++;
  }
  return ile ? suma / ile : 0;
};

const konturyMap = mapa.kraje as Record<string, string>;

const posortowane: string[] = rynki
  .filter((r: { mapa: string }) => r.mapa in konturyMap)
  .map((r: { mapa: string }) => r.mapa)
  .sort((a: string, b: string) => srodekX(konturyMap[a]) - srodekX(konturyMap[b]));

const kolejnosc = new Map<string, number>(posortowane.map((nazwa, i) => [nazwa, i]));
---

{rynki.length > 0 && (
  <Section bg="raised">
    <Container>
      <Eyebrow data-reveal>Zasięg</Eyebrow>
      <h2 class="section-title" data-reveal data-reveal-delay="80">
        Nasze produkty jeżdżą po całej Europie
      </h2>
      <p class="section-lead" data-reveal data-reveal-delay="160">
        Za Owellem stoi {site.grupa.nazwa}: {site.grupa.lataHistorii} lat produkcji, ponad{" "}
        {site.grupa.liczbaProduktow} modeli, ponad {site.grupa.liczbaKrajow} rynków. Ta sama fabryka, ta sama
        kontrola jakości, ci sami ludzie od serwisu.
      </p>

      <figure class="mapa-blok" data-reveal data-reveal-delay="240">
        <svg
          class="mapa"
          viewBox={kadr}
          role="img"
          aria-label={`Mapa Europy z zaznaczonymi krajami, w których sprzedaje ${site.grupa.nazwa}`}
        >
          {Object.entries(mapa.kraje).map(([nazwa, d]) => (
            <path
              d={d}
              class:list={["kraj", { "kraj--aktywny": zaznaczone.has(nazwa) }]}
              style={
                kolejnosc.has(nazwa) ? `--opoznienie: ${kolejnosc.get(nazwa)! * 45}ms` : undefined
              }
            />
          ))}
        </svg>

        <figcaption class="podpis">
          <span class="podpis-liczba">{site.grupa.liczbaKrajow}+</span>
          <span class="podpis-tekst">rynków {site.grupa.nazwa}</span>
        </figcaption>
      </figure>

      {/* Lista tekstowa nie jest ozdobnikiem: mapa SVG jest nieczytelna dla
          czytników ekranu i dla wyszukiwarek, a na telefonie kontury krajów
          są za małe, żeby cokolwiek z nich odczytać. */}
      <ul class="lista" data-reveal data-reveal-delay="320">
        {rynki.map((r) => (
          <li>{r.nazwa}</li>
        ))}
      </ul>
    </Container>
  </Section>
)}

<style>
  .section-title {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .section-lead {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .mapa-blok {
    margin-top: var(--sp-12);
  }

  .mapa {
    display: block;
    width: 100%;
    height: auto;
    /* Bez tego kontury spoza kadru (reszta świata) rysują się poza ramką SVG
       i zalewają sekcję — viewBox przycina tylko przy overflow: hidden. */
    overflow: hidden;
  }

  .kraj {
    fill: var(--bg-3);
    stroke: var(--bg-1);
    stroke-width: 0.6;
    transition: fill var(--dur) var(--ease);
  }

  /* Kraje zapalają się kolejno z zachodu na wschód (kolejność liczona
     w frontmatterze, opóźnienie wstrzykiwane jako --opoznienie). Start
     dopiero po wjechaniu mapy w kadr — .is-revealed dokłada ScrollReveal,
     inaczej cały efekt przepadłby u kogoś, kto wchodzi wysoko nad sekcją. */
  .kraj--aktywny {
    fill: var(--bg-3);
  }

  .mapa-blok.is-revealed .kraj--aktywny {
    animation: zapal 520ms var(--ease) forwards;
    animation-delay: var(--opoznienie, 0ms);
  }

  @keyframes zapal {
    from {
      fill: var(--bg-3);
    }
    to {
      fill: var(--gold);
    }
  }

  /* Podświetlenie tylko na urządzeniach z kursorem — na dotyku hover
     potrafi „przykleić się" do ostatnio dotkniętego kraju. */
  @media (hover: hover) {
    .kraj--aktywny:hover {
      fill: var(--gold-bright);
    }
  }

  .podpis {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--hairline-soft);
  }

  .podpis-liczba {
    font-family: var(--font-mono);
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--gold-bright);
  }

  .podpis-tekst {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .lista {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    margin-top: var(--sp-8);
    list-style: none;
  }

  .lista li {
    font-size: var(--fs-small);
    color: var(--text-2);
  }

  .lista li::after {
    content: "·";
    margin-left: var(--sp-4);
    color: var(--steel-dim);
  }

  .lista li:last-child::after {
    content: "";
  }

  /* Bez ruchu: kraje od razu złote, żadnego kaskadowego zapalania. */
  @media (prefers-reduced-motion: reduce) {
    .kraj--aktywny,
    .mapa-blok.is-revealed .kraj--aktywny {
      fill: var(--gold);
      animation: none !important;
    }
  }
</style>
