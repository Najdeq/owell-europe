---
import { getRelativeLocaleUrl } from "astro:i18n";
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import WyszukiwarkaModelu from "../WyszukiwarkaModelu.astro";
import { site } from "../../data/site.ts";
import { domyslnyJezyk, type Jezyk } from "../../i18n/ui.ts";
import { useTranslations } from "../../i18n/utils.ts";

const jezyk = (Astro.currentLocale ?? domyslnyJezyk) as Jezyk;
const t = useTranslations(jezyk);
const l = (sciezka: string) => getRelativeLocaleUrl(jezyk, sciezka);

const wideoAlt = `${site.nazwa} — ${t("common.tagline")}`;

const fakty = [
  { target: 40, prefix: "+", suffix: "", etykieta: t("hero.statProdukty") },
  { target: site.gwarancjaMiesiace, prefix: "", suffix: ` ${t("hero.statGwarancjaJednostka")}`, etykieta: t("hero.statGwarancja") },
  { target: 35, prefix: "+", suffix: ` ${t("hero.statDoswiadczenieJednostka")}`, etykieta: t("hero.statDoswiadczenie") },
  { target: 100, prefix: "", suffix: "%", etykieta: t("hero.statGpsr") },
];
---

<Section bg="base" class="hero">
  <div class="hero-inner">
    <div class="hero-content">
      <Eyebrow data-reveal>{t("hero.eyebrow")}</Eyebrow>
      <h1 class="hero-title" data-reveal data-reveal-delay="80">
        {t("hero.tytul")}
      </h1>
      <p class="hero-lead" data-reveal data-reveal-delay="160">
        {t("hero.lead").replace("{gwarancja}", String(site.gwarancjaMiesiace))}
      </p>

      <div class="hero-cta">
        <Button href={l("/gdzie-kupic")} variant="primary">{t("hero.cta1")}</Button>
        <Button href={l("/o-nas")} variant="ghost">{t("hero.cta2")}</Button>
      </div>

      <WyszukiwarkaModelu
        class="hero-szukaj"
        etykieta={t("hero.szukajLabel")}
        placeholder={t("hero.szukajPlaceholder")}
        pusto={t("hero.szukajPusto")}
      />

      <dl class="hero-fakty" data-hero-fakty>
        {fakty.map((f) => (
          <div class="fakt">
            <dt>{f.etykieta}</dt>
            <dd data-fakt-wartosc data-target={f.target} data-prefix={f.prefix} data-suffix={f.suffix}>
              {f.prefix}0{f.suffix}
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hero-media">
      <div class="hero-media-frame">
        {/* poster = pierwsza klatka video (90 kB). Bez niego przez cały czas
            pobierania 2,7 MB pliku w najważniejszym miejscu strony wisiała
            pusta ramka, co psuło LCP. */}
        <video
          class="hero-video"
          aria-label={wideoAlt}
          src="/video/owell-commercial.mp4"
          poster="/video/owell-commercial-poster.jpg"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
        />
      </div>
    </div>
  </div>
</Section>

<style>
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: var(--sp-12);
    width: 100%;
    max-width: 100rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* Powolny dryf ciepłej poświaty za treścią hero — jedyny ciągły ruch
     na stronie. Ma być na granicy zauważalności: gdy widać wyraźną plamę
     zamiast wrażenia oświetlenia, alfa jest za wysoka.
     z-index: -1 trzyma go pod tekstem (element pozycjonowany absolutnie
     rysowałby się nad treścią w normalnym przepływie). */
  .hero-inner::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: -20%;
    left: -10%;
    width: 70%;
    height: 140%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--gold) 12%, transparent),
      transparent
    );
    filter: blur(40px);
    pointer-events: none;
    animation: hero-dryf 22s ease-in-out infinite alternate;
  }

  @keyframes hero-dryf {
    from {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.75;
    }
    to {
      transform: translate3d(12%, 6%, 0) scale(1.15);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-inner::before {
      animation: none;
    }
  }

  .hero-content {
    max-width: var(--maxw-prose);
  }

  .hero-title {
    margin-top: var(--sp-4);
    font-family: var(--font-display);
    /* Nagłówek to teraz pełne zdanie misji, nie 3-4-wyrazowe hasło — przy
       --fs-display (dobranym pod krótki tekst) łamał się na kilkanaście
       wierszy i wybijał poza kadr. --fs-h2 trzyma go w rozsądnej wysokości
       przy każdej szerokości ekranu. */
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .hero-lead {
    margin-top: var(--sp-6);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-8);
  }

  :global(.hero-szukaj) {
    margin-top: var(--sp-8);
    max-width: 28rem;
  }

  .hero-fakty {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-6) var(--sp-8);
    margin-top: var(--sp-12);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--hairline-soft);
  }

  .fakt dd {
    font-variant-numeric: tabular-nums;
    font-family: var(--font-mono);
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--gold-bright);
  }

  .fakt dt {
    margin-top: var(--sp-1);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .hero-media {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .hero-media-frame {
    position: relative;
    width: 100%;
    /* Wideo źródłowe jest pionowe (9:16, format "reels") — ramka na mobile/
       tablet dostaje ten sam kształt zamiast szerokiego 4:3, który wymuszałby
       mocne kadrowanie boków. max-height chroni przed zdominowaniem ekranu
       na wąskich telefonach, gdzie 9:16 pełnej szerokości byłoby bardzo wysokie. */
    aspect-ratio: 9 / 16;
    max-height: 70vh;
    margin-inline: auto;
    background-color: var(--photo-bg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--hairline);
    overflow: hidden;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-media,
  .hero-media-frame {
    max-width: 100%;
  }

  @media (min-width: 480px) {
    .hero-fakty {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 960px) {
    .hero-inner {
      /* fit-content(--maxw-prose) zamiast 1fr — kolumna tekstu kurczy się
         do faktycznej szerokości treści (tej samej, do której i tak jest
         przycięta przez max-width na .hero-content), więc nie zostaje
         martwe miejsce między końcem tekstu a węższą, pionową ramką wideo
         (auto). Przy 1fr kolumna była dużo szersza niż sam tekst — pusta
         przestrzeń po prostu przenosiła się w prawo, przed wideo. */
      grid-template-columns: fit-content(42rem) auto;
      gap: var(--sp-10);
      /* Tekst (nagłówek + lead + CTA + szukajka + statystyki) ustala
         wysokość wiersza — stretch pozwala pionowej ramce wideo dorównać
         jej wysokością, zamiast wisieć wyśrodkowana nad pustym miejscem. */
      align-items: stretch;
    }

    .hero-media {
      justify-content: flex-end;
    }

    .hero-media-frame {
      /* Wysokość = wysokość lewej kolumny tekstu, szerokość wynika z
         aspect-ratio 9:16 (odziedziczone z reguły bazowej) — więc ramka
         zostaje wierna kształtowi źródłowego wideo zamiast rozciągać się
         na całą szerokość kolumny 0.6fr. width:auto nadpisuje width:100%
         z reguły bazowej, która by ten wybór aspect-ratio popsuła. */
      width: auto;
      height: 100%;
      max-height: none;
    }
  }
</style>

<script>
  // Liczby w Hero zawsze są widoczne od razu przy wejściu na stronę (nad
  // linią zagięcia), więc liczymy w górę od razu po zamontowaniu — bez
  // IntersectionObserver, w przeciwieństwie do sekcji Liczby niżej na stronie.
  function animateHeroFakty() {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    const grid = document.querySelector<HTMLElement>("[data-hero-fakty]");
    if (!grid) return;
    if (grid.dataset.owellBound === "true") return;
    grid.dataset.owellBound = "true";

    const items = grid.querySelectorAll<HTMLElement>("[data-fakt-wartosc]");

    items.forEach((el) => {
      const target = Number(el.dataset.target);
      const prefix = el.dataset.prefix ?? "";
      const suffix = el.dataset.suffix ?? "";

      if (prefersReducedMotion) {
        el.textContent = `${prefix}${target}${suffix}`;
        return;
      }

      const duration = 1200;
      const start = performance.now();

      const step = (now: number) => {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = `${prefix}${Math.round(target * eased)}${suffix}`;

        if (progress < 1) {
          requestAnimationFrame(step);
        } else {
          el.textContent = `${prefix}${target}${suffix}`;
        }
      };

      requestAnimationFrame(step);
    });
  }

  animateHeroFakty();
  document.addEventListener("astro:page-load", animateHeroFakty);
</script>
