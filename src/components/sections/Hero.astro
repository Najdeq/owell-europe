---
import { getCollection } from "astro:content";
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import WyszukiwarkaModelu from "../WyszukiwarkaModelu.astro";
import { site } from "../../data/site.ts";

const produkty = await getCollection("produkty");
const produktWideo = produkty.find((p) => p.id === "ow-3300");
const wideoAlt = produktWideo
  ? `${produktWideo.data.nazwa} — ${produktWideo.data.tagline}`
  : "Produkt Owell";

const fakty = [
  { target: 40, prefix: "+", suffix: "", etykieta: "produktów w ofercie" },
  { target: site.gwarancjaMiesiace, prefix: "", suffix: " mies.", etykieta: "gwarancji" },
  { target: 35, prefix: "+", suffix: " lat", etykieta: "doświadczenia w branży" },
  { target: 100, prefix: "", suffix: "%", etykieta: "produktów z kartą GPSR" },
];
---

<Section bg="base" class="hero">
  <div class="hero-inner">
    <div class="hero-content">
      <Eyebrow data-reveal>Małe AGD · Projektowane w Europie</Eyebrow>
      <h1 class="hero-title" data-reveal data-reveal-delay="80">
        Tworzymy produkty, z których sami chcielibyśmy korzystać. Od projektu, przez kontrolę jakości, aż po serwis —
        dbamy o każdy etap, aby zapewnić naszym klientom niezawodność i komfort użytkowania.
      </h1>
      <p class="hero-lead" data-reveal data-reveal-delay="160">
        Małe AGD do kuchni, pielęgnacji i podróży — zaprojektowane do codziennego użytku, nie od święta. Każdy
        produkt ma pełne dane producenta, kartę GPSR i {site.gwarancjaMiesiace} miesiące gwarancji, bez wyjątków.
      </p>

      <div class="hero-cta">
        <Button href="/gdzie-kupic" variant="primary">Gdzie kupić</Button>
        <Button href="/o-nas" variant="ghost">Poznaj nas</Button>
      </div>

      <WyszukiwarkaModelu class="hero-szukaj" />

      <dl class="hero-fakty" data-hero-fakty>
        {fakty.map((f) => (
          <div class="fakt">
            <dt>{f.etykieta}</dt>
            <dd data-fakt-wartosc data-target={f.target} data-prefix={f.prefix} data-suffix={f.suffix}>
              {f.prefix}0{f.suffix}
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hero-media">
      <div class="hero-media-frame">
        {/* poster = pierwsza klatka video (90 kB). Bez niego przez cały czas
            pobierania 2,7 MB pliku w najważniejszym miejscu strony wisiała
            pusta ramka, co psuło LCP. */}
        <video
          class="hero-video"
          aria-label={wideoAlt}
          src="/video/ow-3300.mp4"
          poster="/video/ow-3300-poster.jpg"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
        />
      </div>
    </div>
  </div>
</Section>

<style>
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: var(--sp-12);
    width: 100%;
    max-width: 100rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* Powolny dryf ciepłej poświaty za treścią hero — jedyny ciągły ruch
     na stronie. Ma być na granicy zauważalności: gdy widać wyraźną plamę
     zamiast wrażenia oświetlenia, alfa jest za wysoka.
     z-index: -1 trzyma go pod tekstem (element pozycjonowany absolutnie
     rysowałby się nad treścią w normalnym przepływie). */
  .hero-inner::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: -20%;
    left: -10%;
    width: 70%;
    height: 140%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--gold) 12%, transparent),
      transparent
    );
    filter: blur(40px);
    pointer-events: none;
    animation: hero-dryf 22s ease-in-out infinite alternate;
  }

  @keyframes hero-dryf {
    from {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.75;
    }
    to {
      transform: translate3d(12%, 6%, 0) scale(1.15);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-inner::before {
      animation: none;
    }
  }

  .hero-content {
    max-width: var(--maxw-prose);
  }

  .hero-title {
    margin-top: var(--sp-4);
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: 600;
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .hero-lead {
    margin-top: var(--sp-6);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-8);
  }

  :global(.hero-szukaj) {
    margin-top: var(--sp-8);
    max-width: 28rem;
  }

  .hero-fakty {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-6) var(--sp-8);
    margin-top: var(--sp-12);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--hairline-soft);
  }

  .fakt dd {
    font-variant-numeric: tabular-nums;
    font-family: var(--font-mono);
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--gold-bright);
  }

  .fakt dt {
    margin-top: var(--sp-1);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .hero-media {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .hero-media-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: var(--photo-bg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--hairline);
    overflow: hidden;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-media,
  .hero-media-frame {
    max-width: 100%;
  }

  @media (min-width: 480px) {
    .hero-fakty {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: 0.7fr 1.3fr;
      gap: var(--sp-16);
    }

    .hero-media {
      justify-content: flex-end;
    }
  }
</style>

<script>
  // Liczby w Hero zawsze są widoczne od razu przy wejściu na stronę (nad
  // linią zagięcia), więc liczymy w górę od razu po zamontowaniu — bez
  // IntersectionObserver, w przeciwieństwie do sekcji Liczby niżej na stronie.
  function animateHeroFakty() {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    const grid = document.querySelector<HTMLElement>("[data-hero-fakty]");
    if (!grid) return;
    if (grid.dataset.owellBound === "true") return;
    grid.dataset.owellBound = "true";

    const items = grid.querySelectorAll<HTMLElement>("[data-fakt-wartosc]");

    items.forEach((el) => {
      const target = Number(el.dataset.target);
      const prefix = el.dataset.prefix ?? "";
      const suffix = el.dataset.suffix ?? "";

      if (prefersReducedMotion) {
        el.textContent = `${prefix}${target}${suffix}`;
        return;
      }

      const duration = 1200;
      const start = performance.now();

      const step = (now: number) => {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = `${prefix}${Math.round(target * eased)}${suffix}`;

        if (progress < 1) {
          requestAnimationFrame(step);
        } else {
          el.textContent = `${prefix}${target}${suffix}`;
        }
      };

      requestAnimationFrame(step);
    });
  }

  animateHeroFakty();
  document.addEventListener("astro:page-load", animateHeroFakty);
</script>
