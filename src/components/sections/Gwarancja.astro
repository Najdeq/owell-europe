---
import { getRelativeLocaleUrl } from "astro:i18n";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { site } from "../../data/site.ts";
import { domyslnyJezyk, type Jezyk } from "../../i18n/ui.ts";

const jezyk = (Astro.currentLocale ?? domyslnyJezyk) as Jezyk;
const l = (sciezka: string) => getRelativeLocaleUrl(jezyk, sciezka);

const czasReakcji = "24h";

type Tresc = {
  eyebrow: string;
  jednostka: string;
  opis: string;
  punkty: string[];
  detalPodpis: string;
  linkInstrukcje: string;
  linkGwarancja: string;
};

const trescPoJezyku: Partial<Record<Jezyk, Tresc>> = {
  en: {
    eyebrow: "Warranty and service",
    jednostka: "months of warranty",
    opis: `Every Owell product comes with a ${site.gwarancjaMiesiace}-month warranty. Service requests are handled directly, with no redirects between call centres.`,
    punkty: [
      `The warranty covers material and manufacturing defects for the full ${site.gwarancjaMiesiace} months from purchase.`,
      "We handle requests by email, directly — no call centre and no redirects.",
      "Orders placed before 6:30 PM ship the same day, with guaranteed InPost delivery.",
    ],
    detalPodpis: "Service response time",
    linkInstrukcje: "Manuals →",
    linkGwarancja: "Warranty card →",
  },
  de: {
    eyebrow: "Garantie und Service",
    jednostka: "Monate Garantie",
    opis: `Jedes Owell-Produkt kommt mit einer ${site.gwarancjaMiesiace}-monatigen Garantie. Serviceanfragen bearbeiten wir direkt, ohne Weiterleitungen zwischen Callcentern.`,
    punkty: [
      `Die Garantie deckt Material- und Herstellungsfehler für die vollen ${site.gwarancjaMiesiace} Monate ab dem Kaufdatum ab.`,
      "Anfragen bearbeiten wir direkt per E-Mail — ohne Callcenter und ohne Weiterleitungen.",
      "Bis 18:30 Uhr aufgegebene Bestellungen versenden wir noch am selben Tag, mit garantierter InPost-Zustellung.",
    ],
    detalPodpis: "Reaktionszeit des Service",
    linkInstrukcje: "Bedienungsanleitungen →",
    linkGwarancja: "Garantiekarte →",
  },
  ru: {
    eyebrow: "Гарантия и сервис",
    jednostka: "месяцев гарантии",
    opis: `Каждый продукт Owell имеет ${site.gwarancjaMiesiace}-месячную гарантию. Сервисные обращения обрабатываем напрямую, без переадресаций между колл-центрами.`,
    punkty: [
      `Гарантия покрывает материальные и производственные дефекты в течение всего срока ${site.gwarancjaMiesiace} месяцев с момента покупки.`,
      "Обращения принимаем по email, напрямую — без колл-центра и переадресаций.",
      "Заказы, оформленные до 18:30, отправляем в тот же день, с гарантированной доставкой InPost.",
    ],
    detalPodpis: "Время реакции сервиса",
    linkInstrukcje: "Инструкции по эксплуатации →",
    linkGwarancja: "Гарантийный талон →",
  },
  fr: {
    eyebrow: "Garantie et service",
    jednostka: "mois de garantie",
    opis: `Chaque produit Owell bénéficie d'une garantie de ${site.gwarancjaMiesiace} mois. Les demandes de service sont traitées directement, sans redirection entre centres d'appel.`,
    punkty: [
      `La garantie couvre les défauts matériels et de fabrication pendant toute la durée de ${site.gwarancjaMiesiace} mois à compter de l'achat.`,
      "Nous traitons les demandes par e-mail, directement — sans centre d'appel ni redirection.",
      "Les commandes passées avant 18h30 sont expédiées le jour même, avec livraison garantie par InPost.",
    ],
    detalPodpis: "Délai de réponse du service",
    linkInstrukcje: "Notices d'utilisation →",
    linkGwarancja: "Carte de garantie →",
  },
  es: {
    eyebrow: "Garantía y servicio",
    jednostka: "meses de garantía",
    opis: `Todos los productos Owell incluyen una garantía de ${site.gwarancjaMiesiace} meses. Gestionamos las solicitudes de servicio directamente, sin redirecciones entre centralitas.`,
    punkty: [
      `La garantía cubre defectos de material y de fabricación durante los ${site.gwarancjaMiesiace} meses completos desde la compra.`,
      "Gestionamos las solicitudes por email, directamente — sin centralita ni redirecciones.",
      "Los pedidos realizados antes de las 18:30 se envían el mismo día, con entrega garantizada por InPost.",
    ],
    detalPodpis: "Tiempo de respuesta del servicio",
    linkInstrukcje: "Manuales de uso →",
    linkGwarancja: "Tarjeta de garantía →",
  },
  cs: {
    eyebrow: "Záruka a servis",
    jednostka: "měsíců záruky",
    opis: `Každý produkt Owell má ${site.gwarancjaMiesiace}měsíční záruku. Servisní požadavky vyřizujeme přímo, bez přesměrování mezi call centry.`,
    punkty: [
      `Záruka pokrývá materiálové a výrobní vady po celou dobu ${site.gwarancjaMiesiace} měsíců od nákupu.`,
      "Požadavky přijímáme e-mailem, přímo — bez call centra a přesměrování.",
      "Objednávky zadané do 18:30 odesíláme týž den, s garantovaným doručením přes InPost.",
    ],
    detalPodpis: "Reakční doba servisu",
    linkInstrukcje: "Návody k obsluze →",
    linkGwarancja: "Záruční list →",
  },
  it: {
    eyebrow: "Garanzia e assistenza",
    jednostka: "mesi di garanzia",
    opis: `Ogni prodotto Owell è coperto da una garanzia di ${site.gwarancjaMiesiace} mesi. Gestiamo le richieste di assistenza direttamente, senza reindirizzamenti tra call center.`,
    punkty: [
      `La garanzia copre i difetti di materiale e di fabbricazione per l'intero periodo di ${site.gwarancjaMiesiace} mesi dall'acquisto.`,
      "Gestiamo le richieste via e-mail, direttamente — senza call center né reindirizzamenti.",
      "Gli ordini effettuati entro le 18:30 vengono spediti lo stesso giorno, con consegna garantita da InPost.",
    ],
    detalPodpis: "Tempo di risposta dell'assistenza",
    linkInstrukcje: "Manuali d'uso →",
    linkGwarancja: "Scheda di garanzia →",
  },
};

const tresc = trescPoJezyku[jezyk] ?? {
  eyebrow: "Gwarancja i serwis",
  jednostka: "miesięcy gwarancji",
  opis: `Każdy produkt Owell objęty jest ${site.gwarancjaMiesiace}-miesięczną gwarancją. Zgłoszenia serwisowe obsługujemy po polsku, bez przekierowań między infoliniami.`,
  punkty: [
    `Gwarancja obejmuje wady materiałowe i produkcyjne przez cały okres ${site.gwarancjaMiesiace} miesięcy od zakupu.`,
    "Zgłoszenie przyjmujemy mailowo, bezpośrednio — bez infolinii i bez przekierowań.",
    "Zamówienia złożone do 18:30 wysyłamy tego samego dnia, z gwarancją dostawy InPostem.",
  ],
  detalPodpis: "Czas reakcji serwisu",
  linkInstrukcje: "Instrukcje obsługi →",
  linkGwarancja: "Karta gwarancyjna →",
};
---

<Section bg="raised">
  <Container>
    <div class="panel">
      <div class="panel-glowne">
        <Eyebrow data-reveal>{tresc.eyebrow}</Eyebrow>
        <p class="liczba" data-reveal data-reveal-delay="80">
          {site.gwarancjaMiesiace}
          <span class="jednostka">{tresc.jednostka}</span>
        </p>
        <p class="opis">
          {tresc.opis}
        </p>

        <ul class="punkty">
          {tresc.punkty.map((p) => <li>{p}</li>)}
        </ul>
      </div>

      <div class="panel-detale">
        <div class="detal">
          <p class="detal-liczba">{czasReakcji}</p>
          <p class="detal-podpis">{tresc.detalPodpis}</p>
        </div>

        <div class="linki">
          <a href={l("/instrukcje")} class="link">{tresc.linkInstrukcje}</a>
          <a href={l("/gwarancja")} class="link">{tresc.linkGwarancja}</a>
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  .panel {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
    padding: var(--sp-8);
    background-color: var(--bg-1);
    border: 1px solid var(--gold);
    border-radius: var(--radius-lg);
  }

  .liczba {
    margin-top: var(--sp-4);
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 600;
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-display);
    color: var(--gold-bright);
  }

  .jednostka {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .opis {
    margin-top: var(--sp-4);
    max-width: 32rem;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .punkty {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    max-width: 32rem;
    margin-top: var(--sp-4);
    padding-left: var(--sp-4);
    list-style: none;
  }

  .punkty li {
    position: relative;
    padding-left: var(--sp-4);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .punkty li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--gold);
  }

  .panel-detale {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--hairline-soft);
  }

  .detal-liczba {
    font-family: var(--font-mono);
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--text);
  }

  .detal-podpis {
    margin-top: var(--sp-1);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .linki {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .link {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--gold);
    text-decoration: none;
  }

  .link:hover {
    color: var(--gold-bright);
  }

  @media (min-width: 720px) {
    .panel {
      grid-template-columns: 1.2fr 1fr;
      padding: var(--sp-12);
      align-items: center;
    }

    .panel-detale {
      padding-top: 0;
      padding-left: var(--sp-8);
      border-top: none;
      border-left: 1px solid var(--hairline-soft);
    }
  }
</style>
