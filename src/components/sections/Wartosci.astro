---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { domyslnyJezyk, type Jezyk } from "../../i18n/ui.ts";

const jezyk = (Astro.currentLocale ?? domyslnyJezyk) as Jezyk;

// Sekcja jest współdzielona między PL i EN (jak reszta homepage'u) — treść
// gałęzi po języku, zamiast osobnych plików, bo to jedyne miejsce, gdzie
// ten tekst żyje.
type Filar = { tytul: string; opis: string; icon: string };

const eyebrowPoJezyku: Partial<Record<Jezyk, string>> = { en: "Why Owell", de: "Warum Owell", ru: "Почему Owell", fr: "Pourquoi Owell", es: "Por qué Owell", cs: "Proč Owell", it: "Perché Owell" };
const tytulPoJezyku: Partial<Record<Jezyk, string>> = {
  en: "Three pillars of every product",
  de: "Drei Säulen jedes Produkts",
  ru: "Три принципа каждого продукта",
  fr: "Trois piliers pour chaque produit",
  es: "Tres pilares de cada producto",
  cs: "Tři pilíře každého produktu",
  it: "Tre pilastri di ogni prodotto",
};
const eyebrow = eyebrowPoJezyku[jezyk] ?? "Dlaczego Owell";
const tytulSekcji = tytulPoJezyku[jezyk] ?? "Trzy filary każdego produktu";

const filaryEn: Filar[] = [
  {
    tytul: "Design",
    opis: "We design shapes to still suit a kitchen in five years, not just today. Simple forms, calm proportions, minimal ornamentation.",
    icon: "design",
  },
  {
    tytul: "Quality",
    opis: "We choose materials and components for daily use, not a one-off test on the box. Every model has a GPSR card with full manufacturer data.",
    icon: "jakosc",
  },
  {
    tytul: "Service",
    opis: "Manuals and service contact are available with no redirects between call centres. Your request goes straight to us, not to a bot.",
    icon: "serwis",
  },
];

const filaryDe: Filar[] = [
  {
    tytul: "Design",
    opis: "Wir gestalten Formen so, dass sie auch in fünf Jahren noch in die Küche passen, nicht nur heute. Einfache Formen, ruhige Proportionen, minimale Verzierungen.",
    icon: "design",
  },
  {
    tytul: "Qualität",
    opis: "Wir wählen Materialien und Komponenten für den täglichen Gebrauch, nicht für einen einmaligen Test auf der Verpackung. Jedes Modell hat eine GPSR-Karte mit vollständigen Herstellerangaben.",
    icon: "jakosc",
  },
  {
    tytul: "Service",
    opis: "Bedienungsanleitungen und Servicekontakt sind ohne Weiterleitungen zwischen Callcentern verfügbar. Ihre Anfrage geht direkt an uns, nicht an einen Bot.",
    icon: "serwis",
  },
];

const filaryPl: Filar[] = [
  {
    tytul: "Design",
    opis: "Formy projektujemy tak, by pasowały do kuchni za pięć lat, nie tylko dziś. Prosta bryła, spokojne proporcje, minimum ozdobników.",
    icon: "design",
  },
  {
    tytul: "Jakość",
    opis: "Materiały i podzespoły dobieramy pod kątem codziennej eksploatacji, nie jednorazowego testu na pudełku. Każdy model ma kartę GPSR z pełnymi danymi producenta.",
    icon: "jakosc",
  },
  {
    tytul: "Serwis",
    opis: "Instrukcje i kontakt serwisowy są dostępne po polsku, bez przekierowań między infoliniami. Zgłoszenie trafia bezpośrednio do nas, nie do automatu.",
    icon: "serwis",
  },
];

const filaryRu: Filar[] = [
  {
    tytul: "Дизайн",
    opis: "Мы проектируем формы так, чтобы они подходили кухне и через пять лет, а не только сегодня. Простые формы, спокойные пропорции, минимум декора.",
    icon: "design",
  },
  {
    tytul: "Качество",
    opis: "Материалы и компоненты подбираем для ежедневной эксплуатации, а не разового теста на коробке. Каждая модель имеет карту GPSR с полными данными производителя.",
    icon: "jakosc",
  },
  {
    tytul: "Сервис",
    opis: "Инструкции и сервисный контакт доступны без переадресаций между колл-центрами. Обращение поступает напрямую к нам, а не боту.",
    icon: "serwis",
  },
];

const filaryFr: Filar[] = [
  {
    tytul: "Design",
    opis: "Nous concevons des formes qui conviendront encore à une cuisine dans cinq ans, pas seulement aujourd'hui. Des lignes simples, des proportions équilibrées, un minimum d'ornements.",
    icon: "design",
  },
  {
    tytul: "Qualité",
    opis: "Nous choisissons matériaux et composants pour un usage quotidien, pas pour un test ponctuel sur l'emballage. Chaque modèle dispose d'une fiche GPSR avec les coordonnées complètes du fabricant.",
    icon: "jakosc",
  },
  {
    tytul: "Service",
    opis: "Notices et contact du service sont disponibles sans redirections entre centres d'appel. Votre demande nous parvient directement, pas à un robot.",
    icon: "serwis",
  },
];

const filaryEs: Filar[] = [
  {
    tytul: "Diseño",
    opis: "Diseñamos formas que sigan encajando en una cocina dentro de cinco años, no solo hoy. Formas simples, proporciones equilibradas, ornamentación mínima.",
    icon: "design",
  },
  {
    tytul: "Calidad",
    opis: "Elegimos materiales y componentes para el uso diario, no para una prueba puntual en la caja. Cada modelo tiene una ficha GPSR con los datos completos del fabricante.",
    icon: "jakosc",
  },
  {
    tytul: "Servicio",
    opis: "Los manuales y el contacto de servicio están disponibles sin redirecciones entre centralitas. Tu solicitud llega directamente a nosotros, no a un robot.",
    icon: "serwis",
  },
];

const filaryCs: Filar[] = [
  {
    tytul: "Design",
    opis: "Tvary navrhujeme tak, aby se hodily do kuchyně i za pět let, ne jen dnes. Jednoduché tvary, klidné proporce, minimum ozdob.",
    icon: "design",
  },
  {
    tytul: "Kvalita",
    opis: "Materiály a součástky vybíráme s ohledem na každodenní používání, ne jednorázový test na krabici. Každý model má kartu GPSR s kompletními údaji o výrobci.",
    icon: "jakosc",
  },
  {
    tytul: "Servis",
    opis: "Návody a servisní kontakt jsou dostupné bez přesměrování mezi call centry. Váš požadavek jde přímo k nám, ne k robotovi.",
    icon: "serwis",
  },
];

const filaryIt: Filar[] = [
  {
    tytul: "Design",
    opis: "Progettiamo forme che si adattino alla cucina anche tra cinque anni, non solo oggi. Linee semplici, proporzioni equilibrate, il minimo di decorazioni.",
    icon: "design",
  },
  {
    tytul: "Qualità",
    opis: "Scegliamo materiali e componenti pensando all'uso quotidiano, non a un test occasionale sulla confezione. Ogni modello ha una scheda GPSR con i dati completi del produttore.",
    icon: "jakosc",
  },
  {
    tytul: "Assistenza",
    opis: "Manuali e contatto assistenza sono disponibili senza reindirizzamenti tra call center. La tua richiesta arriva direttamente a noi, non a un bot.",
    icon: "serwis",
  },
];

const filaryPoJezyku: Partial<Record<Jezyk, Filar[]>> = { en: filaryEn, de: filaryDe, ru: filaryRu, fr: filaryFr, es: filaryEs, cs: filaryCs, it: filaryIt };
const filary = filaryPoJezyku[jezyk] ?? filaryPl;
---

<style is:global>
  /* Rysowanie konturu ikony po wjechaniu karty w kadr. Wszystkie ścieżki mają
     pathLength="1", więc jedna reguła działa niezależnie od ich realnej
     długości — bez tego każda ikona wymagałaby własnej wartości dasharray. */
  @keyframes filar-rysuj {
    from { stroke-dashoffset: 1; }
    to   { stroke-dashoffset: 0; }
  }
</style>

<Section bg="raised">
  <Container>
    <Eyebrow data-reveal>{eyebrow}</Eyebrow>
    <h2 class="section-title" data-reveal data-reveal-delay="80">{tytulSekcji}</h2>

    <div class="grid">
      {filary.map((f, i) => (
        <article class="filar" data-reveal data-reveal-delay={160 + i * 120}>
          <span class="filar-numer" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>

          <div class="icon" aria-hidden="true">
            {f.icon === "design" && (
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="16" cy="16" r="10" pathLength="1" stroke-linecap="round" />
                <path d="M16 6v6M16 20v6M6 16h6M20 16h6" pathLength="1" stroke-linecap="round" />
              </svg>
            )}
            {f.icon === "jakosc" && (
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M16 4 27 9v8c0 7-4.7 11.7-11 15C9.7 28.7 5 24 5 17V9l11-5Z" pathLength="1" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M11 16l3.5 3.5L21 12" pathLength="1" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {f.icon === "serwis" && (
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M18.7 6.3a5 5 0 0 0-6.8 6.8L4 21v3h3l7.9-7.9a5 5 0 0 0 6.8-6.8l-3.2 3.2-3-3 3.2-3.2Z" pathLength="1" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </div>

          <h3 class="filar-tytul">{f.tytul}</h3>
          <p class="filar-opis">{f.opis}</p>
        </article>
      ))}
    </div>
  </Container>
</Section>

<style>
  .section-title {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
    margin-top: var(--sp-12);
  }

  .filar {
    position: relative;
    padding: var(--sp-8) var(--sp-6);
    background-color: var(--bg-1);
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      transform var(--dur-slow) var(--ease);
  }

  /* Złota nitka na górnej krawędzi — rozjeżdża się od lewej przy najechaniu.
     Jedyny „ozdobnik” w tej sekcji, celowo cienki: złoto ma być biżuterią. */
  .filar::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background-color: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-slow) var(--ease);
  }

  .filar:hover {
    background-color: var(--bg-2);
    border-color: var(--hairline);
    transform: translateY(-4px);
  }

  .filar:hover::before {
    transform: scaleX(1);
  }

  .filar-numer {
    position: absolute;
    top: var(--sp-4);
    right: var(--sp-5);
    font-family: var(--font-mono);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1;
    color: var(--text);
    opacity: 0.08;
    transition: opacity var(--dur-slow) var(--ease);
  }

  .filar:hover .filar-numer {
    opacity: 0.16;
  }

  .icon {
    width: 40px;
    height: 40px;
    color: var(--gold);
    transition:
      color var(--dur) var(--ease),
      transform var(--dur-slow) var(--ease);
  }

  .filar:hover .icon {
    color: var(--gold-bright);
    transform: scale(1.08);
  }

  .icon svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Kontury rysują się dopiero, gdy karta wjedzie w kadr (.is-revealed
     dokłada ScrollReveal). Do tego czasu są schowane, żeby efekt nie
     „przepadł” u kogoś, kto wchodzi na stronę wysoko nad tą sekcją. */
  .icon svg :is(path, circle) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .filar.is-revealed .icon svg :is(path, circle) {
    animation: filar-rysuj 900ms var(--ease) forwards;
  }

  .filar.is-revealed .icon svg :is(path, circle):nth-child(2) {
    animation-delay: 220ms;
  }

  .filar-tytul {
    margin-top: var(--sp-5);
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--text);
  }

  .filar-opis {
    margin-top: var(--sp-3);
    max-width: 32rem;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .filar {
      padding: var(--sp-8);
    }
  }

  /* Bez ruchu: kontury od razu widoczne, zero przesunięć. */
  @media (prefers-reduced-motion: reduce) {
    .icon svg :is(path, circle) {
      stroke-dashoffset: 0;
      animation: none !important;
    }

    .filar:hover {
      transform: none;
    }
  }
</style>
