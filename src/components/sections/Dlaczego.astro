---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { site } from "../../data/site.ts";
import detalCzajnik from "../../assets/marka/detal-czajnik.jpg";

// Liczby przekazane przez właściciela marki.
const argumenty = [
  {
    prefix: "",
    liczba: String(site.gwarancjaMiesiace),
    jednostka: "miesiące gwarancji",
    opis: "Każdy produkt Owell objęty jest 24-miesięczną gwarancją. Zapewniamy również profesjonalny serwis pogwarancyjny oraz łatwy dostęp do części zamiennych.",
  },
  {
    prefix: "Ponad",
    liczba: "40",
    jednostka: "starannie opracowanych modeli",
    opis: "Nasze produkty powstają z myślą o codziennym komforcie użytkowania. Łączą funkcjonalność, nowoczesny design oraz zgodność z wymaganiami i normami obowiązującymi w Unii Europejskiej.",
  },
  {
    prefix: "Doświadczenie budowane od",
    liczba: "1991",
    jednostka: "roku",
    opis: "Za marką Owell stoi zespół z ponad 35-letnim doświadczeniem w branży małego AGD i produktów użytkowych. Wiedza zdobywana przez lata pozwala nam tworzyć produkty, którym zaufały miliony klientów.",
  },
  {
    prefix: "Obecność w ponad",
    liczba: "60",
    jednostka: "krajach",
    opis: "Produkty tworzone przez nasz zespół trafiają do klientów w 60 krajach na całym świecie. Stale rozwijamy naszą międzynarodową obecność.",
  },
  {
    prefix: "",
    liczba: "30 000",
    jednostka: "m² centrum logistycznego",
    opis: "Dysponujemy własnym zapleczem logistycznym o powierzchni 30 000 m². Dzięki temu zapewniamy wysoką dostępność produktów, sprawną realizację zamówień oraz profesjonalną obsługę.",
  },
];
---

<Section bg="raised">
  <Container class="dlaczego-inner">
    <div class="dlaczego-media">
      <Image
        src={detalCzajnik}
        alt="Czajnik Owell OW-1360B z wyświetlaczem temperatury, trzymany w dłoniach"
        width={1024}
        height={1024}
      />
    </div>

    <div class="dlaczego-content">
      <Eyebrow data-reveal>Dowody, nie deklaracje</Eyebrow>
      <h2 class="section-title" data-reveal data-reveal-delay="80">Dlaczego Owell</h2>

      <dl class="argumenty">
        {argumenty.map((a) => (
          <div class="argument">
            <dt class="argument-liczba">
              {a.prefix && <span class="argument-prefix">{a.prefix} </span>}
              {a.liczba} <span class="argument-jednostka">{a.jednostka}</span>
            </dt>
            <dd class="argument-opis">{a.opis}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Container>
</Section>

<style>
  :global(.dlaczego-inner) {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-12);
  }

  .dlaczego-media :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--hairline-soft);
  }

  .section-title {
    margin-top: var(--sp-4);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .argumenty {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
    margin-top: var(--sp-12);
  }

  .argument-liczba {
    font-family: var(--font-mono);
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--gold-bright);
  }

  .argument-prefix {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: 400;
    color: var(--text-2);
  }

  .argument-jednostka {
    font-size: var(--fs-small);
    font-weight: 400;
    color: var(--steel);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
  }

  .argument-opis {
    margin-top: var(--sp-2);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  @media (min-width: 720px) {
    .argumenty {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Piąty argument (nieparzysta liczba elementów) rozciąga się na całą
       szerokość, żeby nie zostawiać osamotnionej karty w prawej kolumnie. */
    .argument:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 960px) {
    :global(.dlaczego-inner) {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--sp-16);
      align-items: center;
    }
  }
</style>
