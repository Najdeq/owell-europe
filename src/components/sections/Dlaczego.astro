---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { site } from "../../data/site.ts";
import detalCzajnik from "../../assets/marka/detal-czajnik.jpg";

const produkty = await getCollection("produkty");

// Tylko dane, które da się sprawdzić: gwarancja i liczba modeli wynikają
// wprost z site.ts i kolekcji produktów, pozostałe dwie z site.grupa
// (fakty o Adler Europe Group przekazane przez właściciela).
// Nie dodawaj tu liczb sprzedaży, ocen ani lat doświadczenia bez źródła.
const argumenty = [
  {
    liczba: String(site.gwarancjaMiesiace),
    jednostka: "miesiące",
    opis: "gwarancji na każdy produkt, bez wyjątków.",
  },
  {
    liczba: String(produkty.length),
    jednostka: "modeli",
    opis: "w aktualnej ofercie, każdy z pełną kartą GPSR.",
  },
  {
    liczba: "100%",
    jednostka: "produktów",
    opis: "z pełnymi danymi producenta i dokumentacją zgodności.",
  },
  {
    liczba: String(site.grupa.odRokuWPolsce),
    jednostka: "rok",
    opis: `od którego ${site.grupa.nazwa} działa na polskim rynku.`,
  },
];
---

<Section bg="raised">
  <Container class="dlaczego-inner">
    <div class="dlaczego-media">
      <Image
        src={detalCzajnik}
        alt="Czajnik Owell OW-1360B z wyświetlaczem temperatury, trzymany w dłoniach"
        width={1024}
        height={1024}
      />
    </div>

    <div class="dlaczego-content">
      <Eyebrow data-reveal>Dowody, nie deklaracje</Eyebrow>
      <h2 class="section-title" data-reveal data-reveal-delay="80">Dlaczego Owell</h2>

      <dl class="argumenty">
        {argumenty.map((a) => (
          <div class="argument">
            <dt class="argument-liczba">
              {a.liczba} <span class="argument-jednostka">{a.jednostka}</span>
            </dt>
            <dd class="argument-opis">{a.opis}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Container>
</Section>

<style>
  :global(.dlaczego-inner) {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-12);
  }

  .dlaczego-media :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--hairline-soft);
  }

  .section-title {
    margin-top: var(--sp-4);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .argumenty {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
    margin-top: var(--sp-12);
  }

  .argument-liczba {
    font-family: var(--font-mono);
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--gold-bright);
  }

  .argument-jednostka {
    font-size: var(--fs-small);
    font-weight: 400;
    color: var(--steel);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
  }

  .argument-opis {
    margin-top: var(--sp-2);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  @media (min-width: 720px) {
    .argumenty {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    :global(.dlaczego-inner) {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--sp-16);
      align-items: center;
    }
  }
</style>
