---
import { getRelativeLocaleUrl } from "astro:i18n";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { site } from "../../data/site.ts";
import { domyslnyJezyk, type Jezyk } from "../../i18n/ui.ts";

const jezyk = (Astro.currentLocale ?? domyslnyJezyk) as Jezyk;
const l = (sciezka: string) => getRelativeLocaleUrl(jezyk, sciezka);

type Tresc = { eyebrow: string; tytul: string; ogolne: string; serwis: string; formularz: string; napisz: string };

const trescPoJezyku: Partial<Record<Jezyk, Tresc>> = {
  en: {
    eyebrow: "Contact",
    tytul: "Have a question?",
    ogolne: "General enquiries",
    serwis: "Service and complaints",
    formularz: "Contact form",
    napisz: "Write to us",
  },
  de: {
    eyebrow: "Kontakt",
    tytul: "Haben Sie eine Frage?",
    ogolne: "Allgemeine Anfragen",
    serwis: "Service und Reklamationen",
    formularz: "Kontaktformular",
    napisz: "Schreiben Sie uns",
  },
  ru: {
    eyebrow: "Контакты",
    tytul: "Есть вопрос?",
    ogolne: "Общие вопросы",
    serwis: "Сервис и рекламации",
    formularz: "Форма обратной связи",
    napisz: "Написать нам",
  },
  fr: {
    eyebrow: "Contact",
    tytul: "Une question ?",
    ogolne: "Demandes générales",
    serwis: "Service et réclamations",
    formularz: "Formulaire de contact",
    napisz: "Écrivez-nous",
  },
  es: {
    eyebrow: "Contacto",
    tytul: "¿Tienes alguna pregunta?",
    ogolne: "Consultas generales",
    serwis: "Servicio y reclamaciones",
    formularz: "Formulario de contacto",
    napisz: "Escríbenos",
  },
  cs: {
    eyebrow: "Kontakt",
    tytul: "Máte dotaz?",
    ogolne: "Obecné dotazy",
    serwis: "Servis a reklamace",
    formularz: "Kontaktní formulář",
    napisz: "Napište nám",
  },
  it: {
    eyebrow: "Contatti",
    tytul: "Hai una domanda?",
    ogolne: "Richieste generali",
    serwis: "Assistenza e reclami",
    formularz: "Modulo di contatto",
    napisz: "Scrivici",
  },
};

const tresc = trescPoJezyku[jezyk] ?? {
  eyebrow: "Kontakt",
  tytul: "Masz pytanie?",
  ogolne: "Zapytania ogólne",
  serwis: "Serwis i reklamacje",
  formularz: "Formularz kontaktowy",
  napisz: "Napisz do nas",
};
---

<Section bg="raised">
  <Container>
    <Eyebrow data-reveal>{tresc.eyebrow}</Eyebrow>
    <h2 class="section-title" data-reveal data-reveal-delay="80">{tresc.tytul}</h2>

    <div class="grid">
      <div class="kontakt-item">
        <p class="kontakt-etykieta">{tresc.ogolne}</p>
        <a href={`mailto:${site.kontakt.email}`} class="kontakt-email">{site.kontakt.email}</a>
      </div>

      <div class="kontakt-item">
        <p class="kontakt-etykieta">{tresc.serwis}</p>
        <a href={`mailto:${site.kontakt.emailSerwis}`} class="kontakt-email">{site.kontakt.emailSerwis}</a>
      </div>

      <div class="kontakt-item">
        <p class="kontakt-etykieta">WhatsApp</p>
        <a
          href={`https://wa.me/${site.kontakt.whatsappWa}`}
          target="_blank"
          rel="noopener noreferrer"
          class="kontakt-email"
        >
          {site.kontakt.whatsapp}
        </a>
      </div>

      <div class="kontakt-item">
        <p class="kontakt-etykieta">{tresc.formularz}</p>
        <Button href={l("/kontakt")} variant="ghost">{tresc.napisz}</Button>
      </div>
    </div>
  </Container>
</Section>

<style>
  .section-title {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
    margin-top: var(--sp-12);
  }

  .kontakt-etykieta {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .kontakt-email {
    display: inline-block;
    margin-top: var(--sp-3);
    font-size: var(--fs-lead);
    color: var(--gold);
    text-decoration: none;
  }

  .kontakt-email:hover {
    color: var(--gold-bright);
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
