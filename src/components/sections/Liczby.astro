---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { site } from "../../data/site.ts";
import { domyslnyJezyk, type Jezyk } from "../../i18n/ui.ts";

const jezyk = (Astro.currentLocale ?? domyslnyJezyk) as Jezyk;

// Liczby pochodzą z site.ts (dane przekazane przez właściciela). Prezentowane
// wprost jako dorobek marki Owell — patrz komentarz przy `site.grupa`.
// Nie dodawaj tu liczb sprzedaży ani ocen bez źródła.
const liczby =
  jezyk === "en"
    ? [
        { target: site.grupa.lataHistorii, unit: "plain", suffix: "+", podpis: "years of history" },
        {
          target: site.grupa.liczbaKrajow,
          unit: "plain",
          suffix: "+",
          podpis: "countries worldwide",
          opis: "That's how many markets our international distribution covers.",
        },
        {
          target: site.grupa.liczbaProduktow,
          unit: "plain",
          suffix: "+",
          podpis: "products in the portfolio",
          opis: "A constantly growing range of small appliances.",
        },
        {
          target: 1991,
          unit: "plain",
          suffix: "",
          podpis: "That's where it all began",
          opis: "Over three decades of experience making everyday products.",
        },
      ]
    : [
        { target: site.grupa.lataHistorii, unit: "plain", suffix: "+", podpis: "lat historii" },
        {
          target: site.grupa.liczbaKrajow,
          unit: "plain",
          suffix: "+",
          podpis: "krajów na świecie",
          opis: "Tyle rynków obejmuje nasza międzynarodowa dystrybucja.",
        },
        {
          target: site.grupa.liczbaProduktow,
          unit: "plain",
          suffix: "+",
          podpis: "produktów w portfolio",
          opis: "Stale rozbudowywana oferta małego AGD.",
        },
        {
          target: 1991,
          unit: "plain",
          suffix: "",
          podpis: "Od tego wszystko się zaczęło",
          opis: "Ponad trzy dekady doświadczenia w tworzeniu produktów użytkowych.",
        },
      ];

const tresc =
  jezyk === "en"
    ? {
        eyebrow: "Numbers, not promises",
        tytul: "The foundation the brand stands on",
        lead: "The scale and experience behind every Owell product — no exaggeration.",
      }
    : {
        eyebrow: "Liczby, nie obietnice",
        tytul: "Zaplecze, na którym stoi marka",
        lead: "Skala i doświadczenie, które stoją za każdym produktem Owell — bez podkoloryzowania.",
      };

function format(value: number, unit: string, decimals = 0, suffix = "") {
  if (unit === "tys") {
    return `${Math.floor(value / 1000)} tys.${suffix}`;
  }
  return `${value.toFixed(decimals)}${suffix}`;
}
---

<Section bg="base">
  <Container>
    <Eyebrow data-reveal>{tresc.eyebrow}</Eyebrow>
    <h2 class="section-title" data-reveal data-reveal-delay="80">{tresc.tytul}</h2>
    <p class="section-lead" data-reveal data-reveal-delay="160">
      {tresc.lead}
    </p>

    <div class="grid" data-liczby>
      {liczby.map((l) => (
        <div class="liczba-item">
          <p
            class="liczba-wartosc"
            data-liczba-wartosc
            data-target={l.target}
            data-unit={l.unit}
            data-decimals="0"
            data-suffix={l.suffix}
          >
            {format(l.target, l.unit, 0, l.suffix)}
          </p>
          <p class="liczba-podpis">{l.podpis}</p>
          {l.opis && <p class="liczba-opis">{l.opis}</p>}
        </div>
      ))}
    </div>
  </Container>
</Section>

<style>
  .section-title {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .section-lead {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-12);
    margin-top: var(--sp-12);
  }

  .liczba-wartosc {
    font-variant-numeric: tabular-nums;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 600;
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-display);
    color: var(--gold-bright);
  }

  .liczba-podpis {
    margin-top: var(--sp-3);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .liczba-opis {
    margin-top: var(--sp-2);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  @media (min-width: 560px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-10) var(--sp-8);
    }
  }

  @media (min-width: 960px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--sp-8);
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  const format = (
    value: number,
    unit: string,
    decimals: number,
    suffix: string
  ) => {
    if (unit === "tys") {
      return `${Math.floor(value / 1000)} tys.${suffix}`;
    }
    return `${value.toFixed(decimals)}${suffix}`;
  };

  const animate = (el: HTMLElement) => {
    const target = Number(el.dataset.target);
    const unit = el.dataset.unit ?? "plain";
    const decimals = Number(el.dataset.decimals ?? 0);
    const suffix = el.dataset.suffix ?? "";

    if (prefersReducedMotion) {
      el.textContent = format(target, unit, decimals, suffix);
      return;
    }

    const duration = 1400;
    const start = performance.now();

    const step = (now: number) => {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = format(target * eased, unit, decimals, suffix);

      if (progress < 1) {
        requestAnimationFrame(step);
      } else {
        el.textContent = format(target, unit, decimals, suffix);
      }
    };

    requestAnimationFrame(step);
  };

  const grid = document.querySelector<HTMLElement>("[data-liczby]");

  if (grid) {
    const items =
      grid.querySelectorAll<HTMLElement>("[data-liczba-wartosc]");

    const observer = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            obs.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.4 }
    );

    items.forEach((el) => {
      el.textContent = format(0, el.dataset.unit ?? "plain", 0, "");
      observer.observe(el);
    });
  }
</script>
