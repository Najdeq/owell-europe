---
import Container from "./ui/Container.astro";
import Section from "./ui/Section.astro";
import { domyslnyJezyk, type Jezyk } from "../i18n/ui.ts";
import { useTranslations } from "../i18n/utils.ts";

interface Props {
  produktId: string;
  nazwa: string;
  tagline: string;
}

const { produktId, nazwa, tagline } = Astro.props;

const jezyk = (Astro.currentLocale ?? domyslnyJezyk) as Jezyk;
const t = useTranslations(jezyk);
---

<Section bg="base">
  <Container>
    <div class="oo" data-oo data-oo-produkt-id={produktId} data-oo-nazwa={nazwa} data-oo-tagline={tagline} hidden>
      <h2 class="naglowek" data-reveal>{t("produkt.ostatnioOgladaneTytul")}</h2>
      <div class="oo-rzad" data-oo-rzad></div>
    </div>
  </Container>
</Section>

<style>
  .naglowek {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--text);
  }

  .oo-rzad {
    display: flex;
    gap: var(--sp-4);
    margin-top: var(--sp-6);
    overflow-x: auto;
    padding-bottom: var(--sp-2);
    scroll-snap-type: x proximity;
  }

  .oo-rzad :global(.oo-karta) {
    display: block;
    flex: none;
    width: 10rem;
    scroll-snap-align: start;
    text-decoration: none;
  }

  .oo-rzad :global(.oo-foto) {
    aspect-ratio: 1 / 1;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius);
    background-color: var(--photo-bg);
    overflow: hidden;
  }

  .oo-rzad :global(.oo-foto img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur) var(--ease);
  }

  .oo-rzad :global(.oo-karta:hover .oo-foto img) {
    transform: scale(1.05);
  }

  .oo-rzad :global(.oo-nazwa) {
    margin-top: var(--sp-3);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text);
  }

  .oo-rzad :global(.oo-tagline) {
    margin-top: var(--sp-1);
    overflow: hidden;
    font-size: var(--fs-micro);
    line-height: var(--lh-body);
    color: var(--text-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
</style>

<script>
  function setupOstatnioOgladane() {
    const container = document.querySelector<HTMLElement>("[data-oo]");
    if (!container) return;
    if (container.dataset.owellBound === "true") return;
    container.dataset.owellBound = "true";

    const STORAGE_KEY = "owell-ostatnio-ogladane";
    const MAX_STORED = 10;
    const MAX_SHOWN = 6;

    interface Wpis {
      id: string;
      href: string;
      nazwa: string;
      tagline: string;
      img: string;
    }

    function readList(): Wpis[] {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        const parsed = raw ? JSON.parse(raw) : [];
        return Array.isArray(parsed) ? parsed : [];
      } catch (e) {
        return [];
      }
    }

    function writeList(list: Wpis[]) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
      } catch (e) {}
    }

    const produktId = container.dataset.ooProduktId ?? "";
    const nazwa = container.dataset.ooNazwa ?? "";
    const tagline = container.dataset.ooTagline ?? "";

    // Zapis bieżącego produktu — niezależnie od tego, co pokażemy niżej.
    if (produktId) {
      const slajd = document.querySelector<HTMLImageElement>('[data-galeria-slajd][data-index="0"]');
      const img = slajd ? slajd.currentSrc || slajd.src : "";
      const lista = readList().filter((p) => p.id !== produktId);
      lista.unshift({ id: produktId, href: window.location.pathname, nazwa, tagline, img });
      writeList(lista.slice(0, MAX_STORED));
    }

    // Wyświetlenie paska — bieżący produkt nie pokazuje się we własnym "ostatnio oglądane".
    const doPokazania = readList()
      .filter((p) => p.id !== produktId && p.img)
      .slice(0, MAX_SHOWN);
    if (doPokazania.length === 0) return;

    const rzad = container.querySelector<HTMLElement>("[data-oo-rzad]");
    if (!rzad) return;

    doPokazania.forEach((p) => {
      const a = document.createElement("a");
      a.className = "oo-karta";
      a.href = p.href;

      const foto = document.createElement("div");
      foto.className = "oo-foto";
      const img = document.createElement("img");
      img.src = p.img;
      img.alt = "";
      img.loading = "lazy";
      img.width = 200;
      img.height = 200;
      foto.appendChild(img);
      a.appendChild(foto);

      const nazwaEl = document.createElement("p");
      nazwaEl.className = "oo-nazwa";
      nazwaEl.textContent = p.nazwa;
      a.appendChild(nazwaEl);

      const taglineEl = document.createElement("p");
      taglineEl.className = "oo-tagline";
      taglineEl.textContent = p.tagline;
      a.appendChild(taglineEl);

      rzad.appendChild(a);
    });

    container.hidden = false;
  }

  setupOstatnioOgladane();
  document.addEventListener("astro:page-load", setupOstatnioOgladane);
</script>