---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { getRelativeLocaleUrl } from "astro:i18n";
import ConsentBanner from "../components/ConsentBanner.astro";
import Analytics from "../components/Analytics.astro";
import WhatsAppWidget from "../components/WhatsAppWidget.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import { site } from "../data/site.ts";
import { podglad } from "../data/deploy.ts";
import { ui, domyslnyJezyk, type Jezyk } from "../i18n/ui.ts";

const jezyk = (Astro.currentLocale ?? domyslnyJezyk) as Jezyk;

const ogLocale: Record<Jezyk, string> = {
  pl: "pl_PL",
  en: "en_US",
  de: "de_DE",
  ru: "ru_RU",
  fr: "fr_FR",
  es: "es_ES",
  cs: "cs_CZ",
  it: "it_IT",
};

// Ścieżka bez przedrostka języka — do budowania hreflang dla KAŻDEGO języka
// z tego samego miejsca (getRelativeLocaleUrl sam dokłada właściwy prefiks).
const segmentyUrl = Astro.url.pathname.split("/").filter(Boolean);
const sciezkaBezPrefiksu =
  segmentyUrl[0] === jezyk && jezyk !== domyslnyJezyk
    ? "/" + segmentyUrl.slice(1).join("/")
    : Astro.url.pathname;
const wszystkieJezyki = Object.keys(ui) as Jezyk[];

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, ogImage, noindex = false } = Astro.props;

// Na wdrożeniach podglądowych blokujemy indeksowanie całego serwisu,
// niezależnie od ustawienia per-strona.
const blokujIndeksowanie = noindex || podglad;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedOgImage = ogImage
  ? new URL(ogImage, Astro.site)
  : new URL("/og-default.jpg", Astro.site);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.nazwa,
  legalName: site.firma.nazwaPelna,
  url: Astro.site?.toString(),
  logo: new URL("/logo.png", Astro.site).toString(),
  email: site.kontakt.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.firma.adres,
  },
  ...(site.sameAs.length > 0 ? { sameAs: site.sameAs } : {}),
};
---

<!doctype html>
<html lang={jezyk}>
  <head>
    <!--
      Google Consent Mode v2 — musi wykonać się PRZED jakimkolwiek skryptem
      Google (GA4 jest wstrzykiwany dynamicznie dopiero po zgodzie, patrz
      ConsentBanner.astro). Domyślnie wszystko "denied".
    -->
    <script is:inline>
      (function () {
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        window.gtag = gtag;

        gtag("consent", "default", {
          ad_storage: "denied",
          analytics_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
          personalization_storage: "denied",
          wait_for_update: 500,
        });

        try {
          var raw = localStorage.getItem("owell-consent");
          if (raw) {
            var saved = JSON.parse(raw);
            if (saved && saved.version === 1) {
              gtag("consent", "update", {
                analytics_storage: saved.analytics ? "granted" : "denied",
                ad_storage: saved.marketing ? "granted" : "denied",
                ad_user_data: saved.marketing ? "granted" : "denied",
                ad_personalization: saved.marketing ? "granted" : "denied",
                personalization_storage: saved.marketing ? "granted" : "denied",
              });
            }
          }
        } catch (e) {}
      })();
    </script>

    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("owell-theme");
          if (saved === "light") {
            document.documentElement.setAttribute("data-theme", "light");
            var meta = document.getElementById("theme-color-meta");
            if (meta) meta.setAttribute("content", "#FAF7F1");
          }
        } catch (e) {}
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta id="theme-color-meta" name="theme-color" content="#0F0E0C" />
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={`${site.nazwa} — Blog`} href="/rss.xml" />
    {wszystkieJezyki.map((kod) => (
      <link rel="alternate" hreflang={kod} href={new URL(getRelativeLocaleUrl(kod, sciezkaBezPrefiksu), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(getRelativeLocaleUrl(domyslnyJezyk, sciezkaBezPrefiksu), Astro.site)} />

    {blokujIndeksowanie && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:locale" content={ogLocale[jezyk]} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <meta name="generator" content={Astro.generator} />

    <!-- [data-reveal] ma domyślnie opacity:0 (patrz global.css) i staje się
         widoczny wyłącznie przez JS (ScrollReveal.astro, IntersectionObserver).
         Bez tego fallbacku każdy scenariusz bez działającego JS (błąd skryptu,
         wolne łącze, wyłączony JS) trwale ukrywałby nagłówki i treść sekcji. -->
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <ClientRouter />

    <slot name="head" />
  </head>
  <body>
    <a href="#content" class="skip-link">{ui[jezyk].common.przejdzDoTresci}</a>

    <slot />

    <ConsentBanner />
    <Analytics />
    <WhatsAppWidget />
    <ScrollReveal />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--sp-4);
    z-index: 100;
    padding: var(--sp-3) var(--sp-6);
    background-color: var(--gold-surface);
    color: var(--ink-on-gold);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    border-radius: var(--radius-sm);
    transition: top var(--dur) var(--ease);
  }

  .skip-link:focus-visible {
    top: var(--sp-4);
  }
</style>
