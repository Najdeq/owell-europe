---
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Prose from "../../components/ui/Prose.astro";
import { site } from "../../data/site.ts";

const l = (sciezka: string) => getRelativeLocaleUrl("ru", sciezka);

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "Политика конфиденциальности", path: l("/polityka-prywatnosci") },
];
---

<Base
  title="Политика конфиденциальности — Owell"
  description="Как обрабатываются персональные данные на сайте Owell: оператор, цели, правовые основания, получатели данных и права субъектов данных."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title">Политика конфиденциальности</h1>

        <Prose>
          <h2>Оператор данных</h2>
          <p>
            Оператором персональных данных, обрабатываемых в связи с использованием данного сайта, является{" "}
            <strong>{site.firma.nazwaPelna}</strong>, {site.firma.adres}, номер плательщика НДС (NIP): {site.firma.nip}, регистрационный
            номер (REGON): {site.firma.regon}. По вопросам защиты данных обращайтесь на{" "}
            <a href={`mailto:${site.kontakt.email}`}>{site.kontakt.email}</a>.
          </p>

          <h2>Цели и правовые основания обработки</h2>
          <p>Мы обрабатываем персональные данные для следующих целей:</p>
          <ul>
            <li>
              <strong>Обработка корреспонденции и запросов</strong> (контактная форма, электронная почта) — правовое
              основание: ст. 6(1)(b) GDPR (действия, предшествующие заключению договора / ответ на запрос) или ст.
              6(1)(f) GDPR (законный интерес в предоставлении ответа).
            </li>
            <li>
              <strong>Обработка претензий и сервисных запросов</strong> — правовое основание: ст. 6(1)(c) GDPR
              (правовое обязательство, вытекающее из положений о гарантии) и ст. 6(1)(b) GDPR.
            </li>
            <li>
              <strong>Статистика посещений сайта</strong> (Google Analytics) — только после согласия, данного в
              баннере cookie, правовое основание: ст. 6(1)(a) GDPR. Подробности в{" "}
              <a href={l("/cookies")}>политике использования cookie</a>.
            </li>
            <li>
              <strong>Обеспечение безопасности и корректной работы сайта</strong> (журналы сервера хостинга) —
              правовое основание: ст. 6(1)(f) GDPR (законный интерес оператора).
            </li>
          </ul>
          <p>Мы не профилируем пользователей и не принимаем в отношении них автоматизированных решений, влекущих правовые последствия.</p>

          <h2>Срок хранения данных</h2>
          <ul>
            <li>Данные корреспонденции и запросов — в течение 3 лет с момента завершения дела (срок давности по требованиям).</li>
            <li>
              Данные, связанные с претензией или гарантийным обращением, — в течение времени, необходимого для его
              разрешения, а затем в течение срока давности по требованиям.
            </li>
            <li>Данные, вытекающие из налогового и бухгалтерского законодательства, — в течение срока, установленного этим законодательством.</li>
            <li>Файлы cookie — согласно <a href={l("/cookies")}>политике использования cookie</a>.</li>
          </ul>

          <h2>Получатели данных</h2>
          <p>Данные могут передаваться следующим категориям получателей:</p>
          <ul>
            <li>
              <strong>Cloudflare</strong> — поставщик инфраструктуры хостинга и CDN для данного сайта.
            </li>
            <li>
              <strong>Google</strong> — поставщик инструмента Google Analytics, используемого только после согласия
              на аналитические cookie.
            </li>
            <li>
              <strong>nazwa.pl</strong> — поставщик услуг хостинга и электронной почты, через который мы обрабатываем
              корреспонденцию и запросы клиентов.
            </li>
          </ul>
          <p>
            Некоторые из перечисленных выше поставщиков могут обрабатывать данные за пределами Европейской
            экономической зоны. В таких случаях передача данных осуществляется на основании стандартных договорных
            условий, утверждённых Европейской комиссией, или иного механизма, соответствующего GDPR.
          </p>

          <h2>Права субъектов данных</h2>
          <p>Вы имеете право:</p>
          <ul>
            <li>на доступ к своим данным и получение их копии,</li>
            <li>на исправление (корректировку) своих данных,</li>
            <li>на удаление своих данных,</li>
            <li>на ограничение обработки,</li>
            <li>на переносимость данных,</li>
            <li>возражать против обработки, основанной на ст. 6(1)(f) GDPR,</li>
            <li>отозвать согласие в любой момент без ущерба для законности обработки, осуществлённой до его отзыва,</li>
            <li>
              подать жалобу Председателю Управления по защите персональных данных Польши (UODO), если вы считаете,
              что обработка нарушает положения GDPR.
            </li>
          </ul>

          <h2>Контакт</h2>
          <p>
            По вопросам, связанным с обработкой персональных данных, вы можете связаться с нами на{" "}
            <a href={`mailto:${site.kontakt.email}`}>{site.kontakt.email}</a>.
          </p>
        </Prose>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-12);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }
</style>
