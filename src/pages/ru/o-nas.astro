---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import { site } from "../../data/site.ts";
import lifestyleCzajnik from "../../assets/marka/lifestyle-czajnik.png";
import lifestyleBlender from "../../assets/marka/lifestyle-blender.png";
import lifestyleStrzyzarka from "../../assets/marka/lifestyle-strzyzarka.png";
import magazyn from "../../assets/marka/magazyn.jpg";

const l = (sciezka: string) => getRelativeLocaleUrl("ru", sciezka);

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "О нас", path: l("/o-nas") },
];

const zdjecia = [
  { src: lifestyleCzajnik, alt: "Чайник Owell OW 1360 в повседневном использовании на кухне" },
  { src: lifestyleBlender, alt: "Погружной блендер Owell OW 4634 готовит смузи" },
  { src: lifestyleStrzyzarka, alt: "Машинка Owell OW 2859 подстригает собаку" },
];

const cyklSekund = 5;
const totalDuration = zdjecia.length * cyklSekund;
const segmentPct = 100 / zdjecia.length;
const fadeInPct = Math.min(2, segmentPct * 0.15);
const holdEndPct = segmentPct - fadeInPct;

const visualKeyframes = `
  @keyframes o-nas-carousel {
    0% { opacity: 0; }
    ${fadeInPct.toFixed(3)}% { opacity: 1; }
    ${holdEndPct.toFixed(3)}% { opacity: 1; }
    ${segmentPct.toFixed(3)}% { opacity: 0; }
    100% { opacity: 0; }
  }
`;
---

<Base
  title="О нас — Owell"
  description="Owell разрабатывает бытовую технику для повседневного использования. Узнайте, откуда мы, во что верим и как работаем."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <!-- Opis filmu dla Google (VideoObject) — bez tego Search Console zgłaszał
       stronę jako „film niezindeksowany". -->
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"VideoObject","name":"Прогулка по логистическому центру Owell","description":"Минута в логистическом центре Owell: приёмка товара, высотные стеллажи и паллеты, готовые к отправке.","thumbnailUrl":"https://owelleurope.pl/video/owell-magazyn-poster.jpg","uploadDate":"2026-10-11","duration":"PT1M","contentUrl":"https://owelleurope.pl/video/owell-magazyn.mp4","inLanguage":"ru"})} />
  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title" data-reveal>О нас</h1>

        <div class="visual" style={`--visual-cykl: ${totalDuration}s`}>
          {zdjecia.map((zdjecie, i) => (
            <Image
              src={zdjecie.src}
              alt={zdjecie.alt}
              width={1600}
              height={893}
              class="visual-img"
              style={`animation-delay: ${i * cyklSekund}s`}
            />
          ))}

          <div class="visual-overlay">
            <div class="visual-text">
              <p>
                Owell — это более {site.grupa.lataHistorii} лет опыта в производстве бытовой техники,
                присутствующей на польском рынке с {site.grupa.odRokuWPolsce} года. Мы уже выпустили более{" "}
                {site.grupa.liczbaProduktow} моделей, продающихся более чем в {site.grupa.liczbaKrajow} странах. Каждый
                продукт Owell проходит строгий контроль качества и сопровождается полной документацией о соответствии
                требованиям безопасности ЕС (GPSR) — подробности и данные производителя доступны на странице{" "}
                <a href={l("/bezpieczenstwo-produktu")}>безопасности продукции</a>.
              </p>

              <p>
                Мы считаем, что бытовой технике не нужно быть громкой, чтобы быть хорошей. Мы предпочитаем одно
                продуманное решение десяти функциям, которыми вы воспользуетесь один раз. Поэтому каждый продукт
                проходит одни и те же вопросы: действительно ли он облегчает повседневную жизнь, выдержит ли он
                регулярное использование, и если что-то пойдёт не так — можно ли сообщить об этом без бесконечных
                переключений между операторами колл-центра.
              </p>

              <p>
                Мы продаём онлайн, без сети физических магазинов — сегодня через наш официальный магазин на Allegro,
                где мы выступаем напрямую как производитель. Заказы, оформленные до 18:30, отправляются в тот же
                день, с гарантированной доставкой InPost. Каждый продукт поставляется с картой GPSR с полными
                данными производителя и гарантией {site.gwarancjaMiesiace} месяцев — без исключений и мелкого шрифта.
              </p>
            </div>
          </div>
        </div>
      </Container>
    </Section>
    <Section bg="raised">
      <Container>
        <div class="zaplecze">
          <Image
            src={magazyn}
            alt="Логистический центр Owell с высоты птичьего полёта"
            width={1740}
            height={742}
            class="zaplecze-img"
          />

          <div class="zaplecze-overlay">
            <div class="zaplecze-text">
            <p class="zaplecze-eyebrow" data-reveal>Инфраструктура</p>
            <h2 class="zaplecze-tytul" data-reveal data-reveal-delay="80">Собственный логистический центр</h2>
            <p class="zaplecze-opis" data-reveal data-reveal-delay="160">
              30 000 м² под одной крышей — от приёмки товара через хранение до упаковки и отправки. Благодаря собственному центру мы контролируем весь процесс: заказы, оформленные до 18:30, отправляем в тот же день, а наличие на складе проверяем в реальном времени — поэтому никогда не обещаем доступность товара, которого на самом деле нет на полке.
            </p>
            </div>
          </div>
        </div>

        <!-- Film 1:00 z dźwiękiem, ok. 20 MB: preload="none" — pobiera się dopiero
             po kliknięciu, więc nie spowalnia wejścia na stronę. Źródło (100 MB)
             leży w wideo-zrodlo/ poza repo. -->
        <figure class="zaplecze-wideo" id="film" data-reveal>
          <video
            controls
            preload="none"
            playsinline
            poster="/video/owell-magazyn-poster.jpg"
            width="1920"
            height="1080"
            aria-label="Видео: прогулка по логистическому центру Owell"
          >
            <source src="/video/owell-magazyn.mp4" type="video/mp4" />
          </video>
          <figcaption>Наш логистический центр изнутри — 1 минута, со звуком.</figcaption>
        </figure>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style set:html={visualKeyframes} is:global></style>

<style>
  .zaplecze-wideo {
    margin-top: var(--sp-8);
    /* Kotwica #film (karta na stronie głównej) — nie chowaj filmu pod nagłówkiem. */
    scroll-margin-top: calc(var(--header-h, 65px) + var(--sp-6));
  }

  .zaplecze-wideo video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background-color: var(--bg-0);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
  }

  .zaplecze-wideo figcaption {
    margin-top: var(--sp-3);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .page-title {
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-12);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .visual {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid var(--hairline);
    overflow: hidden;
  }

  .visual-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .visual-img:not(:first-of-type) {
    display: none;
  }

  .visual-overlay {
    padding: var(--sp-8);
    background-color: var(--bg-0);
  }

  .visual-text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .visual-text a {
    color: var(--gold);
    text-underline-offset: 0.2em;
  }

  .visual-text a:hover {
    color: var(--gold-bright);
  }

  @media (min-width: 960px) {
    .visual {
      min-height: 26rem;
    }

    .visual-img,
    .visual-img:not(:first-of-type) {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      animation: o-nas-carousel var(--visual-cykl) ease-in-out infinite;
    }

    .visual-overlay {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 100%;
      padding: var(--sp-16);
      background: linear-gradient(
        to right,
        var(--bg-0) 0%,
        var(--bg-0) 42%,
        transparent 78%
      );
      transition: opacity 900ms var(--ease);
    }

    .visual-text {
      max-width: 30rem;
    }

    .zaplecze {
      min-height: 26rem;
    }

    .zaplecze-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .zaplecze-overlay {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 100%;
      padding: var(--sp-16);
      background: linear-gradient(
        to right,
        var(--bg-0) 0%,
        var(--bg-0) 42%,
        transparent 78%
      );
    }

    .zaplecze-text {
      max-width: 30rem;
    }

    .visual:hover .visual-overlay {
      opacity: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .visual-img {
        animation: none !important;
        opacity: 0;
      }

      .visual-img:first-of-type {
        opacity: 1;
      }
    }
  }
  .zaplecze {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid var(--hairline);
    overflow: hidden;
  }

  .zaplecze-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .zaplecze-overlay {
    padding: var(--sp-8);
    background-color: var(--bg-0);
  }

  .zaplecze-text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .zaplecze-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .zaplecze-tytul {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .zaplecze-opis {
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--text-2);
  }
</style>
