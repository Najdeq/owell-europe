---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import { site } from "../../data/site.ts";
import lifestyleCzajnik from "../../assets/marka/lifestyle-czajnik.png";
import lifestyleBlender from "../../assets/marka/lifestyle-blender.png";
import lifestyleStrzyzarka from "../../assets/marka/lifestyle-strzyzarka.png";

const l = (sciezka: string) => getRelativeLocaleUrl("ru", sciezka);

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "О нас", path: l("/o-nas") },
];

const zdjecia = [
  { src: lifestyleCzajnik, alt: "Чайник Owell OW 1360 в повседневном использовании на кухне" },
  { src: lifestyleBlender, alt: "Погружной блендер Owell OW 4634 готовит смузи" },
  { src: lifestyleStrzyzarka, alt: "Машинка Owell OW 2859 подстригает собаку" },
];

const cyklSekund = 5;
const totalDuration = zdjecia.length * cyklSekund;
const segmentPct = 100 / zdjecia.length;
const fadeInPct = Math.min(2, segmentPct * 0.15);
const holdEndPct = segmentPct - fadeInPct;

const visualKeyframes = `
  @keyframes o-nas-carousel {
    0% { opacity: 0; }
    ${fadeInPct.toFixed(3)}% { opacity: 1; }
    ${holdEndPct.toFixed(3)}% { opacity: 1; }
    ${segmentPct.toFixed(3)}% { opacity: 0; }
    100% { opacity: 0; }
  }
`;
---

<Base
  title="О нас — Owell"
  description="Owell разрабатывает бытовую технику для повседневного использования. Узнайте, откуда мы, во что верим и как работаем."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title" data-reveal>О нас</h1>

        <div class="visual" style={`--visual-cykl: ${totalDuration}s`}>
          {zdjecia.map((zdjecie, i) => (
            <Image
              src={zdjecie.src}
              alt={zdjecie.alt}
              width={1600}
              height={893}
              class="visual-img"
              style={`animation-delay: ${i * cyklSekund}s`}
            />
          ))}

          <div class="visual-overlay">
            <div class="visual-text">
              <p>
                Owell — это более {site.grupa.lataHistorii} лет опыта в производстве бытовой техники,
                присутствующей на польском рынке с {site.grupa.odRokuWPolsce} года. Мы уже выпустили более{" "}
                {site.grupa.liczbaProduktow} моделей, продающихся более чем в {site.grupa.liczbaKrajow} странах. Каждый
                продукт Owell проходит строгий контроль качества и сопровождается полной документацией о соответствии
                требованиям безопасности ЕС (GPSR) — подробности и данные производителя доступны на странице{" "}
                <a href={l("/bezpieczenstwo-produktu")}>безопасности продукции</a>.
              </p>

              <p>
                Мы считаем, что бытовой технике не нужно быть громкой, чтобы быть хорошей. Мы предпочитаем одно
                продуманное решение десяти функциям, которыми вы воспользуетесь один раз. Поэтому каждый продукт
                проходит одни и те же вопросы: действительно ли он облегчает повседневную жизнь, выдержит ли он
                регулярное использование, и если что-то пойдёт не так — можно ли сообщить об этом без бесконечных
                переключений между операторами колл-центра.
              </p>

              <p>
                Мы продаём онлайн, без сети физических магазинов — сегодня через наш официальный магазин на Allegro,
                где мы выступаем напрямую как производитель. Заказы, оформленные до 18:30, отправляются в тот же
                день, с гарантированной доставкой InPost. Каждый продукт поставляется с картой GPSR с полными
                данными производителя и гарантией {site.gwarancjaMiesiace} месяцев — без исключений и мелкого шрифта.
              </p>
            </div>
          </div>
        </div>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style set:html={visualKeyframes} is:global></style>

<style>
  .page-title {
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-12);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .visual {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid var(--hairline);
    overflow: hidden;
  }

  .visual-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .visual-img:not(:first-of-type) {
    display: none;
  }

  .visual-overlay {
    padding: var(--sp-8);
    background-color: var(--bg-0);
  }

  .visual-text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .visual-text a {
    color: var(--gold);
    text-underline-offset: 0.2em;
  }

  .visual-text a:hover {
    color: var(--gold-bright);
  }

  @media (min-width: 960px) {
    .visual {
      min-height: 26rem;
    }

    .visual-img,
    .visual-img:not(:first-of-type) {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      animation: o-nas-carousel var(--visual-cykl) ease-in-out infinite;
    }

    .visual-overlay {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 100%;
      padding: var(--sp-16);
      background: linear-gradient(
        to right,
        var(--bg-0) 0%,
        var(--bg-0) 42%,
        transparent 78%
      );
      transition: opacity 900ms var(--ease);
    }

    .visual-text {
      max-width: 30rem;
    }

    .visual:hover .visual-overlay {
      opacity: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .visual-img {
        animation: none !important;
        opacity: 0;
      }

      .visual-img:first-of-type {
        opacity: 1;
      }
    }
  }
</style>
