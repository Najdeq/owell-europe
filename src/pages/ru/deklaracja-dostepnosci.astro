---
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Prose from "../../components/ui/Prose.astro";
import { site } from "../../data/site.ts";

const l = (sciezka: string) => getRelativeLocaleUrl("ru", sciezka);

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "Заявление о доступности", path: l("/deklaracja-dostepnosci") },
];
---

<Base
  title="Заявление о доступности — Owell"
  description="Заявление о доступности сайта Owell: заявленный уровень соответствия WCAG 2.2 AA, метод оценки и известные ограничения."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title">Заявление о доступности</h1>

        <Prose>
          <p>
            {site.firma.nazwaPelna} стремится сделать сайт Owell доступным для максимально широкого круга
            пользователей, включая людей с ограниченными возможностями, в соответствии с польским Законом от 4
            апреля 2019 года о цифровой доступности сайтов и мобильных приложений государственных органов и
            Европейским актом о доступности (EAA).
          </p>

          <h2>Статус соответствия</h2>
          <p>
            Сайт <strong>частично соответствует</strong> стандарту{" "}
            <strong>WCAG 2.2 уровня AA</strong>. Мы стремимся к полному соответствию и рассматриваем доступность как
            требование к дизайну, а не как второстепенную задачу.
          </p>

          <h2>Дата подготовки и метод оценки</h2>
          <p>Настоящее заявление подготовлено 7 августа 2026 года.</p>
          <p>
            Соответствие было оценено методом <strong>самооценки</strong> — оценка проведена внутренними силами
            команды, ответственной за сайт, без привлечения внешнего аудитора.
          </p>

          <h2>Известные ограничения</h2>
          <p>Мы хотим честно указать области, которые ещё не полностью готовы на дату этого заявления:</p>
          <ul>
            <li>Некоторые страницы, указанные в меню и подвале сайта, в настоящее время находятся в разработке и могут возвращать ошибку 404.</li>
            <li>Цифровая доступность PDF-инструкций, прилагаемых к страницам продуктов, пока не проверена.</li>
          </ul>
          <p>Помимо перечисленного выше, других известных ограничений доступности на дату этого заявления не выявлено.</p>

          <h2>Обратная связь и процедура обжалования</h2>
          <p>
            Если вы столкнулись с проблемой доступности на сайте — например, элементом, с которым нельзя
            взаимодействовать с клавиатуры, отсутствующим описанием изображения или недостаточным контрастом —
            сообщите нам об этом. Вы вправе потребовать, чтобы сайт или конкретный элемент были сделаны цифрово
            доступными. Если мы не ответим в установленный законом срок, или если отказ в обеспечении доступности
            необоснован, вы вправе подать жалобу в надзорный орган, а затем — Уполномоченному по правам человека
            Польши (Rzecznik Praw Obywatelskich).
          </p>

          <h2>Контакт</h2>
          <p>
            Сообщайте о проблемах доступности на <a href={`mailto:${site.kontakt.email}`}>{site.kontakt.email}</a>.
            Мы приложим все усилия, чтобы ответить и как можно быстрее устранить указанную проблему.
          </p>
        </Prose>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-12);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }
</style>
