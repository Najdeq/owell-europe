---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import { site } from "../data/site.ts";

const breadcrumbs = [
  { name: "Owell", path: "/" },
  { name: "Rejestracja produktu", path: "/rejestracja-produktu" },
];

const razem = site.gwarancjaMiesiace + site.gwarancjaPlus.dodatkoweMiesiace;

const kroki = [
  {
    tytul: "Znajdź numer modelu",
    opis: "Jest na tabliczce znamionowej urządzenia i na pudełku — zaczyna się od „OW”, na przykład OW 3300.",
  },
  {
    tytul: "Przygotuj dowód zakupu",
    opis: "Paragon albo potwierdzenie zamówienia. Wystarczy zdjęcie telefonem.",
  },
  {
    tytul: "Wyślij do nas",
    opis: `Napisz na WhatsApp lub mailem w ciągu ${site.gwarancjaPlus.terminDni} dni od zakupu. Potwierdzimy rejestrację i od tej chwili obowiązuje ${razem} miesięcy gwarancji.`,
  },
];

// Treść wiadomości wstawiamy w link, żeby klient nie musiał się zastanawiać,
// co napisać — otwiera czat z gotowym szkieletem zgłoszenia.
const wiadomosc = encodeURIComponent(
  "Dzień dobry, chcę zarejestrować produkt Owell i przedłużyć gwarancję.\n\n" +
    "Model: \n" +
    "Data zakupu: \n" +
    "Gdzie kupiony: \n\n" +
    "(w załączeniu zdjęcie dowodu zakupu)"
);
---

<Base
  title={`Rejestracja produktu — ${razem} miesięcy gwarancji — Owell`}
  description={`Zarejestruj produkt Owell w ciągu ${site.gwarancjaPlus.terminDni} dni od zakupu i przedłuż gwarancję z ${site.gwarancjaMiesiace} do ${razem} miesięcy. Bez opłat.`}
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <Eyebrow data-reveal>Rejestracja produktu</Eyebrow>
        <h1 class="page-title" data-reveal data-reveal-delay="80">
          Zarejestruj produkt i zyskaj rok gwarancji więcej
        </h1>
        <p class="page-lead" data-reveal data-reveal-delay="160">
          Standardowo dajemy {site.gwarancjaMiesiace} miesiące. Zarejestruj urządzenie w ciągu{" "}
          {site.gwarancjaPlus.terminDni} dni od zakupu, a wydłużymy je do {razem} miesięcy. Bezpłatnie i bez
          drobnego druku.
        </p>

        <div class="licznik" data-reveal data-reveal-delay="240">
          <div class="licznik-czlon">
            <span class="licznik-liczba">{site.gwarancjaMiesiace}</span>
            <span class="licznik-opis">miesiące standardowo</span>
          </div>
          <span class="licznik-znak" aria-hidden="true">+</span>
          <div class="licznik-czlon">
            <span class="licznik-liczba">{site.gwarancjaPlus.dodatkoweMiesiace}</span>
            <span class="licznik-opis">za rejestrację</span>
          </div>
          <span class="licznik-znak" aria-hidden="true">=</span>
          <div class="licznik-czlon licznik-czlon--suma">
            <span class="licznik-liczba">{razem}</span>
            <span class="licznik-opis">miesięcy ochrony</span>
          </div>
        </div>

        <ol class="kroki">
          {kroki.map((k, i) => (
            <li class="krok">
              <span class="krok-numer">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h2 class="krok-tytul">{k.tytul}</h2>
                <p class="krok-opis">{k.opis}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="cta">
          <Button
            href={`https://wa.me/${site.kontakt.whatsappWa}?text=${wiadomosc}`}
            variant="primary"
            external
            data-marketplace="whatsapp"
            data-platforma="WhatsApp"
            data-lokalizacja="rejestracja-produktu"
          >
            Zarejestruj na WhatsApp
          </Button>
          <Button href={`mailto:${site.kontakt.emailSerwis}?subject=Rejestracja produktu Owell`} variant="ghost">
            Zarejestruj mailem
          </Button>
        </div>

        <div class="warunki">
          <h2 class="warunki-tytul">Warunki</h2>
          <ul>
            <li>
              Rejestracja jest bezpłatna i dobrowolna. Bez niej obowiązuje standardowa gwarancja{" "}
              {site.gwarancjaMiesiace} miesięcy.
            </li>
            <li>
              Zgłoszenie trzeba wysłać w ciągu {site.gwarancjaPlus.terminDni} dni od daty zakupu widniejącej na
              dowodzie zakupu.
            </li>
            <li>
              Przedłużenie obejmuje te same wady co gwarancja podstawowa — materiałowe i produkcyjne. Nie obejmuje
              uszkodzeń mechanicznych ani zużycia elementów eksploatacyjnych, takich jak ostrza czy akumulatory.
            </li>
            <li>
              Rejestracja nie ogranicza Twoich uprawnień ustawowych z tytułu rękojmi ani praw konsumenta.
            </li>
            <li>
              Dane ze zgłoszenia wykorzystujemy wyłącznie do obsługi gwarancji — szczegóły w{" "}
              <a href="/polityka-prywatnosci">polityce prywatności</a>.
            </li>
          </ul>
        </div>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-3);
    max-width: var(--maxw-prose);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .page-lead {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .licznik {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-6);
    margin-top: var(--sp-12);
    padding: var(--sp-8);
    background-color: var(--bg-1);
    border: 1px solid var(--gold);
    border-radius: var(--radius-lg);
  }

  .licznik-czlon {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .licznik-liczba {
    font-family: var(--font-mono);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1;
    color: var(--text-2);
  }

  .licznik-czlon--suma .licznik-liczba {
    color: var(--gold-bright);
  }

  .licznik-opis {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .licznik-znak {
    font-family: var(--font-mono);
    font-size: var(--fs-h3);
    color: var(--steel);
  }

  .kroki {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
    margin-top: var(--sp-12);
    list-style: none;
  }

  .krok {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .krok-numer {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--gold);
  }

  .krok-tytul {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--text);
  }

  .krok-opis {
    margin-top: var(--sp-2);
    max-width: 46ch;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-12);
  }

  .warunki {
    max-width: var(--maxw-prose);
    margin-top: var(--sp-16);
    padding-top: var(--sp-8);
    border-top: 1px solid var(--hairline-soft);
  }

  .warunki-tytul {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .warunki ul {
    margin-top: var(--sp-4);
    padding-left: var(--sp-5);
  }

  .warunki li {
    margin-bottom: var(--sp-3);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .warunki a {
    color: var(--gold);
  }

  .warunki a:hover {
    color: var(--gold-bright);
  }

  @media (min-width: 720px) {
    .kroki {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-8);
    }

    .krok {
      flex-direction: column;
      gap: var(--sp-3);
    }
  }
</style>
