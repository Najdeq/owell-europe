---
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Prose from "../../components/ui/Prose.astro";
import { site } from "../../data/site.ts";

const l = (sciezka: string) => getRelativeLocaleUrl("en", sciezka);

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "Product safety", path: l("/bezpieczenstwo-produktu") },
];
---

<Base
  title="Product safety — Owell"
  description="Manufacturer data required by the GPSR Regulation (EU) 2023/988, how to report a product safety issue, and information about service actions."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title">Product safety</h1>

        <Prose>
          <p>
            This page contains the information required by Regulation (EU) 2023/988 of the European Parliament and
            of the Council on general product safety (GPSR).
          </p>

          <h2>Entity responsible for this website</h2>
          <p>
            <strong>{site.firma.nazwaPelna}</strong><br />
            {site.firma.adres}<br />
            VAT ID (NIP): {site.firma.nip} · Company registry number (REGON): {site.firma.regon}<br />
            Email for product safety matters: <a href={`mailto:${site.kontakt.emailGpsr}`}>{site.kontakt.emailGpsr}</a>
          </p>

          <h2>Manufacturer data for individual products</h2>
          <p>The manufacturer of every product in our range is Adler Sp. z o.o., ul. Ordona 2A, 01-237 Warszawa, Poland (email: gpsr@adlereurope.eu); as the manufacturer is based in the European Union, none of the products require an EU responsible person.</p>

          <h2>How to report a safety issue</h2>
          <p>
            If you suspect that one of our products poses a risk to health or safety, write to{" "}
            <a href={`mailto:${site.kontakt.emailGpsr}`}>{site.kontakt.emailGpsr}</a>. In your report, please
            include:
          </p>
          <ul>
            <li>the product name and model (e.g. from the label or the product card on this website),</li>
            <li>a description of the issue you observed,</li>
            <li>photos of the issue, if possible,</li>
            <li>your contact details, so we can get back to you.</li>
          </ul>
          <p>
            If a product poses a serious risk, the manufacturer and distributors are required to report this fact
            to the relevant market surveillance authorities (in Poland, among others, UOKiK) via the EU Safety Gate
            system.
          </p>

          <h2>Service actions and product recalls</h2>
          <p>
            As of the date of this notice (7 August 2026), Owell is not carrying out any service actions or
            product recalls. If this changes, this information will be updated here promptly.
          </p>
        </Prose>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-12);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

</style>