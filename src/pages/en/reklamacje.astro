---
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Prose from "../../components/ui/Prose.astro";
import { site } from "../../data/site.ts";

const l = (sciezka: string) => getRelativeLocaleUrl("en", sciezka);

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "Complaints", path: l("/reklamacje") },
];

const kroki = [
  "Write to our service address, including the product model and order number.",
  "Describe the fault — photos or a short video speed up the process.",
  "We reply within 24 business hours with next steps (repair, replacement or refund).",
];
---

<Base
  title="Complaints — Owell"
  description="How to file a complaint about an Owell product — step by step, with no call centre."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title" data-reveal>Complaints</h1>
        <p class="page-lead" data-reveal data-reveal-delay="80">
          We handle complaints by email, directly — no call centre and no being transferred between departments.
        </p>

        <ol class="kroki">
          {kroki.map((krok, i) => (
            <li>
              <span class="krok-numer">{i + 1}</span>
              <span class="krok-tekst">{krok}</span>
            </li>
          ))}
        </ol>

        <Prose>
          <p>
            Service address: <a href={`mailto:${site.kontakt.emailSerwis}`}>{site.kontakt.emailSerwis}</a>. We
            handle complaints in line with the terms described on the{" "}
            <a href={l("/gwarancja")}>warranty</a> page.
          </p>
        </Prose>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-4);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .page-lead {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-size: var(--fs-lead);
    color: var(--text-2);
  }

  .kroki {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    max-width: var(--maxw-prose);
    margin-top: var(--sp-10);
    margin-bottom: var(--sp-10);
    list-style: none;
  }

  .kroki li {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .krok-numer {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--gold-bright);
  }

  .krok-tekst {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }
</style>