---
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Prose from "../../components/ui/Prose.astro";

const l = (sciezka: string) => getRelativeLocaleUrl("en", sciezka);

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "Cookies", path: l("/cookies") },
];

const kategorie = [
  {
    nazwa: "Necessary",
    opis: "Required for the website to work correctly and to remember your consent choices. These cannot be disabled.",
    cookies: [
      {
        nazwa: "owell-consent (localStorage)",
        dostawca: "Owell (first-party)",
        cel: "Remembers your consent decision for analytics and marketing cookies.",
        czas: "No expiry — until manually cleared or settings are changed.",
      },
    ],
  },
  {
    nazwa: "Analytics",
    opis: "Help us understand how visitors use the website. Loaded only after consent is given (Consent Mode v2).",
    cookies: [
      {
        nazwa: "_ga",
        dostawca: "Google (Google Analytics 4)",
        cel: "Distinguishes unique users.",
        czas: "13 months",
      },
      {
        nazwa: "_ga_&lt;identifier&gt;",
        dostawca: "Google (Google Analytics 4)",
        cel: "Maintains session state and collects visit statistics.",
        czas: "13 months",
      },
    ],
  },
  {
    nazwa: "Marketing",
    opis: "We do not currently use marketing cookies. This section will be updated if that changes.",
    cookies: [],
  },
];
---

<Base
  title="Cookie policy — Owell"
  description="Which cookies we use on the Owell website, for what purpose, and for how long they are stored."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title">Cookie policy</h1>

        <Prose>
          <p>
            This website uses cookies. Necessary cookies are always loaded; other categories only after you give
            consent in the banner shown on your first visit. You can change your consent at any time.
          </p>

          <button type="button" class="zmien-ustawienia" data-open-consent-settings>
            Change cookie settings
          </button>

          {kategorie.map((kategoria) => (
            <>
              <h2>{kategoria.nazwa}</h2>
              <p>{kategoria.opis}</p>

              {kategoria.cookies.length > 0 && (
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Provider</th>
                        <th scope="col">Purpose</th>
                        <th scope="col">Lifetime</th>
                      </tr>
                    </thead>
                    <tbody>
                      {kategoria.cookies.map((cookie) => (
                        <tr>
                          <td data-label="Name" set:html={cookie.nazwa} />
                          <td data-label="Provider">{cookie.dostawca}</td>
                          <td data-label="Purpose">{cookie.cel}</td>
                          <td data-label="Lifetime">{cookie.czas}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </>
          ))}
        </Prose>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-12);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .zmien-ustawienia {
    display: inline-flex;
    align-items: center;
    padding: var(--sp-3) var(--sp-6);
    margin-block: var(--sp-2) var(--sp-8);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text);
    background-color: transparent;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .zmien-ustawienia:hover {
    border-color: var(--gold);
    color: var(--gold-bright);
  }

  .table-wrap {
    margin-bottom: var(--sp-8);
    overflow-x: auto;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius);
  }

  table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: var(--fs-small);
  }

  th {
    padding: var(--sp-3) var(--sp-4);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
    text-align: left;
    background-color: var(--bg-2);
    white-space: nowrap;
  }

  td {
    padding: var(--sp-3) var(--sp-4);
    color: var(--text-2);
    border-top: 1px solid var(--hairline-soft);
    vertical-align: top;
  }

  td:first-child {
    font-family: var(--font-mono);
    color: var(--text);
    white-space: nowrap;
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>(
    "[data-open-consent-settings]"
  );

  button?.addEventListener("click", () => {
    const openConsentSettings = (
      window as unknown as { openConsentSettings?: () => void }
    ).openConsentSettings;

    if (typeof openConsentSettings === "function") {
      openConsentSettings();
    }
  });
</script>