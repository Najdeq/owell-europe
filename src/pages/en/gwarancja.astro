---
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Prose from "../../components/ui/Prose.astro";
import { site } from "../../data/site.ts";

const l = (sciezka: string) => getRelativeLocaleUrl("en", sciezka);

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "Warranty", path: l("/gwarancja") },
];
---

<Base
  title="Warranty — Owell"
  description={`Every Owell product comes with a ${site.gwarancjaMiesiace}-month warranty. See what it covers and how to request a repair.`}
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title" data-reveal>Warranty card</h1>

        <Prose>
          <h2>Warranty period</h2>
          <p>
            Every Owell product comes with a {site.gwarancjaMiesiace}-month warranty, counted from the date of
            purchase confirmed by proof of purchase (receipt or an online store invoice).
          </p>

          <h2>What the warranty covers</h2>
          <p>
            Material and manufacturing defects arising under normal conditions of use, in line with the user manual
            included with the product.
          </p>

          <h2>What the warranty does not cover</h2>
          <ul>
            <li>Mechanical damage caused by the user.</li>
            <li>Normal wear of consumable parts (e.g. blades, batteries).</li>
            <li>Faults resulting from use that does not comply with the user manual.</li>
          </ul>

          <h2>How to request a repair</h2>
          <p>
            Write to <a href={`mailto:${site.kontakt.emailSerwis}`}>{site.kontakt.emailSerwis}</a>, including the
            product model, order number and a description of the fault. Photos or a short video speed up the
            process. We handle requests by email, with no call centre.
          </p>
        </Prose>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-12);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }
</style>