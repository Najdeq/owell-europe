---
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Button from "../../components/ui/Button.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import { site } from "../../data/site.ts";

const l = (sciezka: string) => getRelativeLocaleUrl("en", sciezka);

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "Register your product", path: l("/rejestracja-produktu") },
];

const razem = site.gwarancjaMiesiace + site.gwarancjaPlus.dodatkoweMiesiace;

const kroki = [
  {
    tytul: "Find the model number",
    opis: `It's on the device's nameplate and on the box — it starts with "OW", for example OW 3300.`,
  },
  {
    tytul: "Prepare proof of purchase",
    opis: "A receipt or order confirmation. A photo taken on your phone is enough.",
  },
  {
    tytul: "Send it to us",
    opis: `Message us on WhatsApp or email within ${site.gwarancjaPlus.terminDni} days of purchase. We'll confirm the registration and from that moment the warranty runs for ${razem} months.`,
  },
];

const wiadomosc = encodeURIComponent(
  "Hello, I'd like to register my Owell product and extend the warranty.\n\n" +
    "Model: \n" +
    "Purchase date: \n" +
    "Purchased from: \n\n" +
    "(proof of purchase attached)"
);
---

<Base
  title={`Register your product — ${razem} months of warranty — Owell`}
  description={`Register your Owell product within ${site.gwarancjaPlus.terminDni} days of purchase and extend the warranty from ${site.gwarancjaMiesiace} to ${razem} months. Free of charge.`}
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <Eyebrow data-reveal>Product registration</Eyebrow>
        <h1 class="page-title" data-reveal data-reveal-delay="80">
          Register your product and get an extra year of warranty
        </h1>
        <p class="page-lead" data-reveal data-reveal-delay="160">
          We give you {site.gwarancjaMiesiace} months as standard. Register your device within{" "}
          {site.gwarancjaPlus.terminDni} days of purchase, and we'll extend it to {razem} months. Free of charge
          and with no fine print.
        </p>

        <div class="licznik" data-reveal data-reveal-delay="240">
          <div class="licznik-czlon">
            <span class="licznik-liczba">{site.gwarancjaMiesiace}</span>
            <span class="licznik-opis">months standard</span>
          </div>
          <span class="licznik-znak" aria-hidden="true">+</span>
          <div class="licznik-czlon">
            <span class="licznik-liczba">{site.gwarancjaPlus.dodatkoweMiesiace}</span>
            <span class="licznik-opis">for registering</span>
          </div>
          <span class="licznik-znak" aria-hidden="true">=</span>
          <div class="licznik-czlon licznik-czlon--suma">
            <span class="licznik-liczba">{razem}</span>
            <span class="licznik-opis">months of cover</span>
          </div>
        </div>

        <ol class="kroki">
          {kroki.map((k, i) => (
            <li class="krok">
              <span class="krok-numer">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h2 class="krok-tytul">{k.tytul}</h2>
                <p class="krok-opis">{k.opis}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="cta">
          <Button
            href={`https://wa.me/${site.kontakt.whatsappWa}?text=${wiadomosc}`}
            variant="primary"
            external
            data-marketplace="whatsapp"
            data-platforma="WhatsApp"
            data-lokalizacja="rejestracja-produktu"
          >
            Register on WhatsApp
          </Button>
          <Button href={`mailto:${site.kontakt.emailSerwis}?subject=Owell product registration`} variant="ghost">
            Register by email
          </Button>
        </div>

        <div class="warunki">
          <h2 class="warunki-tytul">Terms</h2>
          <ul>
            <li>
              Registration is free and optional. Without it, the standard {site.gwarancjaMiesiace}-month warranty
              applies.
            </li>
            <li>
              The request must be sent within {site.gwarancjaPlus.terminDni} days of the purchase date shown on
              your proof of purchase.
            </li>
            <li>
              The extension covers the same defects as the standard warranty — material and manufacturing. It does
              not cover mechanical damage or wear of consumable parts such as blades or batteries.
            </li>
            <li>
              Registration does not limit your statutory rights under warranty law or consumer protection.
            </li>
            <li>
              We use the data from your registration only to handle the warranty — details in the{" "}
              <a href={l("/polityka-prywatnosci")}>privacy policy</a>.
            </li>
          </ul>
        </div>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-3);
    max-width: var(--maxw-prose);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .page-lead {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .licznik {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-6);
    margin-top: var(--sp-12);
    padding: var(--sp-8);
    background-color: var(--bg-1);
    border: 1px solid var(--gold);
    border-radius: var(--radius-lg);
  }

  .licznik-czlon {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .licznik-liczba {
    font-family: var(--font-mono);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1;
    color: var(--text-2);
  }

  .licznik-czlon--suma .licznik-liczba {
    color: var(--gold-bright);
  }

  .licznik-opis {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .licznik-znak {
    font-family: var(--font-mono);
    font-size: var(--fs-h3);
    color: var(--steel);
  }

  .kroki {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
    margin-top: var(--sp-12);
    list-style: none;
  }

  .krok {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .krok-numer {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--gold);
  }

  .krok-tytul {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--text);
  }

  .krok-opis {
    margin-top: var(--sp-2);
    max-width: 46ch;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-12);
  }

  .warunki {
    max-width: var(--maxw-prose);
    margin-top: var(--sp-16);
    padding-top: var(--sp-8);
    border-top: 1px solid var(--hairline-soft);
  }

  .warunki-tytul {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .warunki ul {
    margin-top: var(--sp-4);
    padding-left: var(--sp-5);
  }

  .warunki li {
    margin-bottom: var(--sp-3);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .warunki a {
    color: var(--gold);
  }

  .warunki a:hover {
    color: var(--gold-bright);
  }

  @media (min-width: 720px) {
    .kroki {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-8);
    }

    .krok {
      flex-direction: column;
      gap: var(--sp-3);
    }
  }
</style>