---
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Button from "../../components/ui/Button.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import { site } from "../../data/site.ts";

const l = (sciezka: string) => getRelativeLocaleUrl("en", sciezka);

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "Register your product", path: l("/rejestracja-produktu") },
];

const kroki = [
  {
    tytul: "Find the model number",
    opis: `It's on the device's nameplate and on the box — it starts with "OW", for example OW 3300.`,
  },
  {
    tytul: "Prepare proof of purchase",
    opis: "A receipt or order confirmation. A photo taken on your phone is enough.",
  },
  {
    tytul: "Send it to us",
    opis: "Message us on WhatsApp or email with the model and purchase date. We'll confirm we've received it and keep the details on file.",
  },
];

const wiadomosc = encodeURIComponent(
  "Hello, I'd like to register my Owell product.\n\n" +
    "Model: \n" +
    "Purchase date: \n" +
    "Purchased from: \n\n" +
    "(proof of purchase attached)"
);
---

<Base
  title="Register your product — Owell"
  description="Register your Owell product — faster contact if you ever need service or a repair, free of charge."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <Eyebrow data-reveal>Product registration</Eyebrow>
        <h1 class="page-title" data-reveal data-reveal-delay="80">
          Register your Owell product
        </h1>
        <p class="page-lead" data-reveal data-reveal-delay="160">
          Save your purchase details with us — it makes handling any future repair or complaint faster, with no
          need to dig up your receipt again. Registration is free and doesn't change the terms of the standard,{" "}
          {site.gwarancjaMiesiace}-month warranty.
        </p>

        <ol class="kroki">
          {kroki.map((k, i) => (
            <li class="krok">
              <span class="krok-numer">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h2 class="krok-tytul">{k.tytul}</h2>
                <p class="krok-opis">{k.opis}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="cta">
          <Button
            href={`https://wa.me/${site.kontakt.whatsappWa}?text=${wiadomosc}`}
            variant="primary"
            external
            data-marketplace="whatsapp"
            data-platforma="WhatsApp"
            data-lokalizacja="rejestracja-produktu"
          >
            Register on WhatsApp
          </Button>
          <Button href={`mailto:${site.kontakt.emailSerwis}?subject=Owell product registration`} variant="ghost">
            Register by email
          </Button>
        </div>

        <div class="warunki">
          <h2 class="warunki-tytul">Terms</h2>
          <ul>
            <li>
              Registration is free and optional. It doesn't change the standard {site.gwarancjaMiesiace}-month
              warranty.
            </li>
            <li>
              Registration does not limit your statutory rights under warranty law or consumer protection.
            </li>
            <li>
              We use the data from your registration only to handle a future repair or complaint — details in the{" "}
              <a href={l("/polityka-prywatnosci")}>privacy policy</a>.
            </li>
          </ul>
        </div>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-3);
    max-width: var(--maxw-prose);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .page-lead {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .kroki {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
    margin-top: var(--sp-12);
    list-style: none;
  }

  .krok {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .krok-numer {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--gold);
  }

  .krok-tytul {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--text);
  }

  .krok-opis {
    margin-top: var(--sp-2);
    max-width: 46ch;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-12);
  }

  .warunki {
    max-width: var(--maxw-prose);
    margin-top: var(--sp-16);
    padding-top: var(--sp-8);
    border-top: 1px solid var(--hairline-soft);
  }

  .warunki-tytul {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .warunki ul {
    margin-top: var(--sp-4);
    padding-left: var(--sp-5);
  }

  .warunki li {
    margin-bottom: var(--sp-3);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .warunki a {
    color: var(--gold);
  }

  .warunki a:hover {
    color: var(--gold-bright);
  }

  @media (min-width: 720px) {
    .kroki {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-8);
    }

    .krok {
      flex-direction: column;
      gap: var(--sp-3);
    }
  }
</style>