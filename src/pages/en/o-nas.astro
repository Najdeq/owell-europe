---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import { site } from "../../data/site.ts";
import lifestyleCzajnik from "../../assets/marka/lifestyle-czajnik.png";
import lifestyleBlender from "../../assets/marka/lifestyle-blender.png";
import lifestyleStrzyzarka from "../../assets/marka/lifestyle-strzyzarka.png";
import magazyn from "../../assets/marka/magazyn.jpg";

const l = (sciezka: string) => getRelativeLocaleUrl("en", sciezka);

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "About us", path: l("/o-nas") },
];

const zdjecia = [
  { src: lifestyleCzajnik, alt: "Owell OW 1360 kettle in everyday use in the kitchen" },
  { src: lifestyleBlender, alt: "Owell OW 4634 hand blender preparing a smoothie" },
  { src: lifestyleStrzyzarka, alt: "Owell OW 2859 clipper grooming a dog" },
];

const cyklSekund = 5;
const totalDuration = zdjecia.length * cyklSekund;
const segmentPct = 100 / zdjecia.length;
const fadeInPct = Math.min(2, segmentPct * 0.15);
const holdEndPct = segmentPct - fadeInPct;

const visualKeyframes = `
  @keyframes o-nas-carousel {
    0% { opacity: 0; }
    ${fadeInPct.toFixed(3)}% { opacity: 1; }
    ${holdEndPct.toFixed(3)}% { opacity: 1; }
    ${segmentPct.toFixed(3)}% { opacity: 0; }
    100% { opacity: 0; }
  }
`;
---

<Base
  title="About us — Owell"
  description="Owell designs small appliances for everyday use. Find out where we come from, what we believe in, and how we work."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title" data-reveal>About us</h1>

        <div class="visual" style={`--visual-cykl: ${totalDuration}s`}>
          {zdjecia.map((zdjecie, i) => (
            <Image
              src={zdjecie.src}
              alt={zdjecie.alt}
              width={1600}
              height={893}
              class="visual-img"
              style={`animation-delay: ${i * cyklSekund}s`}
            />
          ))}

          <div class="visual-overlay">
            <div class="visual-text">
              <p>
                Owell brings over {site.grupa.lataHistorii} years of experience in manufacturing small appliances,
                present on the Polish market since {site.grupa.odRokuWPolsce}. We've already made over{" "}
                {site.grupa.liczbaProduktow} models sold in more than {site.grupa.liczbaKrajow} countries. Every
                Owell product goes through rigorous quality control procedures and comes with full compliance
                documentation for EU safety requirements (GPSR) — details and manufacturer data are available on
                our <a href={l("/bezpieczenstwo-produktu")}>product safety</a> page.
              </p>

              <p>
                We believe home appliances don't need to shout to be good. We'd rather have one well-thought-out
                solution than ten features you use once. That's why every product goes through the same questions:
                does it genuinely make everyday life easier, will it hold up to regular use, and if something goes
                wrong, can it be reported without being bounced between call centres.
              </p>

              <p>
                We sell online, with no network of physical stores — today through our official store on Allegro,
                where we appear directly as the manufacturer. Orders placed before 6:30 PM ship the same day, with
                guaranteed InPost delivery. Every product comes with a GPSR card with full manufacturer data and a{" "}
                {site.gwarancjaMiesiace}-month warranty — no exceptions, no fine print.
              </p>
            </div>
          </div>
        </div>
      </Container>
    </Section>
    <Section bg="raised">
      <Container>
        <div class="zaplecze">
          <div class="zaplecze-media">
            <Image
              src={magazyn}
              alt="Owell logistics centre, aerial view"
              width={1740}
              height={742}
              class="zaplecze-img"
            />
          </div>

          <div class="zaplecze-tekst">
            <p class="zaplecze-eyebrow" data-reveal>Facilities</p>
            <h2 class="zaplecze-tytul" data-reveal data-reveal-delay="80">Our own logistics centre</h2>
            <p class="zaplecze-opis" data-reveal data-reveal-delay="160">
              30,000 m² under one roof — from goods receiving, through storage, to packing and shipping. Our own facility means we control the whole process: orders placed before 6:30 PM ship the same day, and we track stock in real time, so we never promise a product we don't actually have on the shelf.
            </p>
          </div>
        </div>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style set:html={visualKeyframes} is:global></style>

<style>
  .page-title {
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-12);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .visual {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid var(--hairline);
    overflow: hidden;
  }

  .visual-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .visual-img:not(:first-of-type) {
    display: none;
  }

  .visual-overlay {
    padding: var(--sp-8);
    background-color: var(--bg-0);
  }

  .visual-text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .visual-text a {
    color: var(--gold);
    text-underline-offset: 0.2em;
  }

  .visual-text a:hover {
    color: var(--gold-bright);
  }

  @media (min-width: 960px) {
    .visual {
      min-height: 26rem;
    }

    .visual-img,
    .visual-img:not(:first-of-type) {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      animation: o-nas-carousel var(--visual-cykl) ease-in-out infinite;
    }

    .visual-overlay {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 100%;
      padding: var(--sp-16);
      background: linear-gradient(
        to right,
        var(--bg-0) 0%,
        var(--bg-0) 42%,
        transparent 78%
      );
      transition: opacity 900ms var(--ease);
    }

    .visual-text {
      max-width: 30rem;
    }

    .visual:hover .visual-overlay {
      opacity: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .visual-img {
        animation: none !important;
        opacity: 0;
      }

      .visual-img:first-of-type {
        opacity: 1;
      }
    }
  }
  .zaplecze {
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
  }

  .zaplecze-media {
    border-radius: var(--radius-lg);
    border: 1px solid var(--hairline);
    overflow: hidden;
  }

  .zaplecze-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .zaplecze-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .zaplecze-tytul {
    margin-top: var(--sp-3);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .zaplecze-opis {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--text-2);
  }
</style>