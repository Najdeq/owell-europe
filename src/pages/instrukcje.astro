---
import { existsSync, statSync } from "node:fs";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import WyszukiwarkaModelu from "../components/WyszukiwarkaModelu.astro";
import { site } from "../data/site.ts";

const breadcrumbs = [
  { name: "Owell", path: "/" },
  { name: "Instrukcje obsługi", path: "/instrukcje" },
];

const produkty = await getCollection("produkty");

// Listujemy tylko instrukcje, których plik faktycznie leży w public/ —
// nigdy nie linkujemy do 404. Wagę pliku podajemy przy linku, bo to
// kilkumegabajtowe PDF-y i użytkownik na komórce powinien wiedzieć,
// co pobiera.
const instrukcje = produkty
  .filter((p) => p.data.opublikowany)
  .map((p) => {
    const sciezka = p.data.instrukcjaPdf;
    if (!sciezka || !existsSync(`./public${sciezka}`)) return null;
    const mb = statSync(`./public${sciezka}`).size / (1024 * 1024);
    return {
      id: p.id,
      model: p.data.model,
      nazwa: p.data.nazwa,
      tagline: p.data.tagline,
      plik: sciezka,
      waga: `${mb.toFixed(1)} MB`,
    };
  })
  .filter((x) => x !== null)
  .sort((a, b) => a!.model.localeCompare(b!.model));
---

<Base
  title="Instrukcje obsługi — Owell"
  description="Pobierz instrukcję obsługi w formacie PDF dla swojego modelu Owell. Wszystkie instrukcje w jednym miejscu."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title" data-reveal>Instrukcje obsługi</h1>
        <p class="page-lead" data-reveal data-reveal-delay="80">
          Instrukcja w formacie PDF do każdego modelu z oferty. Numer modelu znajdziesz na tabliczce znamionowej
          urządzenia lub na pudełku.
        </p>

        <WyszukiwarkaModelu class="szukaj-na-instrukcjach" />

        {instrukcje.length > 0 ? (
          <ul class="lista">
            {instrukcje.map((i) => (
              <li class="pozycja">
                <div class="pozycja-opis">
                  <span class="pozycja-model">{i!.model}</span>
                  <a href={`/produkty/${i!.id}`} class="pozycja-nazwa">{i!.nazwa}</a>
                  <span class="pozycja-tagline">{i!.tagline}</span>
                </div>

                <a href={i!.plik} class="pozycja-pobierz" download>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M12 4v11m0 0 4-4m-4 4-4-4" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M4 17v2a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-2" stroke-linecap="round" />
                  </svg>
                  <span>PDF <span class="pozycja-waga">{i!.waga}</span></span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="brak">
            Instrukcje przygotowujemy do pobrania. Napisz na{" "}
            <a href={`mailto:${site.kontakt.emailSerwis}`}>{site.kontakt.emailSerwis}</a>, podając model — wyślemy
            plik mailem.
          </p>
        )}

        <p class="uwaga">
          Nie znalazłeś instrukcji do swojego modelu? Napisz na{" "}
          <a href={`mailto:${site.kontakt.emailSerwis}`}>{site.kontakt.emailSerwis}</a> — odpowiadamy w ciągu 24
          godzin roboczych.
        </p>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-4);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .page-lead {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-size: var(--fs-lead);
    color: var(--text-2);
  }

  :global(.szukaj-na-instrukcjach) {
    margin-top: var(--sp-8);
    margin-bottom: var(--sp-12);
  }

  .lista {
    list-style: none;
  }

  .pozycja {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-block: var(--sp-6);
    border-top: 1px solid var(--hairline-soft);
  }

  .pozycja:last-child {
    border-bottom: 1px solid var(--hairline-soft);
  }

  .pozycja-opis {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .pozycja-model {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-mono);
    color: var(--gold);
  }

  .pozycja-nazwa {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }

  .pozycja-nazwa:hover {
    color: var(--gold-bright);
  }

  .pozycja-tagline {
    max-width: 46ch;
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .pozycja-pobierz {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    flex-shrink: 0;
    padding: var(--sp-3) var(--sp-5);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--text);
    text-decoration: none;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .pozycja-pobierz:hover {
    border-color: var(--gold);
    color: var(--gold-bright);
  }

  .pozycja-pobierz svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .pozycja-waga {
    color: var(--steel);
  }

  .brak,
  .uwaga {
    max-width: var(--maxw-prose);
    margin-top: var(--sp-8);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--text-muted);
  }

  .brak a,
  .uwaga a {
    color: var(--gold);
  }

  .brak a:hover,
  .uwaga a:hover {
    color: var(--gold-bright);
  }
</style>
