---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Prose from "../components/ui/Prose.astro";
import { site } from "../data/site.ts";

const breadcrumbs = [
  { name: "Owell", path: "/" },
  { name: "Instrukcje obsługi", path: "/instrukcje" },
];
---

<Base
  title="Instrukcje obsługi — Owell"
  description="Instrukcje obsługi w formacie PDF znajdziesz przy każdym produkcie w sklepie. Brakującą instrukcję wyślemy mailem."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title" data-reveal>Instrukcje obsługi</h1>

        <Prose>
          <p>
            {site.sklep ? (
              <Fragment>
                Instrukcja obsługi w formacie PDF jest dostępna na stronie każdego produktu w naszym{" "}
                <a href={site.sklep} target="_blank" rel="noopener noreferrer">sklepie internetowym</a>.
              </Fragment>
            ) : (
              <Fragment>
                Instrukcja obsługi w formacie PDF jest dołączona do każdego produktu w opakowaniu.
              </Fragment>
            )}
          </p>
          <p>
            Jeśli nie możesz znaleźć instrukcji dla swojego modelu, napisz do nas na{" "}
            <a href={`mailto:${site.kontakt.emailSerwis}`}>{site.kontakt.emailSerwis}</a>, podając model produktu —
            wyślemy plik mailem.
          </p>
        </Prose>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-12);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }
</style>
