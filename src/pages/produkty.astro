---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";

import fotoOw1360b from "../assets/produkty/hero/ow-1360b.jpg";
import fotoOw3097 from "../assets/produkty/hero/ow-3097.jpg";
import fotoOw3300 from "../assets/produkty/hero/ow-3300.jpg";
import fotoOw4634 from "../assets/produkty/hero/ow-4634.jpg";
import fotoOw8805 from "../assets/produkty/hero/ow-8805.jpg";

const breadcrumbs = [
  { name: "Owell", path: "/" },
  { name: "Produkty", path: "/produkty" },
];

const wszystkieProdukty = await getCollection("produkty");
const znajdzProdukt = (slug: string) => wszystkieProdukty.find((p) => p.id === slug);

const fotki: Record<string, ImageMetadata> = {
  "ow-1360b": fotoOw1360b,
  "ow-3097": fotoOw3097,
  "ow-3300": fotoOw3300,
  "ow-4634": fotoOw4634,
  "ow-8805": fotoOw8805,
};

const kategorieRaw = [
  {
    nazwa: "Czajnik elektryczny",
    slug: "ow-1360b",
    opis: "Szybkie gotowanie wody z regulacją temperatury — do kawy, herbaty i innych naparów.",
  },
  {
    nazwa: "Rozdrabniacze i szatkownice",
    slug: "ow-4819",
    opis: "Krojenie, szatkowanie i rozdrabnianie warzyw i owoców bez ręcznej pracy.",
  },
  {
    nazwa: "Grzejnik elektryczny",
    slug: null,
    opis: "Dogrzewanie pomieszczeń w chłodniejsze dni, bez instalacji i bez czekania.",
  },
  {
    nazwa: "Lodówka turystyczna",
    slug: "ow-8805",
    opis: "Chłodzenie i utrzymywanie temperatury w podróży, zasilana z gniazda 12V lub 230V.",
  },
  {
    nazwa: "Maszynka do strzyżenia włosów",
    slug: "ow-2856",
    opis: "Strzyżenie włosów w domu, między wizytami u fryzjera.",
  },
  {
    nazwa: "Strzyżarka dla zwierząt",
    slug: "ow-2859",
    opis: "Pielęgnacja sierści psów i kotów w domowych warunkach.",
  },
  {
    nazwa: "Blender ręczny",
    slug: "ow-4634",
    opis: "Miksowanie, ubijanie i rozdrabnianie w jednym urządzeniu, bez wielu sprzętów na blacie.",
  },
  {
    nazwa: "Blender kielichowy",
    slug: null,
    opis: "Przygotowywanie smoothie, koktajli i zup w jednym naczyniu.",
  },
  {
    nazwa: "Czyścik parowy",
    slug: null,
    opis: "Czyszczenie powierzchni parą, bez chemii i szorowania.",
  },
  {
    nazwa: "Pralko-wirówka turystyczna",
    slug: "ow-8058",
    opis: "Pranie i odwirowywanie w małych ilościach — do kempingu, przyczepy lub małych przestrzeni.",
  },
  {
    nazwa: "Koce i poduszki elektryczne",
    slug: null,
    opis: "Ogrzewanie łóżka i ciała zimą, z regulacją temperatury.",
  },
  {
    nazwa: "Opiekacz do kanapek",
    slug: "ow-3300",
    opis: "Opiekanie kanapek i tostów w kilka minut, bez patelni i pilnowania.",
  },
];

const kategorie = kategorieRaw.map((k) => ({
  ...k,
  produkt: k.slug ? znajdzProdukt(k.slug) : undefined,
  foto: k.slug ? fotki[k.slug] : undefined,
}));
---

<Base
  title="Produkty — Owell"
  description="Kategorie produktów Owell: małe AGD do kuchni, pielęgnacji i podróży, z przykładowym modelem z każdej kategorii."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title">Produkty</h1>
        <p class="page-lead">
          Kategorie sprzętu, który projektujemy. Przy każdej — jeden przykładowy model z oferty.
        </p>

        <div class="grid">
          {kategorie.map((k) => (
            <article class:list={["karta", { "karta--puste": !k.produkt }]}>
              <div class="karta-flip">
                <div class="karta-face karta-face--przod">
                  <div class="karta-foto">
                    {k.foto ? (
                      <Image src={k.foto} alt={k.produkt!.data.nazwa} width={640} height={640} class="foto-img" />
                    ) : k.produkt ? (
                      <div class="foto-placeholder">
                        <span class="foto-placeholder-label">{k.produkt.data.model}</span>
                      </div>
                    ) : (
                      <div class="foto-placeholder foto-placeholder--puste">
                        <span class="foto-placeholder-label">Wkrótce w ofercie</span>
                      </div>
                    )}
                  </div>

                  <div class="karta-info">
                    <h2 class="karta-nazwa">{k.nazwa}</h2>
                    <p class="karta-tagline">{k.opis}</p>
                    {!k.produkt && <p class="karta-status">Wkrótce w ofercie.</p>}
                  </div>
                </div>

                {k.produkt && (
                  <div class="karta-face karta-face--tyl">
                    <span class="karta-tyl-model">{k.produkt.data.model}</span>
                    <h2 class="karta-tyl-nazwa">{k.nazwa}</h2>
                    <p class="karta-tyl-opis">{k.produkt.data.opis.split("\n\n")[0]}</p>
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-4);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .page-lead {
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-12);
    max-width: var(--maxw-prose);
    font-size: var(--fs-lead);
    color: var(--text-2);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
  }

  .karta {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    perspective: 1800px;
    cursor: default;
  }

  .karta:not(.karta--puste):hover {
    z-index: 10;
  }

  .karta-flip {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    will-change: transform;
    transition: transform 700ms var(--ease);
  }

  /* Lekkie powiększenie razem z obrotem — ten sam tekst zajmuje więcej
     miejsca na ekranie, łatwiej się czyta bez zmiany layoutu siatki. */
  .karta:not(.karta--puste):hover .karta-flip {
    transform: rotateY(180deg) scale(1.12);
  }

  .karta-face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--hairline-soft);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    /* Zabezpieczenie na wypadek, gdy backface-visibility zawiedzie (bug
       w niektórych przeglądarkach — zdjęcie z przodu potrafi "prześwitywać"
       zniekształcone przez tył karty): dodatkowo chowamy nieaktywną stronę
       przez opacity, dokładnie w połowie 700ms obrotu — karta jest wtedy
       widoczna "na krawędź" (90°), więc przełącznik jest niezauważalny.
       transition-delay 350ms + duration 0s = natychmiastowy skok w tym
       jednym momencie, nie płynne blaknięcie. */
    /* Wymusza osobną warstwę kompozytowania GPU dla każdej ścianki —
       bez tego niektóre przeglądarki (widoczne zwłaszcza na jasnym tle)
       "prześwietlają" ukrytą stronę przez backface-visibility, dając
       rozjechany, podwójny tekst. */
    transform: translateZ(0);
    transition:
      border-color var(--dur) var(--ease),
      opacity 0s linear 350ms;
  }

  .karta-face--tyl {
    transform: rotateY(180deg) translateZ(0);
    opacity: 0;
  }

  .karta:not(.karta--puste):hover .karta-face--przod {
    opacity: 0;
  }

  .karta:not(.karta--puste):hover .karta-face--tyl {
    opacity: 1;
  }

  .karta:hover .karta-face {
    border-color: var(--gold);
  }

  .karta-face--przod {
    background-color: var(--photo-bg);
  }

  .karta-foto {
    position: absolute;
    inset: 0;
  }

  .foto-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .foto-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .foto-placeholder--puste {
    background-color: var(--bg-1);
  }

  .foto-placeholder-label {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .karta--puste .karta-foto {
    opacity: 0.6;
  }

  .karta-info {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--sp-5);
    padding-top: var(--sp-10);
    /* Pełna krycie aż do końca tekstu — .karta-info owija się tylko wokół
       tytułu/taglinu (auto height), więc dawny gradient przygasał do
       przezroczystości zanim doszedł do glifów, przez co prześwitywał wzór
       zdjęcia (np. wyświetlacz czajnika) i tekst wyglądał na "rozjechany". */
    background: linear-gradient(
      to top,
      var(--bg-0) 0%,
      var(--bg-0) 70%,
      transparent 100%
    );
  }

  .karta-nazwa {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--text);
  }

  .karta-tagline {
    margin-top: var(--sp-1);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .karta-status {
    margin-top: var(--sp-1);
    font-size: var(--fs-small);
    font-style: italic;
    color: var(--text-muted);
  }

  /* Obrót o 180° na starcie (żeby po obrocie rodzica .karta-flip tekst
     czytał się normalnie) ustawiony wyżej razem z translateZ(0). */
  .karta-face--tyl {
    gap: var(--sp-2);
    padding: var(--sp-6);
    background-color: var(--bg-1);
  }

  .karta-tyl-model {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--gold);
  }

  .karta-tyl-nazwa {
    flex: none;
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--text);
  }

  /* Opis pełnego akapitu bywa dłuższy niż miejsce na karcie — zamiast
     obcinać tekst, robimy go przewijalnym scrollem myszy/gestem. */
  .karta-tyl-opis {
    flex: 1 1 auto;
    min-height: 0;
    margin-top: var(--sp-2);
    padding-right: var(--sp-3);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--text-2);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--gold) transparent;
  }

  .karta-tyl-opis::-webkit-scrollbar {
    width: 6px;
  }

  .karta-tyl-opis::-webkit-scrollbar-track {
    background: transparent;
  }

  .karta-tyl-opis::-webkit-scrollbar-thumb {
    background-color: var(--gold);
    border-radius: var(--radius-sm);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .karta-flip {
      transition: none !important;
    }

    .karta-face {
      transition: border-color var(--dur) var(--ease) !important;
    }
  }
</style>
