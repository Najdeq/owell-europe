---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";

import fotoOw1360b from "../assets/produkty/hero/ow-1360b.jpg";
import fotoOw3097 from "../assets/produkty/hero/ow-3097.jpg";
import fotoOw3300 from "../assets/produkty/hero/ow-3300.jpg";
import fotoOw4634 from "../assets/produkty/hero/ow-4634.jpg";
import fotoOw8805 from "../assets/produkty/hero/ow-8805.jpg";

const breadcrumbs = [
  { name: "Owell", path: "/" },
  { name: "Produkty", path: "/produkty" },
];

const wszystkieProdukty = await getCollection("produkty");
const znajdzProdukt = (slug: string) => wszystkieProdukty.find((p) => p.id === slug);

const fotki: Record<string, ImageMetadata> = {
  "ow-1360b": fotoOw1360b,
  "ow-3097": fotoOw3097,
  "ow-3300": fotoOw3300,
  "ow-4634": fotoOw4634,
  "ow-8805": fotoOw8805,
};

const kategorieRaw = [
  { nazwa: "Czajnik elektryczny", slug: "ow-1360b" },
  { nazwa: "Rozdrabniacze i szatkownice", slug: "ow-4819" },
  { nazwa: "Grzejnik elektryczny", slug: null },
  { nazwa: "Lodówka turystyczna", slug: "ow-8805" },
  { nazwa: "Maszynka do strzyżenia włosów", slug: "ow-2856" },
  { nazwa: "Strzyżarka dla zwierząt", slug: "ow-2859" },
  { nazwa: "Blender ręczny", slug: "ow-4634" },
  { nazwa: "Blender kielichowy", slug: null },
  { nazwa: "Czyścik parowy", slug: null },
  { nazwa: "Pralko-wirówka turystyczna", slug: "ow-8058" },
  { nazwa: "Koce i poduszki elektryczne", slug: null },
  { nazwa: "Opiekacz do kanapek", slug: "ow-3300" },
];

const kategorie = kategorieRaw.map((k) => ({
  ...k,
  produkt: k.slug ? znajdzProdukt(k.slug) : undefined,
  foto: k.slug ? fotki[k.slug] : undefined,
}));
---

<Base
  title="Produkty — Owell"
  description="Kategorie produktów Owell: małe AGD do kuchni, pielęgnacji i podróży, z przykładowym modelem z każdej kategorii."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title">Produkty</h1>
        <p class="page-lead">
          Kategorie sprzętu, który projektujemy. Przy każdej — jeden przykładowy model z oferty.
        </p>

        <div class="grid">
          {kategorie.map((k) => (
            <article class:list={["karta", { "karta--puste": !k.produkt }]}>
              <div class="karta-foto">
                {k.foto ? (
                  <Image src={k.foto} alt={k.produkt!.data.nazwa} width={640} height={640} class="foto-img" />
                ) : k.produkt ? (
                  <div class="foto-placeholder">
                    <span class="foto-placeholder-label">{k.produkt.data.model}</span>
                  </div>
                ) : (
                  <div class="foto-placeholder foto-placeholder--puste">
                    <span class="foto-placeholder-label">Wkrótce w ofercie</span>
                  </div>
                )}
              </div>

              <div class="karta-info">
                <h2 class="karta-nazwa">{k.nazwa}</h2>
                <p class="karta-tagline">{k.produkt ? k.produkt.data.tagline : "Wkrótce w ofercie."}</p>
                {k.produkt && (
                  <p class="karta-opis">{k.produkt.data.opis.split("\n\n")[0]}</p>
                )}
              </div>
            </article>
          ))}
        </div>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-4);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .page-lead {
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-12);
    max-width: var(--maxw-prose);
    font-size: var(--fs-lead);
    color: var(--text-2);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
  }

  .grid {
    /* Karty rosną na hover ponad sąsiadów (transform, bez zmiany layoutu) —
       trzeba miejsca nad/pod siatką, żeby się nie ucinały. */
    padding-block: var(--sp-8);
  }

  .karta {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--hairline-soft);
    cursor: default;
    /* Punkt skalowania u góry — karta rośnie w dół, nigdy nie nachodzi na
       treść nad siatką (nagłówek, lead). */
    transform-origin: center top;
    transition:
      transform 480ms var(--ease),
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .karta:hover {
    transform: scale(2.3);
    border-color: var(--gold);
    box-shadow: 0 0 0 1px var(--gold), 0 40px 80px -20px rgba(0, 0, 0, 0.65);
    z-index: 10;
  }

  /* Karta w skali 2.3 potrafi wyjść poza ekran w poziomie, jeśli rośnie od
     środka skrajnej kolumny — przesuwamy punkt skalowania do wewnętrznej
     krawędzi (pion zostaje zawsze "top"). */
  @media (min-width: 1000px) {
    .karta:nth-child(4n + 1) {
      transform-origin: left top;
    }

    .karta:nth-child(4n) {
      transform-origin: right top;
    }
  }

  @media (min-width: 640px) and (max-width: 999px) {
    .karta:nth-child(odd) {
      transform-origin: left top;
    }

    .karta:nth-child(even) {
      transform-origin: right top;
    }
  }

  .karta-foto {
    position: absolute;
    inset: 0;
    background-color: var(--photo-bg);
  }

  .foto-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease);
  }

  .karta:hover .foto-img {
    transform: scale(1.08);
  }

  .foto-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .foto-placeholder--puste {
    background-color: var(--bg-1);
  }

  .foto-placeholder-label {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .karta--puste .karta-foto {
    opacity: 0.6;
  }

  .karta-info {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--sp-5);
    background: linear-gradient(
      to top,
      var(--bg-0) 0%,
      rgba(15, 14, 12, 0.85) 55%,
      transparent 100%
    );
  }

  .karta-nazwa {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--text);
  }

  .karta-tagline {
    margin-top: var(--sp-1);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .karta--puste .karta-tagline {
    color: var(--text-muted);
    font-style: italic;
  }

  .karta-opis {
    max-height: 0;
    margin-top: 0;
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--text-2);
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 480ms var(--ease),
      opacity 480ms var(--ease),
      margin-top 480ms var(--ease);
  }

  .karta:hover .karta-opis {
    max-height: 16rem;
    margin-top: var(--sp-3);
    opacity: 1;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .karta,
    .foto-img,
    .karta-opis {
      transition: none !important;
    }
  }
</style>
