---
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Button from "../../components/ui/Button.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import { site } from "../../data/site.ts";

const l = (sciezka: string) => getRelativeLocaleUrl("cs", sciezka);

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "Registrace produktu", path: l("/rejestracja-produktu") },
];

const kroki = [
  {
    tytul: "Najděte číslo modelu",
    opis: `Najdete jej na typovém štítku zařízení a na krabici — začíná na „OW", například OW 3300.`,
  },
  {
    tytul: "Připravte si doklad o koupi",
    opis: "Účtenku nebo potvrzení objednávky. Stačí fotografie pořízená mobilem.",
  },
  {
    tytul: "Zašlete nám jej",
    opis: "Napište nám na WhatsApp nebo e-mailem a uveďte model a datum zakoupení. Přijetí potvrdíme a údaje si uložíme.",
  },
];

const wiadomosc = encodeURIComponent(
  "Dobrý den, rád(a) bych zaregistroval(a) svůj produkt Owell.\n\n" +
    "Model: \n" +
    "Datum zakoupení: \n" +
    "Zakoupeno od: \n\n" +
    "(doklad o koupi přiložen)"
);
---

<Base
  title="Registrace produktu — Owell"
  description="Zaregistrujte svůj produkt Owell — rychlejší kontakt v případě servisu nebo reklamace, zdarma."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <Eyebrow data-reveal>Registrace produktu</Eyebrow>
        <h1 class="page-title" data-reveal data-reveal-delay="80">
          Zaregistrujte svůj produkt Owell
        </h1>
        <p class="page-lead" data-reveal data-reveal-delay="160">
          Uložte si u nás údaje o nákupu — díky tomu bude vyřízení případné reklamace nebo servisu rychlejší, bez
          nutnosti znovu hledat účtenku. Registrace je zdarma a nemění podmínky standardní{" "}
          {site.gwarancjaMiesiace}měsíční záruky.
        </p>

        <ol class="kroki">
          {kroki.map((k, i) => (
            <li class="krok">
              <span class="krok-numer">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h2 class="krok-tytul">{k.tytul}</h2>
                <p class="krok-opis">{k.opis}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="cta">
          <Button
            href={`https://wa.me/${site.kontakt.whatsappWa}?text=${wiadomosc}`}
            variant="primary"
            external
            data-marketplace="whatsapp"
            data-platforma="WhatsApp"
            data-lokalizacja="rejestracja-produktu"
          >
            Registrovat na WhatsApp
          </Button>
          <Button href={`mailto:${site.kontakt.emailSerwis}?subject=Registrace produktu Owell`} variant="ghost">
            Registrovat e-mailem
          </Button>
        </div>

        <div class="warunki">
          <h2 class="warunki-tytul">Podmínky</h2>
          <ul>
            <li>
              Registrace je zdarma a nepovinná. Nemění podmínky standardní {site.gwarancjaMiesiace}měsíční záruky.
            </li>
            <li>
              Registrace neomezuje vaše zákonná práva vyplývající ze záruky ani z ochrany spotřebitele.
            </li>
            <li>
              Údaje z vaší registrace používáme pouze k vyřízení případné reklamace nebo servisu — podrobnosti v{" "}
              <a href={l("/polityka-prywatnosci")}>zásadách ochrany osobních údajů</a>.
            </li>
          </ul>
        </div>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-3);
    max-width: var(--maxw-prose);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .page-lead {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .kroki {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
    margin-top: var(--sp-12);
    list-style: none;
  }

  .krok {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .krok-numer {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--gold);
  }

  .krok-tytul {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--text);
  }

  .krok-opis {
    margin-top: var(--sp-2);
    max-width: 46ch;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-12);
  }

  .warunki {
    max-width: var(--maxw-prose);
    margin-top: var(--sp-16);
    padding-top: var(--sp-8);
    border-top: 1px solid var(--hairline-soft);
  }

  .warunki-tytul {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .warunki ul {
    margin-top: var(--sp-4);
    padding-left: var(--sp-5);
  }

  .warunki li {
    margin-bottom: var(--sp-3);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .warunki a {
    color: var(--gold);
  }

  .warunki a:hover {
    color: var(--gold-bright);
  }

  @media (min-width: 720px) {
    .kroki {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-8);
    }

    .krok {
      flex-direction: column;
      gap: var(--sp-3);
    }
  }
</style>