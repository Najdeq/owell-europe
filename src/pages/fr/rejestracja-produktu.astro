---
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Button from "../../components/ui/Button.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import { site } from "../../data/site.ts";

const l = (sciezka: string) => getRelativeLocaleUrl("fr", sciezka);

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "Enregistrer votre produit", path: l("/rejestracja-produktu") },
];

const kroki = [
  {
    tytul: "Trouvez le numéro de modèle",
    opis: `Il se trouve sur la plaque signalétique de l'appareil et sur la boîte — il commence par « OW », par exemple OW 3300.`,
  },
  {
    tytul: "Préparez une preuve d'achat",
    opis: "Un ticket de caisse ou une confirmation de commande. Une photo prise avec votre téléphone suffit.",
  },
  {
    tytul: "Envoyez-la-nous",
    opis: "Écrivez-nous sur WhatsApp ou par e-mail en indiquant le modèle et la date d'achat. Nous confirmerons la réception et conserverons les données.",
  },
];

const wiadomosc = encodeURIComponent(
  "Bonjour, je souhaite enregistrer mon produit Owell.\n\n" +
    "Modèle : \n" +
    "Date d'achat : \n" +
    "Acheté chez : \n\n" +
    "(preuve d'achat jointe)"
);
---

<Base
  title="Enregistrer votre produit — Owell"
  description="Enregistrez votre produit Owell — un contact plus rapide en cas de service ou de réclamation, gratuitement."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <Eyebrow data-reveal>Enregistrement du produit</Eyebrow>
        <h1 class="page-title" data-reveal data-reveal-delay="80">
          Enregistrez votre produit Owell
        </h1>
        <p class="page-lead" data-reveal data-reveal-delay="160">
          Conservez vos informations d'achat chez nous — cela accélère le traitement d'une éventuelle réclamation
          ou d'un service après-vente, sans avoir à rechercher votre preuve d'achat. L'enregistrement est gratuit
          et ne modifie pas les conditions de la garantie standard de {site.gwarancjaMiesiace} mois.
        </p>

        <ol class="kroki">
          {kroki.map((k, i) => (
            <li class="krok">
              <span class="krok-numer">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h2 class="krok-tytul">{k.tytul}</h2>
                <p class="krok-opis">{k.opis}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="cta">
          <Button
            href={`https://wa.me/${site.kontakt.whatsappWa}?text=${wiadomosc}`}
            variant="primary"
            external
            data-marketplace="whatsapp"
            data-platforma="WhatsApp"
            data-lokalizacja="rejestracja-produktu"
          >
            S'enregistrer sur WhatsApp
          </Button>
          <Button href={`mailto:${site.kontakt.emailSerwis}?subject=Enregistrement produit Owell`} variant="ghost">
            S'enregistrer par e-mail
          </Button>
        </div>

        <div class="warunki">
          <h2 class="warunki-tytul">Conditions</h2>
          <ul>
            <li>
              L'enregistrement est gratuit et facultatif. Il ne modifie pas la garantie standard de{" "}
              {site.gwarancjaMiesiace} mois.
            </li>
            <li>
              L'enregistrement ne limite pas vos droits légaux au titre du droit de la garantie ou de la protection
              des consommateurs.
            </li>
            <li>
              Nous utilisons les données de votre enregistrement uniquement pour traiter une éventuelle réclamation
              ou un service après-vente — détails dans la{" "}
              <a href={l("/polityka-prywatnosci")}>politique de confidentialité</a>.
            </li>
          </ul>
        </div>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-3);
    max-width: var(--maxw-prose);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .page-lead {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .kroki {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
    margin-top: var(--sp-12);
    list-style: none;
  }

  .krok {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .krok-numer {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--gold);
  }

  .krok-tytul {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--text);
  }

  .krok-opis {
    margin-top: var(--sp-2);
    max-width: 46ch;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-12);
  }

  .warunki {
    max-width: var(--maxw-prose);
    margin-top: var(--sp-16);
    padding-top: var(--sp-8);
    border-top: 1px solid var(--hairline-soft);
  }

  .warunki-tytul {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .warunki ul {
    margin-top: var(--sp-4);
    padding-left: var(--sp-5);
  }

  .warunki li {
    margin-bottom: var(--sp-3);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .warunki a {
    color: var(--gold);
  }

  .warunki a:hover {
    color: var(--gold-bright);
  }

  @media (min-width: 720px) {
    .kroki {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-8);
    }

    .krok {
      flex-direction: column;
      gap: var(--sp-3);
    }
  }
</style>