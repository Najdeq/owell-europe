    padding: var(--sp-5);
    padding-top: var(--sp-10);
    /* Pełna krycie aż do końca tekstu — .karta-info owija się tylko wokół
       tytułu/taglinu (auto height), więc dawny gradient przygasał do
       przezroczystości zanim doszedł do glifów, przez co prześwitywał wzór
       zdjęcia (np. wyświetlacz czajnika) i tekst wyglądał na "rozjechany". */
    background: linear-gradient(
      to top,
      var(--bg-0) 0%,
      var(--bg-0) 70%,
      transparent 100%
    );
  }

  .karta-nazwa {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--text);
  }

  .karta-tagline {
    margin-top: var(--sp-1);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .karta-status {
    margin-top: var(--sp-1);
    font-size: var(--fs-small);
    font-style: italic;
    color: var(--text-muted);
  }

  /* Obrót o 180° na starcie (żeby po obrocie rodzica .karta-flip tekst
     czytał się normalnie) ustawiony wyżej razem z translateZ(0). */
  .karta-face--tyl {
    gap: var(--sp-2);
    padding: var(--sp-6);
    background-color: var(--bg-1);
  }

  .karta-tyl-model {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--gold);
  }

  .karta-tyl-nazwa {
    flex: none;
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--text);
  }

  /* Opis pełnego akapitu bywa dłuższy niż miejsce na karcie — zamiast
     obcinać tekst, robimy go przewijalnym scrollem myszy/gestem. */
  .karta-tyl-opis {
    flex: 1 1 auto;
    min-height: 0;
    margin-top: var(--sp-2);
    padding-right: var(--sp-3);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--text-2);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--gold) transparent;
  }

  .karta-tyl-opis::-webkit-scrollbar {
    width: 6px;
  }

  .karta-tyl-opis::-webkit-scrollbar-track {
    background: transparent;
  }

  .karta-tyl-opis::-webkit-scrollbar-thumb {
    background-color: var(--gold);
    border-radius: var(--radius-sm);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .karta-flip {
      transition: none !important;
    }

    .karta-face {
      transition: border-color var(--dur) var(--ease) !important;
    }
  }
</style>
