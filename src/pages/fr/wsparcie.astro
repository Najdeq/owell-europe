---
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import WyszukiwarkaModelu from "../../components/WyszukiwarkaModelu.astro";
import { useTranslations } from "../../i18n/utils.ts";

const l = (sciezka: string) => getRelativeLocaleUrl("fr", sciezka);
const t = useTranslations("fr");

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "Assistance", path: l("/wsparcie") },
];

const linki = [
  {
    tytul: "Foire aux questions",
    opis: "Réponses sur l'achat, la garantie, la livraison et le service.",
    href: l("/faq"),
  },
  {
    tytul: "Modes d'emploi",
    opis: "Modes d'emploi PDF pour chaque produit — dans la boutique ou par e-mail auprès de nous.",
    href: l("/instrukcje"),
  },
  {
    tytul: "Garantie",
    opis: "Ce que couvre la garantie et comment demander une réparation.",
    href: l("/gwarancja"),
  },
  {
    tytul: "Enregistrer votre produit",
    opis: "Enregistrez votre appareil — un contact plus rapide en cas de service ou de réclamation.",
    href: l("/rejestracja-produktu"),
  },
  {
    tytul: "Réclamations",
    opis: "Étape par étape, comment déposer une réclamation produit.",
    href: l("/reklamacje"),
  },
  {
    tytul: "Contact",
    opis: "Écrivez-nous pour toute question générale ou de service.",
    href: l("/kontakt"),
  },
];
---

<Base
  title="Assistance — Owell"
  description="Modes d'emploi, garantie, réclamations et contact — tout ce dont vous avez besoin après avoir acheté un produit Owell."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title" data-reveal>Assistance</h1>
        <p class="page-lead" data-reveal data-reveal-delay="80">Tout ce dont vous pourriez avoir besoin après votre achat, au même endroit.</p>

        <WyszukiwarkaModelu
          class="szukaj-na-wsparciu"
          etykieta={t("hero.szukajLabel")}
          placeholder={t("hero.szukajPlaceholder")}
          pusto={t("hero.szukajPusto")}
        />

        <div class="grid">
          {linki.map((l2) => (
            <a href={l2.href} class="karta">
              <h2 class="karta-tytul">{l2.tytul}</h2>
              <p class="karta-opis">{l2.opis}</p>
              <span class="karta-link">Voir →</span>
            </a>
          ))}
        </div>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-4);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .page-lead {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-size: var(--fs-lead);
    color: var(--text-2);
  }

  :global(.szukaj-na-wsparciu) {
    margin-top: var(--sp-8);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
    margin-top: var(--sp-12);
  }

  .karta {
    display: flex;
    flex-direction: column;
    padding: var(--sp-6);
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease);
  }

  .karta:hover {
    border-color: var(--gold);
  }

  .karta-tytul {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--text);
  }

  .karta-opis {
    margin-top: var(--sp-2);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .karta-link {
    margin-top: var(--sp-4);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--gold);
  }

  .karta:hover .karta-link {
    color: var(--gold-bright);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
