---
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Prose from "../../components/ui/Prose.astro";

const l = (sciezka: string) => getRelativeLocaleUrl("it", sciezka);

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "Cookie", path: l("/cookies") },
];

const kategorie = [
  {
    nazwa: "Necessari",
    opis: "Indispensabili per il corretto funzionamento del sito e per ricordare le tue scelte di consenso. Non possono essere disattivati.",
    cookies: [
      {
        nazwa: "owell-consent (localStorage)",
        dostawca: "Owell (proprietario)",
        cel: "Ricorda la tua decisione di consenso per i cookie di analisi e marketing.",
        czas: "Nessuna scadenza — fino alla cancellazione manuale o alla modifica delle impostazioni.",
      },
    ],
  },
  {
    nazwa: "Analisi",
    opis: "Ci aiutano a capire come i visitatori utilizzano il sito. Vengono caricati solo dopo aver dato il consenso (Consent Mode v2).",
    cookies: [
      {
        nazwa: "_ga",
        dostawca: "Google (Google Analytics 4)",
        cel: "Distingue gli utenti unici.",
        czas: "13 mesi",
      },
      {
        nazwa: "_ga_&lt;identifier&gt;",
        dostawca: "Google (Google Analytics 4)",
        cel: "Mantiene lo stato della sessione e raccoglie statistiche sulle visite.",
        czas: "13 mesi",
      },
    ],
  },
  {
    nazwa: "Marketing",
    opis: "Al momento non utilizziamo cookie di marketing. Questa sezione sarà aggiornata in caso di modifiche.",
    cookies: [],
  },
];
---

<Base
  title="Informativa sui cookie — Owell"
  description="Quali cookie utilizziamo sul sito Owell, per quale scopo e per quanto tempo vengono conservati."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title">Informativa sui cookie</h1>

        <Prose>
          <p>
            Questo sito utilizza cookie. I cookie necessari vengono sempre caricati; le altre categorie solo dopo
            aver dato il consenso nel banner mostrato alla prima visita. Puoi modificare il tuo consenso in
            qualsiasi momento.
          </p>

          <button type="button" class="zmien-ustawienia" data-open-consent-settings>
            Modifica le impostazioni dei cookie
          </button>

          {kategorie.map((kategoria) => (
            <>
              <h2>{kategoria.nazwa}</h2>
              <p>{kategoria.opis}</p>

              {kategoria.cookies.length > 0 && (
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th scope="col">Nome</th>
                        <th scope="col">Fornitore</th>
                        <th scope="col">Finalità</th>
                        <th scope="col">Durata</th>
                      </tr>
                    </thead>
                    <tbody>
                      {kategoria.cookies.map((cookie) => (
                        <tr>
                          <td data-label="Nome" set:html={cookie.nazwa} />
                          <td data-label="Fornitore">{cookie.dostawca}</td>
                          <td data-label="Finalità">{cookie.cel}</td>
                          <td data-label="Durata">{cookie.czas}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </>
          ))}
        </Prose>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-12);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .zmien-ustawienia {
    display: inline-flex;
    align-items: center;
    padding: var(--sp-3) var(--sp-6);
    margin-block: var(--sp-2) var(--sp-8);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text);
    background-color: transparent;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .zmien-ustawienia:hover {
    border-color: var(--gold);
    color: var(--gold-bright);
  }

  .table-wrap {
    margin-bottom: var(--sp-8);
    overflow-x: auto;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius);
  }

  table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: var(--fs-small);
  }

  th {
    padding: var(--sp-3) var(--sp-4);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
    text-align: left;
    background-color: var(--bg-2);
    white-space: nowrap;
  }

  td {
    padding: var(--sp-3) var(--sp-4);
    color: var(--text-2);
    border-top: 1px solid var(--hairline-soft);
    vertical-align: top;
  }

  td:first-child {
    font-family: var(--font-mono);
    color: var(--text);
    white-space: nowrap;
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>(
    "[data-open-consent-settings]"
  );

  button?.addEventListener("click", () => {
    const openConsentSettings = (
      window as unknown as { openConsentSettings?: () => void }
    ).openConsentSettings;

    if (typeof openConsentSettings === "function") {
      openConsentSettings();
    }
  });
</script>