---
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Button from "../../components/ui/Button.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import { site } from "../../data/site.ts";

const l = (sciezka: string) => getRelativeLocaleUrl("it", sciezka);

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "Registra il prodotto", path: l("/rejestracja-produktu") },
];

const kroki = [
  {
    tytul: "Trova il numero del modello",
    opis: `Si trova sulla targhetta del dispositivo e sulla confezione — inizia con "OW", ad esempio OW 3300.`,
  },
  {
    tytul: "Prepara la prova d'acquisto",
    opis: "Uno scontrino o la conferma d'ordine. Basta una foto scattata con il telefono.",
  },
  {
    tytul: "Inviacela",
    opis: "Scrivici su WhatsApp o via email indicando modello e data di acquisto. Confermeremo la ricezione e conserveremo i dati.",
  },
];

const wiadomosc = encodeURIComponent(
  "Salve, vorrei registrare il mio prodotto Owell.\n\n" +
    "Modello: \n" +
    "Data di acquisto: \n" +
    "Acquistato presso: \n\n" +
    "(prova d'acquisto allegata)"
);
---

<Base
  title="Registra il tuo prodotto — Owell"
  description="Registra il tuo prodotto Owell — contatto più rapido in caso di assistenza o reclamo, gratuitamente."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <Eyebrow data-reveal>Registrazione del prodotto</Eyebrow>
        <h1 class="page-title" data-reveal data-reveal-delay="80">
          Registra il tuo prodotto Owell
        </h1>
        <p class="page-lead" data-reveal data-reveal-delay="160">
          Conserva i dati del tuo acquisto con noi — questo velocizza la gestione di un eventuale reclamo o
          assistenza, senza dover cercare di nuovo lo scontrino. La registrazione è gratuita e non modifica le
          condizioni della garanzia standard di {site.gwarancjaMiesiace} mesi.
        </p>

        <ol class="kroki">
          {kroki.map((k, i) => (
            <li class="krok">
              <span class="krok-numer">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h2 class="krok-tytul">{k.tytul}</h2>
                <p class="krok-opis">{k.opis}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="cta">
          <Button
            href={`https://wa.me/${site.kontakt.whatsappWa}?text=${wiadomosc}`}
            variant="primary"
            external
            data-marketplace="whatsapp"
            data-platforma="WhatsApp"
            data-lokalizacja="rejestracja-produktu"
          >
            Registrati su WhatsApp
          </Button>
          <Button href={`mailto:${site.kontakt.emailSerwis}?subject=Registrazione prodotto Owell`} variant="ghost">
            Registrati via email
          </Button>
        </div>

        <div class="warunki">
          <h2 class="warunki-tytul">Termini</h2>
          <ul>
            <li>
              La registrazione è gratuita e facoltativa. Non modifica la garanzia standard di{" "}
              {site.gwarancjaMiesiace} mesi.
            </li>
            <li>
              La registrazione non limita i tuoi diritti previsti dalla legge sulla garanzia o sulla tutela dei
              consumatori.
            </li>
            <li>
              Utilizziamo i dati della tua registrazione solo per gestire un eventuale reclamo o assistenza —
              dettagli nella <a href={l("/polityka-prywatnosci")}>informativa sulla privacy</a>.
            </li>
          </ul>
        </div>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-3);
    max-width: var(--maxw-prose);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .page-lead {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .kroki {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
    margin-top: var(--sp-12);
    list-style: none;
  }

  .krok {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .krok-numer {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--gold);
  }

  .krok-tytul {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--text);
  }

  .krok-opis {
    margin-top: var(--sp-2);
    max-width: 46ch;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-12);
  }

  .warunki {
    max-width: var(--maxw-prose);
    margin-top: var(--sp-16);
    padding-top: var(--sp-8);
    border-top: 1px solid var(--hairline-soft);
  }

  .warunki-tytul {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .warunki ul {
    margin-top: var(--sp-4);
    padding-left: var(--sp-5);
  }

  .warunki li {
    margin-bottom: var(--sp-3);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .warunki a {
    color: var(--gold);
  }

  .warunki a:hover {
    color: var(--gold-bright);
  }

  @media (min-width: 720px) {
    .kroki {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-8);
    }

    .krok {
      flex-direction: column;
      gap: var(--sp-3);
    }
  }
</style>