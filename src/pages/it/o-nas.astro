---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import { site } from "../../data/site.ts";
import lifestyleCzajnik from "../../assets/marka/lifestyle-czajnik.png";
import lifestyleBlender from "../../assets/marka/lifestyle-blender.png";
import lifestyleStrzyzarka from "../../assets/marka/lifestyle-strzyzarka.png";
import magazyn from "../../assets/marka/magazyn.jpg";

const l = (sciezka: string) => getRelativeLocaleUrl("it", sciezka);

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "Chi siamo", path: l("/o-nas") },
];

const zdjecia = [
  { src: lifestyleCzajnik, alt: "Bollitore Owell OW 1360 usato quotidianamente in cucina" },
  { src: lifestyleBlender, alt: "Frullatore a immersione Owell OW 4634 mentre prepara un frullato" },
  { src: lifestyleStrzyzarka, alt: "Tosatrice Owell OW 2859 durante la toelettatura di un cane" },
];

const cyklSekund = 5;
const totalDuration = zdjecia.length * cyklSekund;
const segmentPct = 100 / zdjecia.length;
const fadeInPct = Math.min(2, segmentPct * 0.15);
const holdEndPct = segmentPct - fadeInPct;

const visualKeyframes = `
  @keyframes o-nas-carousel {
    0% { opacity: 0; }
    ${fadeInPct.toFixed(3)}% { opacity: 1; }
    ${holdEndPct.toFixed(3)}% { opacity: 1; }
    ${segmentPct.toFixed(3)}% { opacity: 0; }
    100% { opacity: 0; }
  }
`;
---

<Base
  title="Chi siamo — Owell"
  description="Owell progetta piccoli elettrodomestici per l'uso quotidiano. Scopri da dove veniamo, in cosa crediamo e come lavoriamo."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title" data-reveal>Chi siamo</h1>

        <div class="visual" style={`--visual-cykl: ${totalDuration}s`}>
          {zdjecia.map((zdjecie, i) => (
            <Image
              src={zdjecie.src}
              alt={zdjecie.alt}
              width={1600}
              height={893}
              class="visual-img"
              style={`animation-delay: ${i * cyklSekund}s`}
            />
          ))}

          <div class="visual-overlay">
            <div class="visual-text">
              <p>
                Owell porta con sé oltre {site.grupa.lataHistorii} anni di esperienza nella produzione di piccoli
                elettrodomestici, presente sul mercato polacco dal {site.grupa.odRokuWPolsce}. Abbiamo già realizzato
                oltre {" "}
                {site.grupa.liczbaProduktow} modelli venduti in più di {site.grupa.liczbaKrajow} paesi. Ogni prodotto
                Owell è sottoposto a rigorose procedure di controllo qualità ed è accompagnato da una documentazione
                di conformità completa ai requisiti di sicurezza UE (GPSR) — i dettagli e i dati del produttore sono
                disponibili nella nostra pagina <a href={l("/bezpieczenstwo-produktu")}>sicurezza del prodotto</a>.
              </p>

              <p>
                Crediamo che gli elettrodomestici non debbano gridare per essere validi. Preferiamo un'unica
                soluzione ben pensata piuttosto che dieci funzioni usate una volta sola. Per questo ogni prodotto
                viene messo alla prova con le stesse domande: rende davvero più semplice la vita quotidiana, regge
                l'uso regolare e, se qualcosa va storto, può essere segnalato senza essere rimbalzati tra vari
                call center.
              </p>

              <p>
                Vendiamo online, senza una rete di negozi fisici — oggi attraverso il nostro negozio ufficiale su
                Allegro, dove compariamo direttamente come produttore. Gli ordini effettuati prima delle 18:30
                vengono spediti lo stesso giorno, con consegna garantita tramite InPost. Ogni prodotto è accompagnato
                da una scheda GPSR con i dati completi del produttore e da una garanzia di{" "}
                {site.gwarancjaMiesiace} mesi — senza eccezioni, senza clausole nascoste.
              </p>
            </div>
          </div>
        </div>
      </Container>
    </Section>
    <Section bg="raised">
      <Container>
        <div class="zaplecze">
          <div class="zaplecze-media">
            <Image
              src={magazyn}
              alt="Centro logistico Owell visto dall'alto"
              width={1740}
              height={742}
              class="zaplecze-img"
            />
          </div>

          <div class="zaplecze-tekst">
            <p class="zaplecze-eyebrow" data-reveal>Infrastruttura</p>
            <h2 class="zaplecze-tytul" data-reveal data-reveal-delay="80">Un centro logistico di proprietà</h2>
            <p class="zaplecze-opis" data-reveal data-reveal-delay="160">
              30.000 m² sotto lo stesso tetto — dalla ricezione della merce, allo stoccaggio, fino all'imballaggio e alla spedizione. Grazie al nostro centro controlliamo l'intero processo: gli ordini effettuati entro le 18:30 vengono spediti lo stesso giorno, e monitoriamo le scorte in tempo reale — quindi non promettiamo mai la disponibilità di un prodotto che in realtà non abbiamo a magazzino.
            </p>
          </div>
        </div>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style set:html={visualKeyframes} is:global></style>

<style>
  .page-title {
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-12);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .visual {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid var(--hairline);
    overflow: hidden;
  }

  .visual-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .visual-img:not(:first-of-type) {
    display: none;
  }

  .visual-overlay {
    padding: var(--sp-8);
    background-color: var(--bg-0);
  }

  .visual-text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .visual-text a {
    color: var(--gold);
    text-underline-offset: 0.2em;
  }

  .visual-text a:hover {
    color: var(--gold-bright);
  }

  @media (min-width: 960px) {
    .visual {
      min-height: 26rem;
    }

    .visual-img,
    .visual-img:not(:first-of-type) {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      animation: o-nas-carousel var(--visual-cykl) ease-in-out infinite;
    }

    .visual-overlay {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 100%;
      padding: var(--sp-16);
      background: linear-gradient(
        to right,
        var(--bg-0) 0%,
        var(--bg-0) 42%,
        transparent 78%
      );
      transition: opacity 900ms var(--ease);
    }

    .visual-text {
      max-width: 30rem;
    }

    .visual:hover .visual-overlay {
      opacity: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .visual-img {
        animation: none !important;
        opacity: 0;
      }

      .visual-img:first-of-type {
        opacity: 1;
      }
    }
  }
  .zaplecze {
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
  }

  .zaplecze-media {
    border-radius: var(--radius-lg);
    border: 1px solid var(--hairline);
    overflow: hidden;
  }

  .zaplecze-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .zaplecze-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .zaplecze-tytul {
    margin-top: var(--sp-3);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .zaplecze-opis {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--text-2);
  }
</style>