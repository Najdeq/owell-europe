---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Prose from "../../components/ui/Prose.astro";
import { site } from "../../data/site.ts";

const produkty = (await getCollection("produkty", ({ data }) => data.opublikowany)).sort(
  (a, b) => a.data.kolejnosc - b.data.kolejnosc
);

const l = (sciezka: string) => getRelativeLocaleUrl("it", sciezka);

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "Sicurezza del prodotto", path: l("/bezpieczenstwo-produktu") },
];
---

<Base
  title="Sicurezza del prodotto — Owell"
  description="Dati del produttore richiesti dal Regolamento GPSR (UE) 2023/988, come segnalare un problema di sicurezza del prodotto e informazioni sulle azioni di assistenza."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title">Sicurezza del prodotto</h1>

        <Prose>
          <p>
            Questa pagina contiene le informazioni richieste dal Regolamento (UE) 2023/988 del Parlamento europeo e
            del Consiglio sulla sicurezza generale dei prodotti (GPSR).
          </p>

          <h2>Soggetto responsabile di questo sito</h2>
          <p>
            <strong>{site.firma.nazwaPelna}</strong><br />
            {site.firma.adres}<br />
            Partita IVA (NIP): {site.firma.nip} · Numero di registro aziendale (REGON): {site.firma.regon}<br />
            Email per questioni di sicurezza del prodotto: <a href={`mailto:${site.kontakt.emailGpsr}`}>{site.kontakt.emailGpsr}</a>
          </p>

          <h2>Dati del produttore per i singoli prodotti</h2>
          <p>
            In conformità con i requisiti GPSR, pubblichiamo di seguito i dati identificativi del produttore per
            ogni prodotto della nostra gamma. La colonna "Persona responsabile UE" è compilata solo quando il
            produttore ha sede al di fuori dell'Unione Europea.
          </p>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">Prodotto</th>
                  <th scope="col">Produttore</th>
                  <th scope="col">Indirizzo</th>
                  <th scope="col">Email</th>
                  <th scope="col">Persona responsabile UE</th>
                </tr>
              </thead>
              <tbody>
                {produkty.map((p) => (
                  <tr>
                    <td data-label="Prodotto">{p.data.nazwa} ({p.data.model})</td>
                    <td data-label="Produttore">{p.data.gpsr.producent}</td>
                    <td data-label="Indirizzo">{p.data.gpsr.adres}</td>
                    <td data-label="Email">
                      <a href={`mailto:${p.data.gpsr.emailProducenta}`}>{p.data.gpsr.emailProducenta}</a>
                    </td>
                    <td data-label="Persona responsabile UE">{p.data.gpsr.osobaOdpowiedzialnaUE ?? "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h2>Come segnalare un problema di sicurezza</h2>
          <p>
            Se sospetti che uno dei nostri prodotti rappresenti un rischio per la salute o la sicurezza, scrivi a{" "}
            <a href={`mailto:${site.kontakt.emailGpsr}`}>{site.kontakt.emailGpsr}</a>. Nella segnalazione,
            includi:
          </p>
          <ul>
            <li>il nome e il modello del prodotto (ad es. dall'etichetta o dalla scheda prodotto su questo sito),</li>
            <li>una descrizione del problema riscontrato,</li>
            <li>foto del problema, se possibile,</li>
            <li>i tuoi dati di contatto, così da poterti ricontattare.</li>
          </ul>
          <p>
            Se un prodotto presenta un rischio grave, il produttore e i distributori sono tenuti a segnalarlo alle
            autorità di vigilanza del mercato competenti (in Polonia, tra le altre, l'UOKiK) tramite il sistema UE
            Safety Gate.
          </p>

          <h2>Azioni di assistenza e richiami di prodotto</h2>
          <p>
            Alla data di questa informativa (7 agosto 2026), Owell non sta effettuando alcuna azione di assistenza
            o richiamo di prodotto. Se ciò dovesse cambiare, questa informazione sarà aggiornata tempestivamente.
          </p>
        </Prose>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-12);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .table-wrap {
    margin-bottom: var(--sp-8);
    overflow-x: auto;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius);
  }

  table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    font-size: var(--fs-small);
  }

  th {
    padding: var(--sp-3) var(--sp-4);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
    text-align: left;
    background-color: var(--bg-2);
    white-space: nowrap;
  }

  td {
    padding: var(--sp-3) var(--sp-4);
    color: var(--text-2);
    border-top: 1px solid var(--hairline-soft);
    vertical-align: top;
  }

  td:first-child {
    color: var(--text);
    font-weight: 500;
  }
</style>