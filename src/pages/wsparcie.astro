---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import WyszukiwarkaModelu from "../components/WyszukiwarkaModelu.astro";

const breadcrumbs = [
  { name: "Owell", path: "/" },
  { name: "Wsparcie", path: "/wsparcie" },
];

const linki = [
  {
    tytul: "Najczęstsze pytania",
    opis: "Odpowiedzi na pytania o zakup, gwarancję, dostawę i serwis.",
    href: "/faq",
  },
  {
    tytul: "Instrukcje obsługi",
    opis: "Instrukcje PDF do każdego produktu — w sklepie lub mailem od nas.",
    href: "/instrukcje",
  },
  {
    tytul: "Gwarancja",
    opis: "Co obejmuje gwarancja i jak zgłosić naprawę.",
    href: "/gwarancja",
  },
  {
    tytul: "Rejestracja produktu",
    opis: "Zarejestruj urządzenie i przedłuż gwarancję o rok. Bezpłatnie.",
    href: "/rejestracja-produktu",
  },
  {
    tytul: "Reklamacje",
    opis: "Krok po kroku, jak zgłosić reklamację produktu.",
    href: "/reklamacje",
  },
  {
    tytul: "Kontakt",
    opis: "Napisz do nas w sprawach ogólnych lub serwisowych.",
    href: "/kontakt",
  },
];
---

<Base
  title="Wsparcie — Owell"
  description="Instrukcje, gwarancja, reklamacje i kontakt — wszystko, czego potrzebujesz po zakupie produktu Owell."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title" data-reveal>Wsparcie</h1>
        <p class="page-lead" data-reveal data-reveal-delay="80">Wszystko, czego możesz potrzebować po zakupie, w jednym miejscu.</p>

        <WyszukiwarkaModelu class="szukaj-na-wsparciu" />

        <div class="grid">
          {linki.map((l) => (
            <a href={l.href} class="karta">
              <h2 class="karta-tytul">{l.tytul}</h2>
              <p class="karta-opis">{l.opis}</p>
              <span class="karta-link">Zobacz →</span>
            </a>
          ))}
        </div>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-4);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .page-lead {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-size: var(--fs-lead);
    color: var(--text-2);
  }

  :global(.szukaj-na-wsparciu) {
    margin-top: var(--sp-8);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
    margin-top: var(--sp-12);
  }

  .karta {
    display: flex;
    flex-direction: column;
    padding: var(--sp-6);
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease);
  }

  .karta:hover {
    border-color: var(--gold);
  }

  .karta-tytul {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--text);
  }

  .karta-opis {
    margin-top: var(--sp-2);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .karta-link {
    margin-top: var(--sp-4);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--gold);
  }

  .karta:hover .karta-link {
    color: var(--gold-bright);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
