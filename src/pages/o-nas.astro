---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import { site } from "../data/site.ts";
import lifestyleCzajnik from "../assets/marka/lifestyle-czajnik.png";
import lifestyleBlender from "../assets/marka/lifestyle-blender.png";
import lifestyleStrzyzarka from "../assets/marka/lifestyle-strzyzarka.png";
import magazyn from "../assets/marka/magazyn.jpg";

const breadcrumbs = [
  { name: "Owell", path: "/" },
  { name: "O nas", path: "/o-nas" },
];

const zdjecia = [
  { src: lifestyleCzajnik, alt: "Czajnik Owell OW 1360 w codziennym użyciu w kuchni" },
  { src: lifestyleBlender, alt: "Blender ręczny Owell OW 4634 podczas przygotowania smoothie" },
  { src: lifestyleStrzyzarka, alt: "Strzyżarka Owell OW 2859 podczas pielęgnacji psa" },
];

const cyklSekund = 5;
const totalDuration = zdjecia.length * cyklSekund;
const segmentPct = 100 / zdjecia.length;
const fadeInPct = Math.min(2, segmentPct * 0.15);
const holdEndPct = segmentPct - fadeInPct;

const visualKeyframes = `
  @keyframes o-nas-carousel {
    0% { opacity: 0; }
    ${fadeInPct.toFixed(3)}% { opacity: 1; }
    ${holdEndPct.toFixed(3)}% { opacity: 1; }
    ${segmentPct.toFixed(3)}% { opacity: 0; }
    100% { opacity: 0; }
  }
`;
---

<Base
  title="O nas — Owell"
  description="Owell projektuje małe AGD do codziennego użytku. Zobacz, skąd jesteśmy, w co wierzymy i jak pracujemy."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <!-- Opis filmu dla Google (VideoObject) — bez tego Search Console zgłaszał
       stronę jako „film niezindeksowany". -->
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"VideoObject","name":"Spacer po centrum logistycznym Owell","description":"Minuta w centrum logistycznym Owell: przyjęcie towaru, regały wysokiego składowania i palety gotowe do wysyłki.","thumbnailUrl":"https://owelleurope.pl/video/owell-magazyn-poster.jpg","uploadDate":"2026-10-11","duration":"PT1M","contentUrl":"https://owelleurope.pl/video/owell-magazyn.mp4","inLanguage":"pl"})} />
  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title" data-reveal>O nas</h1>

        <div class="visual" style={`--visual-cykl: ${totalDuration}s`}>
          {zdjecia.map((zdjecie, i) => (
            <Image
              src={zdjecie.src}
              alt={zdjecie.alt}
              width={1600}
              height={893}
              class="visual-img"
              style={`animation-delay: ${i * cyklSekund}s`}
            />
          ))}

          <div class="visual-overlay">
            <div class="visual-text">
              <p>
                Owell to ponad {site.grupa.lataHistorii}-letnie doświadczenie w produkcji małego AGD, obecne na
                polskim rynku od {site.grupa.odRokuWPolsce} roku. Stworzyliśmy już ponad {site.grupa.liczbaProduktow}{" "}
                modeli sprzedawanych w ponad {site.grupa.liczbaKrajow} krajach. Każdy produkt Owell przechodzi
                rygorystyczne procedury kontroli jakości i ma pełną dokumentację zgodności z unijnymi wymogami
                bezpieczeństwa (GPSR) — szczegóły i dane producenta znajdziesz na stronie{" "}
                <a href="/bezpieczenstwo-produktu">bezpieczeństwa produktu</a>.
              </p>

              <p>
                Wierzymy, że sprzęt do domu nie musi krzyczeć, żeby być dobry. Wolimy jedno przemyślane rozwiązanie
                niż dziesięć funkcji, z których korzysta się raz. Dlatego każdy produkt przechodzi te same pytania:
                czy to realnie ułatwia codzienność, czy wytrzyma regularne użytkowanie i czy w razie problemu da się
                to zgłosić bez przekierowań między infoliniami.
              </p>

              <p>
                Sprzedajemy online, bez sieci salonów stacjonarnych — dziś przez nasz oficjalny sklep na Allegro,
                gdzie występujemy bezpośrednio jako producent. Zamówienia złożone do 18:30 wysyłamy tego samego dnia,
                z gwarancją dostawy InPostem. Każdy produkt ma kartę GPSR z pełnymi danymi producenta oraz{" "}
                {site.gwarancjaMiesiace}-miesięczną gwarancję — bez wyjątków i bez drobnego druku.
              </p>
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <Section bg="raised">
      <Container>
        <div class="zaplecze">
          <Image
            src={magazyn}
            alt="Centrum logistyczne Owell z lotu ptaka"
            width={1740}
            height={742}
            class="zaplecze-img"
          />

          <div class="zaplecze-overlay">
            <div class="zaplecze-text">
            <p class="zaplecze-eyebrow" data-reveal>Zaplecze</p>
            <h2 class="zaplecze-tytul" data-reveal data-reveal-delay="80">Własne centrum logistyczne</h2>
            <p class="zaplecze-opis" data-reveal data-reveal-delay="160">
              30 000 m² pod jednym dachem — od przyjęcia towaru, przez magazynowanie, po pakowanie i wysyłkę.
              Dzięki własnemu zapleczu kontrolujemy cały proces: zamówienia złożone do 18:30 wysyłamy tego samego
              dnia, a stan magazynowy sprawdzamy na bieżąco, więc nie obiecujemy dostępności produktu, którego
              akurat nie mamy na półce.
            </p>
            </div>
          </div>
        </div>

        <!-- Film 1:00 z dźwiękiem, ok. 20 MB: preload="none" — pobiera się dopiero
             po kliknięciu, więc nie spowalnia wejścia na stronę. Źródło (100 MB)
             leży w wideo-zrodlo/ poza repo. -->
        <figure class="zaplecze-wideo" id="film" data-reveal>
          <video
            controls
            preload="none"
            playsinline
            poster="/video/owell-magazyn-poster.jpg"
            width="1920"
            height="1080"
            aria-label="Film: spacer po centrum logistycznym Owell"
          >
            <source src="/video/owell-magazyn.mp4" type="video/mp4" />
          </video>
          <figcaption>Zobacz nasze centrum logistyczne od środka — 1 minuta, z dźwiękiem.</figcaption>
        </figure>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style set:html={visualKeyframes} is:global></style>

<style>
  .page-title {
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-12);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .visual {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid var(--hairline);
    overflow: hidden;
  }

  .visual-img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Na mobile pokazujemy tylko pierwsze zdjęcie, statycznie — karuzela
     (position:absolute + animacja) włącza się dopiero na desktopie. */
  .visual-img:not(:first-of-type) {
    display: none;
  }

  .visual-overlay {
    padding: var(--sp-8);
    background-color: var(--bg-0);
  }

  .visual-text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .visual-text a {
    color: var(--gold);
    text-underline-offset: 0.2em;
  }

  .visual-text a:hover {
    color: var(--gold-bright);
  }

  .zaplecze-wideo {
    margin-top: var(--sp-8);
    /* Kotwica #film (karta na stronie głównej) — nie chowaj filmu pod nagłówkiem. */
    scroll-margin-top: calc(var(--header-h, 65px) + var(--sp-6));
  }

  .zaplecze-wideo video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background-color: var(--bg-0);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
  }

  .zaplecze-wideo figcaption {
    margin-top: var(--sp-3);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .zaplecze {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid var(--hairline);
    overflow: hidden;
  }

  .zaplecze-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .zaplecze-overlay {
    padding: var(--sp-8);
    background-color: var(--bg-0);
  }

  .zaplecze-text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .zaplecze-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .zaplecze-tytul {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .zaplecze-opis {
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  /* Nachodzenie tekstu na zdjęcie w gradiencie, tylko na desktopie — tekst
     zostaje widoczny cały czas, zmienia się jedynie zdjęcie w tle (karuzela
     wyżej). Na mobile to zwykły, czytelny stos: zdjęcie, potem tekst na
     pełnym, nieprzezroczystym tle. */
  @media (min-width: 960px) {
    .visual {
      min-height: 26rem;
    }

    .visual-img,
    .visual-img:not(:first-of-type) {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      animation: o-nas-carousel var(--visual-cykl) ease-in-out infinite;
    }

    .visual-overlay {
      /* position:relative (nie absolute) celowo — dzięki temu ten blok
         zostaje w normalnym przepływie i to ON ustala wysokość .visual
         (rodzica), zamiast być docinany do sztywnej wysokości. Zdjęcie
         (position:absolute) rozciąga się na całą tę wysokość. */
      position: relative;
      display: flex;
      align-items: center;
      min-height: 100%;
      padding: var(--sp-16);
      background: linear-gradient(
        to right,
        var(--bg-0) 0%,
        var(--bg-0) 42%,
        transparent 78%
      );
    }

    .visual-text {
      max-width: 30rem;
    }

    .zaplecze {
      min-height: 26rem;
    }

    .zaplecze-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .zaplecze-overlay {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 100%;
      padding: var(--sp-16);
      background: linear-gradient(
        to right,
        var(--bg-0) 0%,
        var(--bg-0) 42%,
        transparent 78%
      );
    }

    .zaplecze-text {
      max-width: 30rem;
    }

    @media (prefers-reduced-motion: reduce) {
      .visual-img {
        animation: none !important;
        opacity: 0;
      }

      .visual-img:first-of-type {
        opacity: 1;
      }
    }
  }
</style>
