---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Prose from "../../components/ui/Prose.astro";
import { site } from "../../data/site.ts";

const produkty = (await getCollection("produkty", ({ data }) => data.opublikowany)).sort(
  (a, b) => a.data.kolejnosc - b.data.kolejnosc
);

const l = (sciezka: string) => getRelativeLocaleUrl("es", sciezka);

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "Seguridad del producto", path: l("/bezpieczenstwo-produktu") },
];
---

<Base
  title="Seguridad del producto — Owell"
  description="Datos del fabricante exigidos por el Reglamento GPSR (UE) 2023/988, cómo notificar un problema de seguridad del producto e información sobre acciones de servicio."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title">Seguridad del producto</h1>

        <Prose>
          <p>
            Esta página contiene la información exigida por el Reglamento (UE) 2023/988 del Parlamento Europeo y
            del Consejo relativo a la seguridad general de los productos (GPSR).
          </p>

          <h2>Entidad responsable de este sitio web</h2>
          <p>
            <strong>{site.firma.nazwaPelna}</strong><br />
            {site.firma.adres}<br />
            NIF (NIP): {site.firma.nip} · Número de registro de empresa (REGON): {site.firma.regon}<br />
            Correo electrónico para asuntos de seguridad del producto: <a href={`mailto:${site.kontakt.emailGpsr}`}>{site.kontakt.emailGpsr}</a>
          </p>

          <h2>Datos del fabricante por producto</h2>
          <p>
            De acuerdo con los requisitos del GPSR, publicamos a continuación los datos identificativos del
            fabricante de cada producto de nuestra gama. La columna "Persona responsable en la UE" solo se
            cumplimenta cuando el fabricante tiene su sede fuera de la Unión Europea.
          </p>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">Producto</th>
                  <th scope="col">Fabricante</th>
                  <th scope="col">Dirección</th>
                  <th scope="col">Correo electrónico</th>
                  <th scope="col">Persona responsable en la UE</th>
                </tr>
              </thead>
              <tbody>
                {produkty.map((p) => (
                  <tr>
                    <td data-label="Producto">{p.data.nazwa} ({p.data.model})</td>
                    <td data-label="Fabricante">{p.data.gpsr.producent}</td>
                    <td data-label="Dirección">{p.data.gpsr.adres}</td>
                    <td data-label="Correo electrónico">
                      <a href={`mailto:${p.data.gpsr.emailProducenta}`}>{p.data.gpsr.emailProducenta}</a>
                    </td>
                    <td data-label="Persona responsable en la UE">{p.data.gpsr.osobaOdpowiedzialnaUE ?? "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h2>Cómo notificar un problema de seguridad</h2>
          <p>
            Si sospechas que alguno de nuestros productos representa un riesgo para la salud o la seguridad,
            escribe a <a href={`mailto:${site.kontakt.emailGpsr}`}>{site.kontakt.emailGpsr}</a>. En tu notificación,
            incluye por favor:
          </p>
          <ul>
            <li>el nombre y el modelo del producto (por ejemplo, de la etiqueta o de la ficha del producto en este sitio web),</li>
            <li>una descripción del problema observado,</li>
            <li>fotos del problema, si es posible,</li>
            <li>tus datos de contacto, para que podamos responderte.</li>
          </ul>
          <p>
            Si un producto presenta un riesgo grave, el fabricante y los distribuidores están obligados a notificar
            este hecho a las autoridades de vigilancia del mercado competentes (en Polonia, entre otras, la UOKiK)
            a través del sistema europeo Safety Gate.
          </p>

          <h2>Acciones de servicio y retiradas de producto</h2>
          <p>
            A fecha de este aviso (7 de agosto de 2026), Owell no está llevando a cabo ninguna acción de servicio ni
            retirada de productos. Si esto cambia, esta información se actualizará aquí de inmediato.
          </p>
        </Prose>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  .page-title {
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-12);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .table-wrap {
    margin-bottom: var(--sp-8);
    overflow-x: auto;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius);
  }

  table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    font-size: var(--fs-small);
  }

  th {
    padding: var(--sp-3) var(--sp-4);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
    text-align: left;
    background-color: var(--bg-2);
    white-space: nowrap;
  }

  td {
    padding: var(--sp-3) var(--sp-4);
    color: var(--text-2);
    border-top: 1px solid var(--hairline-soft);
    vertical-align: top;
  }

  td:first-child {
    color: var(--text);
    font-weight: 500;
  }
</style>
