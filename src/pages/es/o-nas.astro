---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import { site } from "../../data/site.ts";
import lifestyleCzajnik from "../../assets/marka/lifestyle-czajnik.png";
import lifestyleBlender from "../../assets/marka/lifestyle-blender.png";
import lifestyleStrzyzarka from "../../assets/marka/lifestyle-strzyzarka.png";
import magazyn from "../../assets/marka/magazyn.jpg";

const l = (sciezka: string) => getRelativeLocaleUrl("es", sciezka);

const breadcrumbs = [
  { name: "Owell", path: l("/") },
  { name: "Sobre nosotros", path: l("/o-nas") },
];

const zdjecia = [
  { src: lifestyleCzajnik, alt: "Hervidor Owell OW 1360 en uso diario en la cocina" },
  { src: lifestyleBlender, alt: "Batidora de mano Owell OW 4634 preparando un batido" },
  { src: lifestyleStrzyzarka, alt: "Cortapelos Owell OW 2859 arreglando a un perro" },
];

const cyklSekund = 5;
const totalDuration = zdjecia.length * cyklSekund;
const segmentPct = 100 / zdjecia.length;
const fadeInPct = Math.min(2, segmentPct * 0.15);
const holdEndPct = segmentPct - fadeInPct;

const visualKeyframes = `
  @keyframes o-nas-carousel {
    0% { opacity: 0; }
    ${fadeInPct.toFixed(3)}% { opacity: 1; }
    ${holdEndPct.toFixed(3)}% { opacity: 1; }
    ${segmentPct.toFixed(3)}% { opacity: 0; }
    100% { opacity: 0; }
  }
`;
---

<Base
  title="Sobre nosotros — Owell"
  description="Owell diseña pequeños electrodomésticos para el uso diario. Descubre de dónde venimos, en qué creemos y cómo trabajamos."
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Header />

  <main id="content">
    <Section bg="base">
      <Container>
        <h1 class="page-title" data-reveal>Sobre nosotros</h1>

        <div class="visual" style={`--visual-cykl: ${totalDuration}s`}>
          {zdjecia.map((zdjecie, i) => (
            <Image
              src={zdjecie.src}
              alt={zdjecie.alt}
              width={1600}
              height={893}
              class="visual-img"
              style={`animation-delay: ${i * cyklSekund}s`}
            />
          ))}

          <div class="visual-overlay">
            <div class="visual-text">
              <p>
                Owell aporta más de {site.grupa.lataHistorii} años de experiencia en la fabricación de pequeños
                electrodomésticos, presente en el mercado polaco desde {site.grupa.odRokuWPolsce}. Ya hemos fabricado
                más de {site.grupa.liczbaProduktow} modelos vendidos en más de {site.grupa.liczbaKrajow} países. Cada
                producto Owell pasa por rigurosos procedimientos de control de calidad y se entrega con la
                documentación completa de conformidad con los requisitos de seguridad de la UE (GPSR); los detalles y
                los datos del fabricante están disponibles en nuestra página de{" "}
                <a href={l("/bezpieczenstwo-produktu")}>seguridad del producto</a>.
              </p>

              <p>
                Creemos que los electrodomésticos no necesitan hacer ruido para ser buenos. Preferimos una solución
                bien pensada a diez funciones que se usan una sola vez. Por eso cada producto pasa por las mismas
                preguntas: ¿facilita de verdad el día a día?, ¿aguantará un uso regular?, y si algo falla, ¿se puede
                comunicar sin acabar rebotando entre distintos centros de atención?
              </p>

              <p>
                Vendemos online, sin una red de tiendas físicas; hoy a través de nuestra tienda oficial en Allegro,
                donde aparecemos directamente como fabricante. Los pedidos realizados antes de las 18:30 se envían el
                mismo día, con entrega garantizada por InPost. Cada producto incluye una ficha GPSR con los datos
                completos del fabricante y una garantía de {site.gwarancjaMiesiace} meses, sin excepciones ni letra
                pequeña.
              </p>
            </div>
          </div>
        </div>
      </Container>
    </Section>
    <Section bg="raised">
      <Container>
        <div class="zaplecze">
          <div class="zaplecze-media">
            <Image
              src={magazyn}
              alt="Centro logístico de Owell visto desde el aire"
              width={1740}
              height={742}
              class="zaplecze-img"
            />
          </div>

          <div class="zaplecze-tekst">
            <p class="zaplecze-eyebrow" data-reveal>Infraestructura</p>
            <h2 class="zaplecze-tytul" data-reveal data-reveal-delay="80">Nuestro propio centro logístico</h2>
            <p class="zaplecze-opis" data-reveal data-reveal-delay="160">
              30.000 m² bajo un mismo techo — desde la recepción de mercancía, pasando por el almacenamiento, hasta el embalaje y el envío. Gracias a nuestro propio centro controlamos todo el proceso: los pedidos realizados antes de las 18:30 se envían el mismo día, y comprobamos el stock en tiempo real — así que nunca prometemos la disponibilidad de un producto que en realidad no tenemos en el almacén.
            </p>
          </div>
        </div>
      </Container>
    </Section>
  </main>

  <Footer />
</Base>

<style set:html={visualKeyframes} is:global></style>

<style>
  .page-title {
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-12);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .visual {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid var(--hairline);
    overflow: hidden;
  }

  .visual-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .visual-img:not(:first-of-type) {
    display: none;
  }

  .visual-overlay {
    padding: var(--sp-8);
    background-color: var(--bg-0);
  }

  .visual-text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .visual-text a {
    color: var(--gold);
    text-underline-offset: 0.2em;
  }

  .visual-text a:hover {
    color: var(--gold-bright);
  }

  @media (min-width: 960px) {
    .visual {
      min-height: 26rem;
    }

    .visual-img,
    .visual-img:not(:first-of-type) {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      animation: o-nas-carousel var(--visual-cykl) ease-in-out infinite;
    }

    .visual-overlay {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 100%;
      padding: var(--sp-16);
      background: linear-gradient(
        to right,
        var(--bg-0) 0%,
        var(--bg-0) 42%,
        transparent 78%
      );
      transition: opacity 900ms var(--ease);
    }

    .visual-text {
      max-width: 30rem;
    }

    .visual:hover .visual-overlay {
      opacity: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .visual-img {
        animation: none !important;
        opacity: 0;
      }

      .visual-img:first-of-type {
        opacity: 1;
      }
    }
  }
  .zaplecze {
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
  }

  .zaplecze-media {
    border-radius: var(--radius-lg);
    border: 1px solid var(--hairline);
    overflow: hidden;
  }

  .zaplecze-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .zaplecze-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--steel);
  }

  .zaplecze-tytul {
    margin-top: var(--sp-3);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .zaplecze-opis {
    margin-top: var(--sp-4);
    max-width: var(--maxw-prose);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--text-2);
  }
</style>
