---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import Wartosci from "../components/sections/Wartosci.astro";
import Kategorie from "../components/sections/Kategorie.astro";
import Dlaczego from "../components/sections/Dlaczego.astro";
import Liczby from "../components/sections/Liczby.astro";
import MapaZasiegu from "../components/sections/MapaZasiegu.astro";
import Gwarancja from "../components/sections/Gwarancja.astro";
import Opinie from "../components/sections/Opinie.astro";
import GdzieKupic from "../components/sections/GdzieKupic.astro";
import Kontakt from "../components/sections/Kontakt.astro";
---

<Base
  title="Owell — małe AGD projektowane w Europie"
  description="Owell projektuje małe AGD z myślą o wieloletnim, codziennym użytkowaniu. Sprawdź ofertę i zobacz, gdzie kupić."
>
  <Header />

  <main id="content">
    <Hero />
    <Wartosci />
    <Kategorie />
    <Dlaczego />
    <Liczby />
    <MapaZasiegu />
    <Gwarancja />
    <Opinie />
    <GdzieKupic />
    <Kontakt />
  </main>

  <Footer />
</Base>
